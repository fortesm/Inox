Module Std.IOUtils
Use Std.Files

== File-system conveniences built on Std.Files (canon r3.64 module pairs).
== Compiler intrinsics, visible in a program that uses Std.IOUtils, which
== also gives everything of Std.Files:
==
==   Exists(Path String) Bool            == a regular file exists at Path
==   DeleteFile(Path String)             == delete a file (never a directory)
==   RenameFile(From String, To String)  == AlreadyExists when To exists
==
==   try
==       F := OpenRead("dados.txt")
==       while not Eof(F)
==           PutLn(ReadLn(F))
==       ;
==   except
==       On FileNotFound
==           PutLn("dados.txt não existe")
==       ;
==   ensure
==       PutLn("fim")
==   ;
