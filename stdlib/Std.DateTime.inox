== Std.DateTime: dates and times (change datetime-systemutils, canon r3.92,
== decisions D1-D3 of Marcelo Fortes, 2026-10-21). Std.DateUtils adds text
== (ISO 8601, FormatDateTime) and gives everything of this module.
==
== D1. A TDateTime is the number of microseconds since 0001-01-01T00:00:00
== of the proleptic Gregorian calendar, up to 9999-12-31T23:59:59.999999; a
== TDate the number of days since 0001-01-01; a TDuration a number of
== microseconds. They are Ranges of Integer, so they compare with = # < <= >
== >= and are stored checked: a value outside is "value out of range".
==
== D2. Two zones only: UTC and the zone of the system. NowUTC and
== UTCOffset(T) are carried out by libinoxrt; the rest is Inox below.
==
== A date that does not exist (EncodeDate(2026, 2, 30)) breaks a
== precondition: the program stops with "precondition violated".

Type
    TDateTime Range 0..315_537_897_599_999_999 Public
    TDate Range 0..3_652_058 Public
    TDuration Range -9_223_372_036_854_775_807..9_223_372_036_854_775_807 Public
    TDayOfWeek (Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday) Public

Const MicrosPerSecond Public := 1_000_000
Const MicrosPerMinute Public := 60_000_000
Const MicrosPerHour Public := 3_600_000_000
Const MicrosPerDay Public := 86_400_000_000

== Intrinsics (libinoxrt):
==   NowUTC TDateTime                    == the clock, in UTC
==   UTCOffset(T TDateTime) TDuration     == local time minus UTC at the UTC instant T

IsLeapYear(Year Integer) Bool Public :
    Return (Year mod 4 = 0 and Year mod 100 # 0) or Year mod 400 = 0
;

DaysInMonth(Year Integer, Month Integer) Integer Public :
    pre Month >= 1 and Month <= 12, "a month is 1..12"
    Days Integer := 31
    case Month
        4 | 6 | 9 | 11 Days := 30
        2 Days := IIf(IsLeapYear(Year), 29, 28)
        else Days := 31
    ;
    Return Days
;

== Days since 0001-01-01 of a valid date (H. Hinnant's days_from_civil).
DaysFromCivil(Year Integer, Month Integer, Day Integer) Integer :
    Shifted Integer := IIf(Month <= 2, Year - 1, Year)
    Era Integer := Shifted / 400
    YearOfEra Integer := Shifted - Era * 400
    DayOfYear Integer := (153 * IIf(Month > 2, Month - 3, Month + 9) + 2) / 5 + Day - 1
    DayOfEra Integer := YearOfEra * 365 + YearOfEra / 4 - YearOfEra / 100 + DayOfYear
    Return Era * 146097 + DayOfEra - 306
;

EncodeDate(Year Integer, Month Integer, Day Integer) TDate Public :
    pre Year >= 1 and Year <= 9999, "a year is 1..9999"
    pre Month >= 1 and Month <= 12, "a month is 1..12"
    pre Day >= 1 and Day <= DaysInMonth(Year, Month), "the day exists in its month"
    Return TDate(DaysFromCivil(Year, Month, Day))
;

EncodeDateTime(Year Integer, Month Integer, Day Integer, Hour Integer, Minute Integer, Second Integer) TDateTime Public :
    pre Hour >= 0 and Hour <= 23, "an hour is 0..23"
    pre Minute >= 0 and Minute <= 59, "a minute is 0..59"
    pre Second >= 0 and Second <= 59, "a second is 0..59"
    Days Integer := Integer(EncodeDate(Year, Month, Day))
    Return TDateTime(Days * MicrosPerDay + Hour * MicrosPerHour + Minute * MicrosPerMinute + Second * MicrosPerSecond)
;

DateOf(T TDateTime) TDate Public :
    Return TDate(T / MicrosPerDay)
;

DateTimeOf(Date TDate) TDateTime Public :
    Return TDateTime(Date * MicrosPerDay)
;

== The year, month and day of T (H. Hinnant's civil_from_days).
DecodeDate(T TDateTime, ref mut Year Integer, ref mut Month Integer, ref mut Day Integer) Public :
    Z Integer := T / MicrosPerDay + 306
    Era Integer := Z / 146097
    DayOfEra Integer := Z - Era * 146097
    YearOfEra Integer := (DayOfEra - DayOfEra / 1460 + DayOfEra / 36524 - DayOfEra / 146096) / 365
    DayOfYear Integer := DayOfEra - (365 * YearOfEra + YearOfEra / 4 - YearOfEra / 100)
    MonthPart Integer := (5 * DayOfYear + 2) / 153
    Day := DayOfYear - (153 * MonthPart + 2) / 5 + 1
    Month := IIf(MonthPart < 10, MonthPart + 3, MonthPart - 9)
    Year := YearOfEra + Era * 400 + IIf(Month <= 2, 1, 0)
;

YearOf(T TDateTime) Integer Public :
    Year Integer := 0
    Month Integer := 0
    Day Integer := 0
    DecodeDate(T, Year, Month, Day)
    Return Year
;

MonthOf(T TDateTime) Integer Public :
    Year Integer := 0
    Month Integer := 0
    Day Integer := 0
    DecodeDate(T, Year, Month, Day)
    Return Month
;

DayOf(T TDateTime) Integer Public :
    Year Integer := 0
    Month Integer := 0
    Day Integer := 0
    DecodeDate(T, Year, Month, Day)
    Return Day
;

HourOf(T TDateTime) Integer Public :
    Return T mod MicrosPerDay / MicrosPerHour
;

MinuteOf(T TDateTime) Integer Public :
    Return T mod MicrosPerHour / MicrosPerMinute
;

SecondOf(T TDateTime) Integer Public :
    Return T mod MicrosPerMinute / MicrosPerSecond
;

MicroSecondOf(T TDateTime) Integer Public :
    Return T mod MicrosPerSecond
;

== 0001-01-01 was a Monday.
DayOfWeek(T TDateTime) TDayOfWeek Public :
    Return TDayOfWeek(T / MicrosPerDay mod 7)
;

AddDays(T TDateTime, Days Integer) TDateTime Public :
    Return TDateTime(T + Days * MicrosPerDay)
;

AddSeconds(T TDateTime, Count Integer) TDateTime Public :
    Return TDateTime(T + Count * MicrosPerSecond)
;

== Whole days between A and B, whatever their order.
DaysBetween(A TDateTime, B TDateTime) Integer Public :
    Return IIf(A > B, A - B, B - A) / MicrosPerDay
;

ToLocal(T TDateTime) TDateTime Public :
    Return TDateTime(T + UTCOffset(T))
;

== The UTC instant of a local time (the offset of the instant it names).
ToUTC(T TDateTime) TDateTime Public :
    Guess Integer := T - UTCOffset(T)
    Return TDateTime(T - UTCOffset(TDateTime(Guess)))
;

Now TDateTime Public :
    Return ToLocal(NowUTC)
;
