== Std.DateTime: dates and times (change datetime-systemutils, canon r3.92,
== decisions D1-D3 of Marcelo Fortes, 2026-10-21). Std.DateUtils adds text
== (ISO 8601, FormatDateTime) and gives everything of this module.
==
== D1. A TDateTime is the number of microseconds since 0001-01-01T00:00:00
== of the proleptic Gregorian calendar, up to 9999-12-31T23:59:59.999999; a
== TDate the number of days since 0001-01-01; a TDuration a number of
== microseconds. They are Ranges of Integer, so they compare with = # < <= >
== >= and are stored checked: a value outside is "value out of range".
==
== D2. Two zones only: UTC and the zone of the system. NowUTC and
== UTCOffset(T) are carried out by libinoxrt; the rest is Inox below.
==
== A date that does not exist (EncodeDate(2026, 2, 30)) breaks a
== precondition: the program stops with "precondition violated".

Type
    TDateTime Range 0..315_537_897_599_999_999
    TDate Range 0..3_652_058
    TDuration Range -9_223_372_036_854_775_807..9_223_372_036_854_775_807
    TDayOfWeek (Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday)

Const MicrosPerSecond := 1_000_000
Const MicrosPerMinute := 60_000_000
Const MicrosPerHour := 3_600_000_000
Const MicrosPerDay := 86_400_000_000

== Intrinsics (libinoxrt):
==   NowUTC TDateTime                    == the clock, in UTC
==   UTCOffset(T TDateTime) TDuration     == local time minus UTC at the UTC instant T

IsLeapYear(Y Integer) Bool :
    Return (Y mod 4 = 0 and Y mod 100 # 0) or Y mod 400 = 0
;

DaysInMonth(Y Integer, M Integer) Integer :
    pre M >= 1 and M <= 12, "a month is 1..12"
    Days Integer := 31
    case M
        4 | 6 | 9 | 11 Days := 30
        2 Days := IIf(IsLeapYear(Y), 29, 28)
        else Days := 31
    ;
    Return Days
;

== Days since 0001-01-01 of a valid date (H. Hinnant's days_from_civil).
DaysFromCivil(Y Integer, M Integer, D Integer) Integer :
    Shifted Integer := IIf(M <= 2, Y - 1, Y)
    Era Integer := Shifted / 400
    YearOfEra Integer := Shifted - Era * 400
    DayOfYear Integer := (153 * IIf(M > 2, M - 3, M + 9) + 2) / 5 + D - 1
    DayOfEra Integer := YearOfEra * 365 + YearOfEra / 4 - YearOfEra / 100 + DayOfYear
    Return Era * 146097 + DayOfEra - 306
;

EncodeDate(Y Integer, M Integer, D Integer) TDate :
    pre Y >= 1 and Y <= 9999, "a year is 1..9999"
    pre M >= 1 and M <= 12, "a month is 1..12"
    pre D >= 1 and D <= DaysInMonth(Y, M), "the day exists in its month"
    Return TDate(DaysFromCivil(Y, M, D))
;

EncodeDateTime(Y Integer, M Integer, D Integer, H Integer, N Integer, S Integer) TDateTime :
    pre H >= 0 and H <= 23, "an hour is 0..23"
    pre N >= 0 and N <= 59, "a minute is 0..59"
    pre S >= 0 and S <= 59, "a second is 0..59"
    Days Integer := Integer(EncodeDate(Y, M, D))
    Return TDateTime(Days * MicrosPerDay + H * MicrosPerHour + N * MicrosPerMinute + S * MicrosPerSecond)
;

DateOf(T TDateTime) TDate :
    Return TDate(T / MicrosPerDay)
;

DateTimeOf(D TDate) TDateTime :
    Return TDateTime(D * MicrosPerDay)
;

== The year, month and day of T (H. Hinnant's civil_from_days).
DecodeDate(T TDateTime, ref mut Y Integer, ref mut M Integer, ref mut D Integer) :
    Z Integer := T / MicrosPerDay + 306
    Era Integer := Z / 146097
    DayOfEra Integer := Z - Era * 146097
    YearOfEra Integer := (DayOfEra - DayOfEra / 1460 + DayOfEra / 36524 - DayOfEra / 146096) / 365
    DayOfYear Integer := DayOfEra - (365 * YearOfEra + YearOfEra / 4 - YearOfEra / 100)
    MonthPart Integer := (5 * DayOfYear + 2) / 153
    D := DayOfYear - (153 * MonthPart + 2) / 5 + 1
    M := IIf(MonthPart < 10, MonthPart + 3, MonthPart - 9)
    Y := YearOfEra + Era * 400 + IIf(M <= 2, 1, 0)
;

Year(T TDateTime) Integer :
    Y Integer := 0
    M Integer := 0
    D Integer := 0
    DecodeDate(T, Y, M, D)
    Return Y
;

Month(T TDateTime) Integer :
    Y Integer := 0
    M Integer := 0
    D Integer := 0
    DecodeDate(T, Y, M, D)
    Return M
;

Day(T TDateTime) Integer :
    Y Integer := 0
    M Integer := 0
    D Integer := 0
    DecodeDate(T, Y, M, D)
    Return D
;

Hour(T TDateTime) Integer :
    Return T mod MicrosPerDay / MicrosPerHour
;

Minute(T TDateTime) Integer :
    Return T mod MicrosPerHour / MicrosPerMinute
;

Second(T TDateTime) Integer :
    Return T mod MicrosPerMinute / MicrosPerSecond
;

MicroSecond(T TDateTime) Integer :
    Return T mod MicrosPerSecond
;

== 0001-01-01 was a Monday.
DayOfWeek(T TDateTime) TDayOfWeek :
    Return TDayOfWeek(T / MicrosPerDay mod 7)
;

AddDays(T TDateTime, Days Integer) TDateTime :
    Return TDateTime(T + Days * MicrosPerDay)
;

AddSeconds(T TDateTime, Count Integer) TDateTime :
    Return TDateTime(T + Count * MicrosPerSecond)
;

== Whole days between A and B, whatever their order.
DaysBetween(A TDateTime, B TDateTime) Integer :
    Return IIf(A > B, A - B, B - A) / MicrosPerDay
;

ToLocal(T TDateTime) TDateTime :
    Return TDateTime(T + UTCOffset(T))
;

== The UTC instant of a local time (the offset of the instant it names).
ToUTC(T TDateTime) TDateTime :
    Guess Integer := T - UTCOffset(T)
    Return TDateTime(T - UTCOffset(TDateTime(Guess)))
;

Now TDateTime :
    Return ToLocal(NowUTC)
;
