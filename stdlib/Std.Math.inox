== Inox 0.1 mathematical surface.
==
== This module is intentionally clean-room. It does not copy or translate any
== third-party runtime library. Some elementary Float functions are compiler
== prelude intrinsics lowered to LLVM/libm by the current backend:
==
==   Abs(Float), Sqrt, Cbrt, Sin, Cos, Tan, ArcSin, ArcCos, ArcTan,
==   ArcTan2, Sinh, Cosh, Tanh, Exp, Ln, LnXP1, Log2, Log10, LogN,
==   Power, Floor, Ceil, FMod, Hypot, Hypot3,
==   RadToDeg, DegToRad, RadToGrad, GradToRad, RadToCycle, CycleToRad.
==
== Round(X) and Trunc(X) (change decimals, r3.91) are intrinsics too, visible
== with `Use Std.Math`: of a Float, a Float32, a Currency or a Crypto they give
== an Integer, Round to the nearest with a half to the even one, Trunc toward
== zero; a value beyond Integer stops the program.
==
== Integer helpers below are implemented in Inox source and are part of the
== first non-toy Std.Math layer.

Min(A Integer, B Integer) Integer Public :
    Result Integer := B

    if A < B
        Result := A
    ;

    Return Result
;

Max(A Integer, B Integer) Integer Public :
    Result Integer := B

    if A > B
        Result := A
    ;

    Return Result
;

Clamp(X Integer, MinValue Integer, MaxValue Integer) Integer Public :
    Result Integer := X

    if Result < MinValue
        Result := MinValue
    ;

    if Result > MaxValue
        Result := MaxValue
    ;

    Return Result
;

EnsureRange(X Integer, MinValue Integer, MaxValue Integer) Integer Public :
    Return Clamp(X, MinValue, MaxValue)
;

InRange(X Integer, MinValue Integer, MaxValue Integer) Bool Public :
    Return (X >= MinValue) and (X <= MaxValue)
;

Sign(X Integer) Integer Public :
    if X < 0
        Return -1
    elif X > 0
        Return 1
    else
        Return 0
    ;
;

IsEven(X Integer) Bool Public :
    Return (X mod 2) = 0
;

IsOdd(X Integer) Bool Public :
    Return (X mod 2) # 0
;

Sqr(X Integer) Integer Public :
    Return X * X
;

Cube(X Integer) Integer Public :
    Return X * X * X
;

Gcd(A Integer, B Integer) Integer Public :
    X Integer := Abs(A)
    Y Integer := Abs(B)
    T Integer := 0

    while Y # 0
        T := X mod Y
        X := Y
        Y := T
    ;

    Return X
;

Lcm(A Integer, B Integer) Integer Public :
    Result Integer := 0

    if (A # 0) and (B # 0)
        Result := (Abs(A) / Gcd(A, B)) * Abs(B)
    ;

    Return Result
;

== Float convenience functions implemented in Inox source over backend math
== intrinsics. They deliberately use Float/Float64, not Currency/Crypto.
==
== STATUS NOTES (see docs/STATUS.md, conformance gaps):
==  - Lcm/Sqr/Cube inherit checked integer arithmetic. Overflow deterministically
==    traps under DECISION P-A; v3.19 verification confirmed all three paths.
==  - Pi, Tau and E are universal real Consts (r3.86, as Ada.Numerics and Go's
==    math): a Float where a Float is expected and a Float32 where a Float32 is,
==    each rounded once from these digits, more than either type holds. Until
==    r3.84 they were zero-argument functions; every use reads the same.

Const Pi Public := 3.141592653589793238462643383279502884
Const Tau Public := 6.283185307179586476925286766559005768
Const E Public := 2.718281828459045235360287471352662498

Cotan(X Float) Float Public :
    Return 1.0 / Tan(X)
;

Cot(X Float) Float Public :
    Return Cotan(X)
;

Secant(X Float) Float Public :
    Return 1.0 / Cos(X)
;

Sec(X Float) Float Public :
    Return Secant(X)
;

Cosecant(X Float) Float Public :
    Return 1.0 / Sin(X)
;

Csc(X Float) Float Public :
    Return Cosecant(X)
;

Coth(X Float) Float Public :
    Return 1.0 / Tanh(X)
;

Sech(X Float) Float Public :
    Return 1.0 / Cosh(X)
;

Csch(X Float) Float Public :
    Return 1.0 / Sinh(X)
;

Log(X Float) Float Public :
    Return Ln(X)
;

LogBase(Base Float, X Float) Float Public :
    Return LogN(Base, X)
;
