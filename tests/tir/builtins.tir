parse ok
semantic ok
struct TPair { FLeft Int64, FRight String }
const Limit Int64 = (lit Int64 3)
const Greeting String = (lit String "hi")

entry Main
  declare V Array[1..3] Int64 := (builtin Array[1..3] Int64 Fill (lit Int64 7))
  evaluate (builtin Void PutLn (lit Int64 1) (lit Int64 3) (lit Int64 3))
  declare S Slice<Int64> := (slice Slice<Int64> no-high (read Array[1..3] Int64 (local V)) (lit Int64 2))
  evaluate (builtin Void PutLn (builtin Int64 Length (read Slice<Int64> (local S))) (builtin Int64 Low (read Slice<Int64> (local S))))
  declare T Slice<Int64> := (slice Slice<Int64> no-low no-high (read Array[1..3] Int64 (local V)))
  evaluate (builtin Void PutLn (builtin Int64 High (read Slice<Int64> (local T))))
  declare Suit TSuit := (builtin TSuit Succ (lit TSuit 0))
  evaluate (builtin Void PutLn (builtin Int64 Ord (read TSuit (local Suit))) (lit TSuit 0))
  declare Hand Set<TSuit> := (set Set<TSuit> (lit TSuit 0) (binary TSuit range (lit TSuit 2) (lit TSuit 3)))
  evaluate (builtin Void PutLn (binary Bool in (lit TSuit 1) (builtin Set<TSuit> Union (read Set<TSuit> (local Hand)) (set Set<TSuit> (lit TSuit 1)))))
  declare P TPercent := (lit Int64 40)
  declare F Float64 := (binary Float64 div (convert Float64 (read TPercent (local P))) (lit Float64 3.0))
  evaluate (builtin Void PutLn (binary Bool gt (builtin Float64 Sqrt (read Float64 (local F))) (lit Float64 1.0)) (builtin Int64 Abs (unary Int64 neg (lit Int64 2))))
  declare Pair TPair := (construct TPair FLeft=default FRight=(lit String "hi"))
  evaluate (builtin Void PutLn (read Int64 (field (local Pair) FLeft)) (string Int64 Length (read String (field (local Pair) FRight))) (string String UpperCase (lit String "x")))
  declare Ch Char := (convert Char (lit Int64 65))
  evaluate (builtin Void PutLn (convert String (read Char (local Ch))) (builtin Bool EndOfInput))
