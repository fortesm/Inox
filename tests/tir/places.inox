== F6 (typed-ir): every kind of place of the typed IR (--dump-tir).
Type
    TPoint Struct
        FX Integer := 0
        FY Integer := 0
    ;
    TNode Struct
        FValue Integer := 0
        FNext Option<Own<TNode>>
    ;

State
    Count Integer := 0
;

TPoint.Move(Self mut, DX Integer) :
    Self.FX += DX
;

TPoint.Sum(Self) Integer :
    Return Self.FX + Self.FY
;

Swap(ref mut A Integer, ref mut B Integer) :
    T := A
    A := B
    B := T
;

Total(ref V Array[1..3] Integer) Integer :
    S := 0
    for I in 1..3
        S += V[I]
    ;
    Return S
;

Origin TPoint :
    Return TPoint(FX := 0, FY := 0)
;

Main :
    P := TPoint(FX := 1)
    P.Move(2)
    PutLn(P.Sum)
    A := 1
    B := 2
    Swap(A, B)
    V Array[1..3] Integer := Fill(0)
    V[2] := A
    PutLn(Total(V))
    Count := Count + 1
    PutLn(Origin.FY)
    N := New(TNode(FValue := 5))
    N.FValue := 6
    X Integer := 10
    L := Link(X)
    Value(L) := 11
    with P
        .FY := .FX
    ;
    try
        PutLn(V[A + 3])
    except
        On E RangeError
            PutLn("range")
        ;
    ;
    PutLn(X, " ", N.FValue)
;
