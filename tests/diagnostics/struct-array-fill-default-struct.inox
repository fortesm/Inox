== r3.82: a field default is a literal, so an array of structs has none and
== is given in the construction.
Type
    TPoint Struct
        FX Integer := 0
    ;
    TShape Struct
        FPoints Array[1..2] TPoint := Fill(Origin)
    ;

Main :
    S := TShape(FPoints := Fill(TPoint(FX := 1)))
    PutLn(S.FPoints[1].FX)
;
