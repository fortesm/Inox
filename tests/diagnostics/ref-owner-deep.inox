== change read-only-through-owners: two owner levels below a ref parameter.
Type
    TNode Struct
        FValue Integer := 0
    ;
    THolder Struct
        FChild Own<TNode>
    ;
    TOuter Struct
        FHolder Own<THolder>
    ;

Poke(ref O TOuter) :
    O.FHolder.FChild.FValue := 1
;

Main :
    O TOuter := TOuter(FHolder := New(THolder(FChild := New(TNode))))
    Poke(O)
    PutLn(O.FHolder.FChild.FValue)
;
