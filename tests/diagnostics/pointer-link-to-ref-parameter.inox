== Safe pointers (CANON-25, CANON-10): what a ref parameter owns is read-only
== and no Link is made from it.
Type
    TNode Struct
        FValue Integer := 0
    ;

Peek(ref P Own<TNode>) Integer :
    L := Link(P)
    Return Value(L).FValue
;

Main :
    P := New(TNode(FValue := 1))
    PutLn(Peek(P))
;
