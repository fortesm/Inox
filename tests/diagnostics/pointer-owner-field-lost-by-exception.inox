== Safe pointers (CANON-25, r3.136): a routine gives back an owner it received
== as ref mut before an exception leaves it, so an owner field passed as
== ref mut is never left empty; this callee frees it and then raises.
Type
    TNode Struct
        FValue Integer := 0
    ;

    TBox Struct
        FNode Own<TNode>
    ;

Renew(ref mut P Own<TNode>) :
    Free(P)
    if True
        Raise RangeError
    ;
    P := New(TNode)
;

Main :
    B := TBox(FNode := New(TNode(FValue := 3)))
    try
        Renew(B.FNode)
    except
        On RangeError
            PutLn("caught")
        ;
    ;
    PutLn(B.FNode.FValue)
;
