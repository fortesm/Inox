== r3.93: an array element is a value, not a call.
Type
    TPoint Struct
        FX Integer := 0
    ;

Twice(N Integer) Integer :
    Return 2 * N
;

Show(Text String) :
    PutLn(Text)
;

TPoint.Clear(Self mut) :
    Self.FX := 0
;

Main :
    A Array[1..2] Integer := Fill(Twice(1))
    _ := A[1]
;
