== ADR-0016: a ref mut argument is a writable place, not a value.
Swap(ref mut A Integer, ref mut B Integer) :
    T Integer := A
    A := B
    B := T
;

Main :
    X Integer := 1
    Swap(X, 3)
    PutLn(X)
;
