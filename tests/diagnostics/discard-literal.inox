== r3.93: only the result of a call is discarded; `_ := 123` would discard nothing.
Type
    TPoint Struct
        FX Integer := 0
    ;

Twice(N Integer) Integer :
    Return 2 * N
;

Show(Text String) :
    PutLn(Text)
;

TPoint.Clear(Self mut) :
    Self.FX := 0
;

Main :
    _ := 123
;
