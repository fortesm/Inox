== CANON-9: a struct cannot contain itself through another struct.
Module Diagnostics.StructRecursiveIndirect

Type
    TNode Struct
        FValue Integer
        FLink TLink
    ;
    TLink Struct
        FBack TNode
    ;

Main :
    P TNode
    PutLn(P.FValue)
;
