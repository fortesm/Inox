== Safe pointers (CANON-25): `ensure` runs before Return leaves; what it frees
== is not given back.
Type
    TNode Struct
        FValue Integer := 0
    ;

Value(ref mut P Own<TNode>) Integer :
    try
        Return P.FValue
    ensure
        Free(P)
    ;
;

Main :
    P := New(TNode(FValue := 2))
    PutLn(Value(P))
;
