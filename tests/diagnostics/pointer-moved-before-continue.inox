== Safe pointers: a `continue` takes the owners given away before it to the
== next round, which uses them.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    for I in 1..3
        PutLn(P.FValue)
        Q := Move(P)
        if I = 2
            continue
        ;
        P := Move(Q)
    ;
;
