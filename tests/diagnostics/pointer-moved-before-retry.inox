== Safe pointers: Retry runs the try body again, which uses an owner the
== handler freed.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    try
        PutLn(P.FValue)
        Raise RangeError
    except
        On RangeError
            Free(P)
            Retry(2)
        ;
    ;
;
