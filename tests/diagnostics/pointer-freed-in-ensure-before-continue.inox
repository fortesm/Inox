== Safe pointers: `ensure` runs before a `continue` leaves the try: the next
== round starts with what it frees.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    for I in 1..3
        PutLn(P.FValue)
        try
            continue
        ensure
            Free(P)
        ;
        P := New(TNode)
    ;
;
