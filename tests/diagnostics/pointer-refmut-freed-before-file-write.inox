== Safe pointers (CANON-25, r3.136): a routine gives back an owner it received
== as ref mut before an exception leaves it; Create, WriteLn and Close of a file
== may raise IOError
== between Free and the assignment.
Use Std.Files

Type
    TNode Struct
        FValue Integer := 0
    ;

Renew(ref mut P Own<TNode>, Path String) :
    Free(P)
    F := Create(Path)
    WriteLn(F, "x")
    Close(F)
    P := New(TNode)
;

Main :
    P := New(TNode(FValue := 1))
    Renew(P, "out.txt")
;
