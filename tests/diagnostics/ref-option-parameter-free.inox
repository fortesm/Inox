== change read-only-through-owners: Free of a ref Option<Own> parameter changes the caller's variable.
Type
    TNode Struct
        FValue Integer := 0
    ;
Drop(ref P Option<Own<TNode>>) :
    Free(P)
;

Main :
    P Option<Own<TNode>> := New(TNode)
    Drop(P)
    PutLn("dropped")
;
