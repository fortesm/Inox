== Safe pointers: a `leave` in one arm of an if carries that arm's owners
== out of the loop.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    for I in 1..3
        if I = 1
            PutLn("one")
        elif I = 2
            Free(P)
            leave
        else
            PutLn("three")
        ;
    ;
    PutLn(P.FValue)
;
