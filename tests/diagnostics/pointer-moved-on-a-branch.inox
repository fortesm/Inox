== Safe pointers: an owner given away on one branch is given away after the if.
Type
    TNo Struct
        FValor Integer := 0
        FProximo Option<Own<TNo>>
    ;

Main :
    P := New(TNo)
    if P.FValor = 0
        Free(P)
    ;
    PutLn(P.FValor)
;
