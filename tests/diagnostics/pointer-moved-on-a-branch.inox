== Safe pointers: an owner given away on one branch is given away after the if.
Type
    TNode Struct
        FValue Integer := 0
        FNext Option<Own<TNode>>
    ;

Main :
    P := New(TNode)
    if P.FValue = 0
        Free(P)
    ;
    PutLn(P.FValue)
;
