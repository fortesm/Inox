== Change case-strings: the same String twice is an overlap, also through a
== Const.
Const Stop := "stop"

Main :
    Word := "a"
    case Word
        "stop"
            PutLn(1)
        Stop
            PutLn(2)
        else
            PutLn(3)
    ;
;
