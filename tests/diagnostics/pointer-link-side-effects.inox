== Safe pointers: the place of a Link is read twice, so its indices have no side effects.
Type
    TNode Struct
        FValue Integer := 0
    ;

Index Integer :
    Return 1
;

Main :
    A Array[1..2] Integer := Fill(0)
    L := Link(A[Index])
    PutLn(Value(L))
;
