== CANON-9: a Self mut method of String changes the caller's variable; a literal is not one.
Module Diagnostics.SelfMutOnLiteral
Type
    TA Struct
        FX Integer := 0
    ;
    TB Struct
        FX Integer := 0
    ;
TA.Show(Self) :
    PutLn(Self.FX)
;
TB.Show(Self) :
    PutLn(Self.FX)
;
TA.Bump(Self mut) :
    Self.FX += 1
;
String.Set(Self mut, V String) :
    Self := V
;
Main :
    PutLn("a")
    "x".Set("y")
;
