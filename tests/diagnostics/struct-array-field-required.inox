== r3.82 (CANON-5): an array field without Fill has no implicit value, so a
== struct declared without one is an error.
Type
    TPacket Struct
        FData Array[1..4] Byte
        FSize Integer := 0
    ;

Main :
    Q TPacket
    PutLn(Q.FSize)
;
