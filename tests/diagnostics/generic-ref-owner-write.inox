== change read-only-through-owners: a generic instance writes through an owner of a ref parameter.
Type
    TNode Struct
        FValue Integer := 0
    ;
    TBox<T> Struct
        FItem Own<T>
    ;

Poke<T>(ref B TBox<T>, X T) :
    Value(B.FItem) := X
;

Main :
    B TBox<TNode> := TBox(FItem := New(TNode))
    Poke(B, TNode(FValue := 1))
    PutLn(B.FItem.FValue)
;
