== Safe pointers and CANON-24: a pos clause reads an owner the routine takes only through old.
Type
    TNo Struct
        FValor Integer := 0
    ;

Usar(P Own<TNo>) Integer :
    pos Result = P.FValor
    Return P.FValor
;

Main :
    PutLn(Usar(New(TNo)))
;
