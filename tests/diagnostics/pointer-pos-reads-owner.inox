== Safe pointers and CANON-24: a pos clause reads an owner the routine takes only through old.
Type
    TNode Struct
        FValue Integer := 0
    ;

Apply(P Own<TNode>) Integer :
    pos Result = P.FValue
    Return P.FValue
;

Main :
    PutLn(Apply(New(TNode)))
;
