== CANON-8: arithmetic on Natural is done in the Integer family, so the
== result is Integer; storing it back into a Natural needs Natural(X).
Module Diagnostics.NaturalArithmeticIsInteger

Main :
    N Natural := 4
    N := N - 1
    PutLn(N)
;
