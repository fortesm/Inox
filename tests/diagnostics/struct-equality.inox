== v3.56: structs are not compared (compare their fields); '=' was accepted and
== then produced invalid IR.
Module Diagnostics.StructEquality

Type
    TPoint Struct
        FX Integer
        FY Integer
    ;

Main :
    P TPoint := TPoint(FX := 1, FY := 2)
    Q TPoint := TPoint(FX := 1, FY := 2)
    PutLn(P = Q)
;
