== CANON-9, r3.82: an array field defaults to Fill(Literal), never to a bare
== literal.
Type
    TBuffer Struct
        FData Array[1..2] Integer := 1
    ;

Main :
    B TBuffer
    PutLn(B.FData[1])
;
