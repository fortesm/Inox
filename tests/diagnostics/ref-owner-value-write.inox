== change read-only-through-owners: Value(P) := of an owner passed by ref.
Type
    TNode Struct
        FValue Integer := 0
    ;
Poke(ref P Own<TNode>) :
    Value(P) := TNode(FValue := 1)
;

Main :
    P Own<TNode> := New(TNode)
    Poke(P)
    PutLn(P.FValue)
;
