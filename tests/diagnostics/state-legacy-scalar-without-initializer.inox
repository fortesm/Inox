== CANON-5: the tolerated legacy form `Name : Type` in State does not bypass
== the initializer rule for scalars.
Module Diagnostics.StateLegacyScalarWithoutInitializer

State :
    Counter : Integer
;

Main :
    PutLn(1)
;
