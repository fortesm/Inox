== Safe pointers (CANON-25, r3.136): a routine gives back an owner it received
== as ref mut before an exception leaves it; a write to a struct with an invariant
== runs the invariant, which may call a routine that raises.
Type
    TNode Struct
        FValue Integer := 0
    ;

    TBox Struct
        FValue Integer := 1
        invariant Self.FValue > 0, "positive"
    ;

Renew(ref mut P Own<TNode>, ref mut B TBox) :
    Free(P)
    B.FValue := 2
    P := New(TNode)
;

Main :
    P := New(TNode(FValue := 1))
    B := TBox(FValue := 1)
    Renew(P, B)
    PutLn(B.FValue)
;
