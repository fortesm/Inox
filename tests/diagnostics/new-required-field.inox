== r3.82: New(TName) builds the type defaults, so they must be complete.
Type
    TPacket Struct
        FData Array[1..4] Byte
        FSize Integer := 0
    ;

Main :
    N := New(TPacket)
    PutLn(Value(N).FSize)
;
