== Safe pointers (CANON-25): Exit is a normal exit of a subroutine; the ref
== mut owner it frees first is not given back.
Type
    TNode Struct
        FValue Integer := 0
    ;

Stop(ref mut P Own<TNode>) :
    if P.FValue > 0
        Free(P)
        Exit
    ;
    PutLn(P.FValue)
;

Main :
    P := New(TNode(FValue := 2))
    Stop(P)
;
