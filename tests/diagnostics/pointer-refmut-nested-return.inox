== Safe pointers (CANON-25): a Return from a loop inside two trys crosses the
== inner ensure, which frees the owner, and the outer one, which does not
== assign it again.
Type
    TNode Struct
        FValue Integer := 0
    ;

First(ref mut P Own<TNode>) Integer :
    for I in 1..3
        try
            try
                if I = 2
                    Return I
                ;
            ensure
                Free(P)
            ;
            P := New(TNode)
        ensure
            PutLn("outer ", I)
        ;
    ;
    Return 0
;

Main :
    P := New(TNode(FValue := 1))
    PutLn(First(P))
;
