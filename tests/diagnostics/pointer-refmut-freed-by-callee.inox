== Safe pointers (CANON-25): a routine gives back an owner it received as
== ref mut before it returns; this one frees it and returns.
Type
    TNode Struct
        FValue Integer := 0
    ;

Release(ref mut P Own<TNode>) :
    Free(P)
;

Main :
    P := New(TNode(FValue := 5))
    Release(P)
    PutLn(P.FValue)
;
