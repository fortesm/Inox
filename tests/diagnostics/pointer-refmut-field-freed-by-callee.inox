== Safe pointers (CANON-25): a callee that frees an owner field passed as ref
== mut would leave the field empty; it is rejected in the callee.
Type
    TNode Struct
        FValue Integer := 0
    ;

    TBox Struct
        FNode Own<TNode>
    ;

Release(ref mut P Own<TNode>) :
    Free(P)
;

Main :
    B := TBox(FNode := New(TNode(FValue := 3)))
    Release(B.FNode)
    PutLn(B.FNode.FValue)
;
