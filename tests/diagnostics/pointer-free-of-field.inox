== Safe pointers: only a variable gives an owner away; a field that may be emptied is an Option.
Module Diagnostics.PointerFreeOfField

Type
    TNo Struct
        FValor Integer := 0
        FProximo Option<Own<TNo>>
    ;

Type
    TCaixa Struct
        FConteudo Own<TNo>
    ;

Main :
    C := TCaixa(FConteudo := New(TNo))
    Free(C.FConteudo)
;
