== Safe pointers: only a variable gives an owner away; a field that may be emptied is an Option.
Type
    TNode Struct
        FValue Integer := 0
        FNext Option<Own<TNode>>
    ;

Type
    TCrate Struct
        FContent Own<TNode>
    ;

Main :
    C := TCrate(FContent := New(TNode))
    Free(C.FContent)
;
