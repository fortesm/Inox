== Parameters are immutable: a field of a value parameter cannot be assigned.
Type
    TA Struct
        FX Integer := 0
    ;
    TB Struct
        FX Integer := 0
    ;
TA.Show(Self) :
    PutLn(Self.FX)
;
TB.Show(Self) :
    PutLn(Self.FX)
;
TA.Bump(Self mut) :
    Self.FX += 1
;
Change(P TA) :
    P.FX := 5
;
Main :
    A TA
    Change(A)
;
