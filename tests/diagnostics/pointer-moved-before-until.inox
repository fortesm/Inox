== Safe pointers: a true `until` takes the owners given away before it out
== of the repeat.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    I Integer := 0
    repeat
        I := I + 1
        Free(P)
        until I = 2
        P := New(TNode)
    ;
    PutLn(P.FValue)
;
