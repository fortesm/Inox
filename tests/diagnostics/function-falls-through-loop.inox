== CANON-12: the Return is inside a loop that may run zero times or exit by
== break, so control can reach the end of the function. Found by fuzzing:
== previously only the LLVM backend noticed ("requires a final Return").
Module Diagnostics.FunctionFallsThroughLoop

FindFirstBelow(A Integer) Integer :
    I := A
    while I > 0
        I := I - 1
        if I = 1
            break
        ;
        Return I
    ;
;

Main :
    PutLn(FindFirstBelow(5))
;
