== Safe pointers: an owner given away with Move cannot be used until it is assigned again.
Type
    TNode Struct
        FValue Integer := 0
        FNext Option<Own<TNode>>
    ;

Main :
    P := New(TNode)
    Q := Move(P)
    PutLn(P.FValue, Q.FValue)
;
