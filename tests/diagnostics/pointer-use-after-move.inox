== Safe pointers: an owner given away with Move cannot be used until it is assigned again.
Module Diagnostics.PointerUseAfterMove

Type
    TNo Struct
        FValor Integer := 0
        FProximo Option<Own<TNo>>
    ;

Main :
    P := New(TNo)
    Q := Move(P)
    PutLn(P.FValor, Q.FValor)
;
