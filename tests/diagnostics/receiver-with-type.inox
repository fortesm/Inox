== CANON-9: the receiver takes its type from the prefix; `Self TPoint` is
== not Inox (r3.116).
Type
    TPoint Struct
        FX Integer := 0
    ;

TPoint.Show(Self TPoint) :
    PutLn(Self.FX)
;

Main :
    P TPoint
    P.Show
;
