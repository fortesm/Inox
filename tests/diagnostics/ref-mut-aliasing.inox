== ADR-0016: a variable passed as ref mut appears in no other argument, so the
== routine never sees one variable through two names.
Swap(ref mut A Integer, ref mut B Integer) :
    T Integer := A
    A := B
    B := T
;

Main :
    X Integer := 1
    Swap(X, X)
    PutLn(X)
;
