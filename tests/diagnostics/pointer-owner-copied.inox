== Safe pointers: an owner is never copied; it is given away with Move.
Module Diagnostics.PointerOwnerCopied

Type
    TNo Struct
        FValor Integer := 0
        FProximo Option<Own<TNo>>
    ;

Main :
    P := New(TNo)
    Q := P
    PutLn(Q.FValor)
;
