== CANON-8 (r3.77): an operation T lacks is an error of the instance that needs it, named with the routine that used it.
Type
    TPoint Struct
        FX Integer := 0
    ;

Max<T>(A T, B T) T :
    Return IIf(A > B, A, B)
;

Main :
    P TPoint
    Q := Max(P, P)
    PutLn(Q.FX)
;
