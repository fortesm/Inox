== r3.82 (CANON-9): an enum field without a default is given in the
== construction.
Type
    TStatus (Pending, Approved, Rejected)
    TFrame Struct
        FState TStatus
        FSize Integer := 0
    ;

Main :
    F := TFrame(FSize := 1)
    PutLn(F.FSize)
;
