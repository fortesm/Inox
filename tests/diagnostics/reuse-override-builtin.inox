== CANON-9 (method-reuse): a built-in type reuses nothing, so its methods are never Override.
Module Diagnostics.ReuseOverrideBuiltin
Type
    TA Struct
        FX Integer := 0
    ;
    TB Struct
        FX Integer := 0
    ;
TA.Show(Self) :
    PutLn(Self.FX)
;
TB.Show(Self) :
    PutLn(Self.FX)
;
TA.Bump(Self mut) :
    Self.FX += 1
;
Integer.Twice(Self) Integer Override :
    Return Self * 2
;
Main :
    PutLn(3.Twice)
;
