== Safe pointers (CANON-25, r3.136): a routine gives back an owner it received
== as ref mut before an exception leaves it; this one calls a method, which may raise,
== between Free and the assignment.
Type
    TNode Struct
        FValue Integer := 0
    ;

    TLog Struct
        FCount Integer := 0
    ;

TLog.Note(Self mut) :
    Self.FCount := Self.FCount + 1
;

Renew(ref mut P Own<TNode>, ref mut L TLog) :
    Free(P)
    L.Note
    P := New(TNode)
;

Main :
    P := New(TNode(FValue := 1))
    L := TLog(FCount := 0)
    Renew(P, L)
    PutLn(L.FCount)
;
