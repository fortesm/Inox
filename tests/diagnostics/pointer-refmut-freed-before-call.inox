== Safe pointers (CANON-25, r3.136): a routine gives back an owner it received
== as ref mut before an exception leaves it; this one calls a routine, which may raise,
== between Free and the assignment.
Type
    TNode Struct
        FValue Integer := 0
    ;

Log(X Integer) :
    PutLn(X)
;

Renew(ref mut P Own<TNode>) :
    Before := P.FValue
    Free(P)
    Log(Before)
    P := New(TNode(FValue := Before))
;

Main :
    P := New(TNode(FValue := 1))
    Renew(P)
;
