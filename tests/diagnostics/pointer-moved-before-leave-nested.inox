== Safe pointers: the `leave` of an inner loop takes its owners to the
== statement after that loop, inside the outer one.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    for I in 1..2
        for J in 1..2
            Free(P)
            leave
        ;
        PutLn(P.FValue)
        P := New(TNode)
    ;
;
