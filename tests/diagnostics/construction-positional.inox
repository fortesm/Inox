== CANON-9: positional construction binds to field order and is not canonical.
Module Diagnostics.ConstructionPositional

Type
    TPoint Struct
        X Integer
        Y Integer
    ;

Main :
    P := TPoint(1, 2)
    PutLn(P.X)
;