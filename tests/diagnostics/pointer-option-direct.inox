== Safe pointers: an Option is reached through a Link, which is checked.
Module Diagnostics.PointerOptionDirect

Type
    TNo Struct
        FValor Integer := 0
        FProximo Option<Own<TNo>>
    ;

Main :
    P := New(TNo)
    PutLn(P.FProximo.FValor)
;
