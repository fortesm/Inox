== r3.82 (CANON-5): a State struct without a value needs complete defaults.
Type
    TPacket Struct
        FData Array[1..4] Byte
        FSize Integer := 0
    ;

State
    Shared TPacket
;

Main :
    PutLn(Shared.FSize)
;
