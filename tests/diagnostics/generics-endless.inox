== CANON-8 (r3.77): a generic routine that calls itself with a bigger type each time stops with a message.
Type
    TBox<T> Struct
        FItem T
    ;

Grow<T>(N Integer, X T) :
    if N > 0
        Grow(N - 1, TBox(FItem := X))
    ;
;

Main :
    Grow(3, 1)
;
