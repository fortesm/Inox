== CANON-13 (range-types): a value of one Range is not stored into another;
== the conversion is written, TMeters(S).
Type
    TMeters Range 0..1000
    TSeconds Range 0..60

Main :
    S TSeconds := 60
    D TMeters := TMeters(S)
    D := S
    PutLn(D)
;
