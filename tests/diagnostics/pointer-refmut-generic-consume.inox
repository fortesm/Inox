== Safe pointers (CANON-25): an instance of a generic routine with an owner
== for T frees its ref mut argument.
Type
    TNode Struct
        FValue Integer := 0
    ;

Consume<T>(ref mut X T) :
    Free(X)
;

Main :
    P := New(TNode(FValue := 1))
    Consume(P)
;
