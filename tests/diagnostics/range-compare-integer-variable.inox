== CANON-13 (range-types): a Range is compared with values of its Range and
== with constants, never with an Integer variable.
Type
    TMonth Range 1..12

Main :
    M TMonth := 12
    Last := 12
    PutLn(M = 12)
    PutLn(M = Last)
;
