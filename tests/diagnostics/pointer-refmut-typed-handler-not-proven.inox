== Safe pointers (CANON-25, r3.136): a routine gives back an owner it received
== as ref mut before an exception leaves it; the call may raise any exception, and
== the typed handler that gives the owner back may not match it.
Type
    TNode Struct
        FValue Integer := 0
    ;

Work(X Integer) :
    PutLn(X)
;

Renew(ref mut P Own<TNode>) :
    Free(P)
    try
        Work(1)
    except
        On RangeError
            P := New(TNode)
            Exit
        ;
    ;
    P := New(TNode)
;

Main :
    P := New(TNode(FValue := 1))
    Renew(P)
;
