== r3.82: a field of a type parameter instantiated with an enum has no
== implicit value either.
Type
    TStatus (Pending, Approved, Rejected)
    TBox<T> Struct
        FValue T
    ;

Main :
    B TBox<TStatus>
    PutLn(B.FValue)
;
