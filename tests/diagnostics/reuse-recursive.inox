== CANON-9 (method-reuse): a part is a field, so a struct cannot reuse itself, even indirectly.
Type
    TA Struct
        FX Integer := 0
    ;
    TB Struct
        FX Integer := 0
    ;
TA.Show(Self) :
    PutLn(Self.FX)
;
TB.Show(Self) :
    PutLn(Self.FX)
;
TA.Bump(Self mut) :
    Self.FX += 1
;
Type
    TC Struct (TD)
        FY Integer := 0
    ;
    TD Struct (TC)
        FZ Integer := 0
    ;
Main :
    C TC
    PutLn(C.FY)
;
