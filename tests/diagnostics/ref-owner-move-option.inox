== change read-only-through-owners: Move of an Option<Own> owned through a ref parameter.
Type
    TNode Struct
        FValue Integer := 0
    ;
    THolder Struct
        FChild Own<TNode>
    ;
    TBox Struct
        FOptional Option<Own<TNode>>
    ;

Take(ref B TBox) Option<Own<TNode>> :
    Return Move(B.FOptional)
;

Main :
    B TBox
    B.FOptional := New(TNode)
    X := Take(B)
    PutLn(Alive(Link(X)))
;
