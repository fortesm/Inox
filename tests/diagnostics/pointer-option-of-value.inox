== Safe pointers: Option is for an owner that may be absent until generics.
Module Diagnostics.PointerOptionOfValue

Type
    TNo Struct
        FValor Integer := 0
        FProximo Option<Own<TNo>>
    ;

Main :
    O Option<Integer>
;
