== CANON-9: Self only reads its receiver; a method that changes it declares Self mut.
Type
    TA Struct
        FX Integer := 0
    ;
    TB Struct
        FX Integer := 0
    ;
TA.Show(Self) :
    PutLn(Self.FX)
;
TB.Show(Self) :
    PutLn(Self.FX)
;
TA.Bump(Self mut) :
    Self.FX += 1
;
TA.Set(Self, V Integer) :
    Self.FX := V
;
Main :
    A TA
    A.Set(1)
;
