== r3.93: a construction is not a call of a function.
Type
    TPonto Struct
        FX Integer := 0
    ;

Dobro(N Integer) Integer :
    Return 2 * N
;

Mostrar(Texto String) :
    PutLn(Texto)
;

TPonto.Limpar(Self mut) :
    Self.FX := 0
;

Main :
    _ := TPonto(FX := 1)
;
