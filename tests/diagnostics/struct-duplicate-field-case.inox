== Field names are case-insensitive (CANON-2): FX and fx are the same field.
Module Diagnostics.StructDuplicateFieldCase

Type
    TPoint Struct
        FX Integer
        FY Integer
        fx Integer
    ;

Main :
    P TPoint
    PutLn(P.FY)
;
