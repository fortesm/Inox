== CANON-8 (r3.77): T may be an owner, and the instance moves it or fails.
Type
    TNode Struct
        FValue Integer := 0
    ;

Twice<T>(X T) :
    A := X
    B := X
;

Main :
    Twice(New(TNode))
;
