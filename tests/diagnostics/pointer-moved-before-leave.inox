== Safe pointers: an owner given away before a `leave` is given away after
== the loop.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    I Integer := 0
    while I < 3
        I := I + 1
        if I = 2
            Free(P)
            leave
        ;
    ;
    PutLn(P.FValue)
;
