== Safe pointers (CANON-25): Exit from a case arm inside a loop, after a Free
== on that path, leaves the ref mut owner given away.
Type
    TNode Struct
        FValue Integer := 0
    ;

Walk(ref mut P Own<TNode>) :
    for I in 1..3
        case I
            1
                PutLn("one")
            2
                Free(P)
                Exit
            else
                PutLn("other")
        ;
    ;
;

Main :
    P := New(TNode(FValue := 1))
    Walk(P)
;
