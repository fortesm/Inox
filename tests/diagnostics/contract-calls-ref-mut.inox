== CANON-24: a contract only reads; a ref mut argument would change state.
Type
    TA Struct
        FX Integer := 0
    ;
Grow(ref mut N Integer) Bool :
    N += 1
    Return true
;
TA.Check(Self mut) :
    pre Grow(Self.FX)
    Self.FX += 1
;
Main :
    A TA
    A.Check
;
