== CANON-8 (generic-struct-methods): methods of generic structs, one

== generic-struct-invariants, rule 8: an invariant an instance cannot
== check names the instance and the routine that made it.
Type
    TBox<T> Struct
        FValue T
        invariant Self.FValue > 0
    ;

Main :
    B := TBox(FValue := True)
    PutLn(B.FValue)
;
