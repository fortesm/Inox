== Safe pointers (CANON-25, r3.136): a routine gives back an owner it received
== as ref mut before an exception leaves it; the value of the new owner is computed
== by a routine, which may raise, before the assignment gives it back.
Type
    TNode Struct
        FValue Integer := 0
    ;

Compute(X Integer) Integer :
    Return X + 1
;

Renew(ref mut P Own<TNode>) :
    Before := P.FValue
    Free(P)
    P := New(TNode(FValue := Compute(Before)))
;

Main :
    P := New(TNode(FValue := 1))
    Renew(P)
;
