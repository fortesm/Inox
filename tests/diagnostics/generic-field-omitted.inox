== r3.82 (CANON-9): a construction gives every field of a type parameter.
Type
    TBox<T> Struct
        FValue T
        FCount Integer := 0
    ;

Main :
    X TBox<Integer> := TBox(FCount := 1)
    PutLn(X.FCount)
;
