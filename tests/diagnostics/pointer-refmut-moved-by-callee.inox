== Safe pointers (CANON-25): a ref mut owner moved into a local is not given
== back.
Type
    TNode Struct
        FValue Integer := 0
    ;

Steal(ref mut P Own<TNode>) :
    Q := Move(P)
    PutLn(Q.FValue)
;

Main :
    P := New(TNode(FValue := 5))
    Steal(P)
;
