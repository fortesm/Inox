== A Link to a ref parameter without owners is rejected as before (change read-only-through-owners, test 3.12b).
Type
    TPoint Struct
        FX Integer := 0
    ;

Peek(ref X TPoint) :
    L Link<Integer> := Link(X.FX)
    PutLn(Value(L))
;

Main :
    X TPoint
    Peek(X)
;
