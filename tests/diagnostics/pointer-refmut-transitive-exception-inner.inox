== Safe pointers (CANON-25): the intermediate routine's own handler sees its
== ref mut owner as given away after the inner call raised.
Type
    TNode Struct
        FValue Integer := 0
    ;

Renew(ref mut P Own<TNode>) :
    Free(P)
    if True
        Raise RangeError
    ;
    P := New(TNode)
;

Pass(ref mut P Own<TNode>) :
    try
        Renew(P)
    except
        On RangeError
            PutLn(P.FValue)
        ;
    ;
;

Main :
    P := New(TNode(FValue := 1))
    Pass(P)
;
