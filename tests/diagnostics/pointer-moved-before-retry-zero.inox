== Safe pointers: the analysis does not read the count of Retry, so Retry(0),
== which rethrows at once, is checked like any Retry: a handler that frees
== an owner must assign it again first.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    try
        try
            Raise RangeError
        except
            On RangeError
                Free(P)
                Retry(0)
            ;
        ;
    except
        On RangeError
            PutLn(P.FValue)
        ;
    ;
;
