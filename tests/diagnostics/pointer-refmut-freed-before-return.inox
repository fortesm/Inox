== Safe pointers (CANON-25): a Return from a loop, after the ref mut owner
== was freed, leaves it given away.
Type
    TNode Struct
        FValue Integer := 0
    ;

Find(ref mut P Own<TNode>, N Integer) Integer :
    for I in 1..N
        if I = P.FValue
            Free(P)
            Return I
        ;
    ;
    Return 0
;

Main :
    P := New(TNode(FValue := 2))
    PutLn(Find(P, 3))
;
