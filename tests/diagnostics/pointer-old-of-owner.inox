== Safe pointers and CANON-24: old of an owner would copy it.
Type
    TNode Struct
        FValue Integer := 0
    ;

TNode.Swap(Self mut, P Own<TNode>) :
    pos Self.FValue = 1
    Self.FValue := P.FValue
;

Store(ref mut D Option<Own<TNode>>) :
    pos Alive(old D)
    D := New(TNode)
;

Main :
    O Option<Own<TNode>>
    Store(O)
    PutLn(Alive(O))
;
