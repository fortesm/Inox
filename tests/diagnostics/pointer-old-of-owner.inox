== Safe pointers and CANON-24: old of an owner would copy it.
Module Diagnostics.PointerOldOfOwner

Type
    TNo Struct
        FValor Integer := 0
    ;

TNo.Trocar(Self mut, P Own<TNo>) :
    pos Self.FValor = 1
    Self.FValor := P.FValor
;

Guardar(ref mut D Option<Own<TNo>>) :
    pos Alive(old D)
    D := New(TNo)
;

Main :
    O Option<Own<TNo>>
    Guardar(O)
    PutLn(Alive(O))
;
