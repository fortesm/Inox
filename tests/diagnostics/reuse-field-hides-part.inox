== CANON-9 (method-reuse): a field of the struct cannot have the name of a reused member.
Module Diagnostics.ReuseFieldHidesPart
Type
    TA Struct
        FX Integer := 0
    ;
    TB Struct
        FX Integer := 0
    ;
TA.Show(Self) :
    PutLn(Self.FX)
;
TB.Show(Self) :
    PutLn(Self.FX)
;
TA.Bump(Self mut) :
    Self.FX += 1
;
Type
    TC Struct (TA)
        FX Integer := 0
    ;
Main :
    C TC
    PutLn(C.FX)
;
