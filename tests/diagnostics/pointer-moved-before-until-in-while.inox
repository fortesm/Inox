== Safe pointers: an `until` inside a while leaves the enclosing repeat
== with its owners.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    I Integer := 0
    repeat
        while True
            I := I + 1
            Free(P)
            until I > 1
            P := New(TNode)
            leave
        ;
    ;
    PutLn(P.FValue)
;
