== r3.81, CANON-25: an owner is never copied, so an array of owners is only
== filled with None.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    One Option<Own<TNode>> := New(TNode(FValue := 1))
    Nodes Array[1..2] Option<Own<TNode>> := Fill(One)
    PutLn(Alive(Nodes[1]))
;
