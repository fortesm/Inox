== CANON-5 (v3.27): every target of a chained assignment is a variable or
== a field.
Module Diagnostics.ChainedAssignmentCallTarget

Twice(N Integer) Integer :
    Return N * 2
;

Main :
    A := 1
    Twice(1) := A := 3
;