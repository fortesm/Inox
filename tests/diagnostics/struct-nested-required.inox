== r3.82 (CANON-5): a struct field whose struct has a field without an
== implicit value makes the outer struct need a construction too.
Type
    TSuit (Club, Diamond, Heart, Spade)
    TCard Struct
        FSuit TSuit
    ;
    THand Struct
        FFirst TCard
        FSize Integer := 1
    ;

Main :
    H THand
    PutLn(H.FSize)
;
