== CANON-24: a contract only reads; a Self mut method would change state.
Type
    TA Struct
        FX Integer := 0
    ;
    TB Struct (TA)
        FY Integer := 0
    ;
TA.Bump(Self mut) :
    Self.FX += 1
;
TA.Show(Self) Integer :
    pre Self.FX >= 0
    Return Self.FX
;
Inc(ref mut N Integer) :
    N += 1
;
TA.Check(Self mut) :
    pre Self.Bumped
    Self.FX += 1
;
TA.Bumped(Self mut) Bool :
    Self.FX += 1
    Return true
;
Main :
    A TA
    A.Check
;
