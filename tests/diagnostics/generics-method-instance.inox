== CANON-8 (generic-struct-methods): methods of generic structs, one

== generic-struct-methods, rule 8: an error in an instance names it and the
== call that made it, at the line of the generic body.
Type
    TBox<T> Struct
        FValue T
    ;

TBox<T>.Twice(Self) T :
    Return Self.FValue * 2
;

Main :
    B := TBox(FValue := "a")
    PutLn(B.Twice)
;
