== Parameters are immutable; an array parameter is a copy that cannot be written.
Module Diagnostics.ArrayParameterImmutable

Clear(V Array[1..3] Integer) :
    V[1] := 0
;

Main :
    A Array[1..3] Integer
    Clear(A)
    PutLn(A[1])
;
