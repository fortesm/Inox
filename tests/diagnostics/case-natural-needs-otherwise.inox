== ADR-0011: Natural is UInt64 with floor 0 (CANON-8). Its upper half does not
== fit in the Int64 constants the compiler checks, so `otherwise` is required.
Module Diagnostics.CaseNaturalNeedsOtherwise

Main :
    N Natural := Natural(1)
    case N
        0..9223372036854775807 PutLn(1)
    ;
;
