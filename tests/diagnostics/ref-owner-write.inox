== change read-only-through-owners: what a ref parameter owns is read-only.
Type
    TNode Struct
        FValue Integer := 0
    ;
Poke(ref P Own<TNode>) :
    P.FValue := 1
;

Main :
    P Own<TNode> := New(TNode)
    Poke(P)
    PutLn(P.FValue)
;
