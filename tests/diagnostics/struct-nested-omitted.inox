== r3.82 (CANON-9): a construction gives a nested struct that has no
== complete defaults.
Type
    TSuit (Club, Diamond, Heart, Spade)
    TCard Struct
        FSuit TSuit
    ;
    THand Struct
        FFirst TCard
        FSize Integer := 1
    ;

Main :
    H := THand(FSize := 2)
    PutLn(H.FSize)
;
