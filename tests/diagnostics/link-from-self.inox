== change read-only-through-owners: no Link to what a Self receiver owns.
Type
    TNode Struct
        FValue Integer := 0
    ;
    THolder Struct
        FChild Own<TNode>
    ;
THolder.Peek(Self) :
    L Link<Integer> := Link(Self.FChild.FValue)
    PutLn(Value(L))
;

Main :
    H THolder := THolder(FChild := New(TNode))
    H.Peek
;
