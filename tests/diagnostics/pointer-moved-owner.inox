== Safe pointers: an owner given away before a `leave` is given away after
== the loop; using it there is a compile error (the run time keeps its
== check, see pointers-owner-freed-by-callee).
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 5))
    for I in 1..3
        Q := Move(P)
        PutLn("round ", I, ": ", Q.FValue)
        leave
        P := New(TNode)
    ;
    PutLn(P.FValue)
;
