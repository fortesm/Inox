== Safe pointers: a Link to a parameter is not supported yet.
Module Diagnostics.PointerLinkToParameter

Type
    TNo Struct
        FValor Integer := 0
        FProximo Option<Own<TNo>>
    ;

Pega(X Integer) Link<Integer> :
    Return Link(X)
;

Main :
    PutLn(Value(Pega(1)))
;
