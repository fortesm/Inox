== Safe pointers: a Link to a parameter is not supported yet.
Type
    TNode Struct
        FValue Integer := 0
        FNext Option<Own<TNode>>
    ;

Catch(X Integer) Link<Integer> :
    Return Link(X)
;

Main :
    PutLn(Value(Catch(1)))
;
