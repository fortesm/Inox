== Safe pointers (CANON-25, r3.136): a routine gives back an owner it received
== as ref mut before an exception leaves it; this one raises between Free and the assignment.
Type
    TNode Struct
        FValue Integer := 0
    ;

Renew(ref mut P Own<TNode>, Fail Bool) :
    Free(P)
    if Fail
        Raise RangeError
    ;
    P := New(TNode)
;

Main :
    P := New(TNode(FValue := 1))
    Renew(P, False)
;
