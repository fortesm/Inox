== r3.82 (CANON-9): a construction that omits a nested struct without
== complete defaults is an error.
Type
    TStatus (Pending, Approved, Rejected)
    TFrame Struct
        FState TStatus
        FSize Integer := 0
    ;
    TRoute Struct
        FFrame TFrame
        FHops Integer := 1
    ;

Main :
    R := TRoute(FHops := 2)
    PutLn(R.FHops)
;
