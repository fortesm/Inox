== Safe pointers (CANON-25, r3.136): a routine gives back an owner it received
== as ref mut before an exception leaves it; nested ensures run inner first:
== what the inner one frees crosses the outer one, which does not assign it again.
Type
    TNode Struct
        FValue Integer := 0
    ;

Work(X Integer) :
    PutLn(X)
;

Renew(ref mut P Own<TNode>) :
    try
        try
            Work(1)
        ensure
            Free(P)
        ;
    ensure
        PutLn("outer")
    ;
    P := New(TNode)
;

Main :
    P := New(TNode(FValue := 1))
    Renew(P)
;
