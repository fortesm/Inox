== Safe pointers (CANON-25): a ref mut owner freed on one branch reaches the
== end of the routine given away.
Type
    TNode Struct
        FValue Integer := 0
    ;

Maybe(ref mut P Own<TNode>, Drop Bool) :
    if Drop
        Free(P)
    else
        PutLn(P.FValue)
    ;
;

Main :
    P := New(TNode(FValue := 5))
    Maybe(P, False)
;
