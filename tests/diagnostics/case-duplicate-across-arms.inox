== ADR-0011: a value may appear in one arm only.
Module Diagnostics.CaseDuplicateAcrossArms

Main :
    X := 4
    case X
        1 | 2 PutLn(1)
        3 | 2 PutLn(2)
        otherwise PutLn(3)
    ;
;
