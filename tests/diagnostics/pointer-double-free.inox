== Safe pointers: freeing an owner twice is a compile error.
Module Diagnostics.PointerDoubleFree

Type
    TNo Struct
        FValor Integer := 0
        FProximo Option<Own<TNo>>
    ;

Main :
    P := New(TNo)
    Free(P)
    Free(P)
;
