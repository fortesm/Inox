== change read-only-through-owners: a Self mut method on an object owned through a ref parameter.
Type
    TNode Struct
        FValue Integer := 0
    ;
    THolder Struct
        FChild Own<TNode>
    ;
TNode.Bump(Self mut) :
    Self.FValue += 1
;

Poke(ref H THolder) :
    H.FChild.Bump
;

Main :
    H THolder := THolder(FChild := New(TNode))
    Poke(H)
    PutLn(H.FChild.FValue)
;
