== change read-only-through-owners: an element of an owned array below a ref parameter.
Poke(ref P Own<Array[1..3] Integer>) :
    P[1] := 5
;

Main :
    T Array[1..3] Integer := Fill(0)
    P := New(T)
    Poke(P)
    PutLn(P[1])
;
