== r3.88 (E2): a method with a result is a function too.
Type
    TCounter Struct
        Count Integer := 0
    ;

TCounter.Next(Self) Integer :
    Return Self.Count + 1
;

Main :
    C TCounter
    C.Next
    PutLn(C.Count)
;
