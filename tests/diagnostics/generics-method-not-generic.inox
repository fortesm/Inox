== CANON-8 (generic-struct-methods): methods of generic structs, one

== generic-struct-methods, rule 7: an ordinary struct has no type parameters.
Type
    TPair<K, V> Struct
        FKey K
        FValue V
    ;
    TPoint Struct
        FX Integer := 0
    ;

TPoint<T>.Move(Self mut) :
    Self.FX := 1
;

Main :
    PutLn(1)
;
