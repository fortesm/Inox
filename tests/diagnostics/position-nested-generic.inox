== Change windows-stack (r3.113): the position of an error stays with the error
== through nested generic instances: the line of the innermost body, not of
== the routines that used it.
Inner<T>(X T) T :
    Return X * "two"
;

Outer<T>(X T) T :
    Y T := Inner(X)
    Return Y
;

Main :
    PutLn(Outer(3))
;
