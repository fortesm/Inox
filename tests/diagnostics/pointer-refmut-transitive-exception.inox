== Safe pointers (CANON-25): the owner passed on through an intermediate
== routine to a callee that may raise is seen as given away by the
== caller's handler.
Type
    TNode Struct
        FValue Integer := 0
    ;

Renew(ref mut P Own<TNode>) :
    Free(P)
    if True
        Raise RangeError
    ;
    P := New(TNode)
;

Pass(ref mut P Own<TNode>) :
    Renew(P)
;

Main :
    P := New(TNode(FValue := 1))
    try
        Pass(P)
    except
        On RangeError
            PutLn(P.FValue)
        ;
    ;
;
