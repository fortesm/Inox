== Safe pointers: an Own field is given in the construction.
Module Diagnostics.PointerConstructionWithoutOwner

Type
    TNo Struct
        FValor Integer := 0
        FProximo Option<Own<TNo>>
    ;

Type
    TCaixa Struct
        FConteudo Own<TNo>
        FRotulo String := ""
    ;

Main :
    D := TCaixa(FRotulo := "vazia")
    PutLn(D.FRotulo)
;
