== Safe pointers: an Own field is given in the construction.
Type
    TNode Struct
        FValue Integer := 0
        FNext Option<Own<TNode>>
    ;

Type
    TCrate Struct
        FContent Own<TNode>
        FLabel String := ""
    ;

Main :
    D := TCrate(FLabel := "emptyone")
    PutLn(D.FLabel)
;
