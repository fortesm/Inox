== Safe pointers (CANON-25, r3.136): a routine gives back an owner it received
== as ref mut before an exception leaves it; a recursive call may raise, and the owner is
== given away across it.
Type
    TNode Struct
        FValue Integer := 0
    ;

Down(ref mut P Own<TNode>, N Integer) :
    if N = 0
        Exit
    ;
    Q := Move(P)
    Down(Q, N - 1)
    P := Move(Q)
;

Main :
    P := New(TNode(FValue := 1))
    Down(P, 3)
;
