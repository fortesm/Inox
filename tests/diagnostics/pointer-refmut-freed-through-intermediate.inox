== Safe pointers (CANON-25): an intermediate routine passes its ref mut owner
== on, which is given back, and then frees it itself.
Type
    TNode Struct
        FValue Integer := 0
    ;

Touch(ref mut P Own<TNode>) :
    P.FValue := P.FValue + 1
;

Pass(ref mut P Own<TNode>) :
    Touch(P)
    Free(P)
;

Main :
    P := New(TNode(FValue := 2))
    Pass(P)
;
