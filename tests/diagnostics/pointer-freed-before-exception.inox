== Safe pointers: an exception may leave the try body from any call, so the
== handler sees an owner freed before it, even if assigned again later.
Type
    TNode Struct
        FValue Integer := 0
    ;

Check(I Integer) :
    if I > 0
        Raise RangeError
    ;
;

Main :
    P := New(TNode(FValue := 1))
    try
        Free(P)
        Check(1)
        P := New(TNode)
    except
        On RangeError
            PutLn(P.FValue)
        ;
    ;
;
