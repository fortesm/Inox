== CANON-24: Main has no contracts.
Module Diagnostics.ContractOnMain
Type
    TA Struct
        FX Integer := 0
    ;
    TB Struct (TA)
        FY Integer := 0
    ;
TA.Bump(Self mut) :
    Self.FX += 1
;
TA.Show(Self) Integer :
    pre Self.FX >= 0
    Return Self.FX
;
Inc(ref mut N Integer) :
    N += 1
;
Main :
    pre 1 > 0
    PutLn(1)
;
