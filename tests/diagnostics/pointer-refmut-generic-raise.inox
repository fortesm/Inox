== Safe pointers (CANON-25, r3.136): a routine gives back an owner it received
== as ref mut before an exception leaves it; an instance of a generic routine with an owner
== for T frees it and calls a routine.
Type
    TNode Struct
        FValue Integer := 0
    ;

Work(X Integer) :
    PutLn(X)
;

Replace<T>(ref mut X T, ref mut Y T) :
    Z := Move(X)
    Work(1)
    X := Move(Y)
    Y := Move(Z)
;

Main :
    P := New(TNode(FValue := 1))
    Q := New(TNode(FValue := 2))
    Replace(P, Q)
;
