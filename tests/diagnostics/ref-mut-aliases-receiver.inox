== ADR-0016: the receiver is an argument; a ref mut argument may not reach it again.
Type
    TA Struct
        FX Integer := 0
    ;
    TB Struct
        FX Integer := 0
    ;
TA.Show(Self) :
    PutLn(Self.FX)
;
TB.Show(Self) :
    PutLn(Self.FX)
;
TA.Bump(Self mut) :
    Self.FX += 1
;
TA.Copy(Self mut, ref mut Into Integer) :
    Into := Self.FX
;
Main :
    A TA
    A.Copy(A.FX)
    PutLn(A.FX)
;
