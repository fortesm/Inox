== Safe pointers: nested ensures run inner first; what the inner one frees
== crosses the outer one, which does not assign it again, to the statement
== after the loop.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    for I in 1..3
        try
            try
                leave
            ensure
                Free(P)
            ;
        ensure
            PutLn("outer ensure ", I)
        ;
        P := New(TNode)
    ;
    PutLn(P.FValue)
;
