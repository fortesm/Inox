== Safe pointers: an `ensure` that assigns an owner again in one arm of an if
== only does not give it back on every path.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    Fresh Bool := False
    try
        Free(P)
    ensure
        if Fresh
            P := New(TNode)
        ;
    ;
    PutLn(P.FValue)
;
