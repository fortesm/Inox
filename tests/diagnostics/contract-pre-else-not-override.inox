== CANON-24: 'pre else' and 'pos then' belong to an Override.
Module Diagnostics.ContractPreElseNotOverride
Type
    TA Struct
        FX Integer := 0
    ;
    TB Struct (TA)
        FY Integer := 0
    ;
TA.Bump(Self mut) :
    Self.FX += 1
;
TA.Show(Self) Integer :
    pre Self.FX >= 0
    Return Self.FX
;
Inc(ref mut N Integer) :
    N += 1
;
F(N Integer) :
    pre else N > 0
    PutLn(N)
;
Main :
    F(1)
;
