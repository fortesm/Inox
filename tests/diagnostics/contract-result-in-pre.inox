== CANON-24: Result exists only in a function's pos.
Type
    TA Struct
        FX Integer := 0
    ;
    TB Struct (TA)
        FY Integer := 0
    ;
TA.Bump(Self mut) :
    Self.FX += 1
;
TA.Show(Self) Integer :
    pre Self.FX >= 0
    Return Self.FX
;
Inc(ref mut N Integer) :
    N += 1
;
F(N Integer) Integer :
    pre Result > 0
    Return N
;
Main :
    PutLn(F(1))
;
