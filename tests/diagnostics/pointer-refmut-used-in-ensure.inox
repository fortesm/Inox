== Safe pointers (CANON-25, r3.135 Q2, kept by r3.136): `ensure` also runs
== after an exception from the callee, so it sees the ref mut owner as given
== away.
Type
    TNode Struct
        FValue Integer := 0
    ;

Renew(ref mut P Own<TNode>) :
    Free(P)
    P := New(TNode)
;

Main :
    P := New(TNode(FValue := 1))
    try
        Renew(P)
    ensure
        PutLn(P.FValue)
    ;
;
