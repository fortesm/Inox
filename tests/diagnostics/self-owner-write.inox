== change read-only-through-owners: a Self method only reads what its receiver owns.
Type
    TNode Struct
        FValue Integer := 0
    ;
    THolder Struct
        FChild Own<TNode>
    ;
THolder.Poke(Self) :
    Self.FChild.FValue := 1
;

Main :
    H THolder := THolder(FChild := New(TNode))
    H.Poke
    PutLn(H.FChild.FValue)
;
