== CANON-13 (range-types): a Range value is not an Integer argument; the
== call writes Integer(D).
Type
    TMeters Range 0..1000

Twice(N Integer) Integer :
    Return N * 2
;

Main :
    D TMeters := 500
    PutLn(Twice(Integer(D)))
    PutLn(Twice(D))
;
