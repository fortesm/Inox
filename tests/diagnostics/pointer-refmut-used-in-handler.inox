== Safe pointers (CANON-25, r3.135 Q2, kept by r3.136): the caller does not
== look into the callee, so an owner passed as ref mut inside a try is seen
== as given away by the handler.
Type
    TNode Struct
        FValue Integer := 0
    ;

Renew(ref mut P Own<TNode>) :
    if True
        Raise RangeError
    ;
    Free(P)
    P := New(TNode)
;

Main :
    P := New(TNode(FValue := 1))
    try
        Renew(P)
    except
        On RangeError
            PutLn(P.FValue)
        ;
    ;
;
