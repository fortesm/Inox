== Safe pointers (CANON-25): an exception may leave the callee before it gives
== the ref mut owner back, so the handler sees it as given away.
Type
    TNode Struct
        FValue Integer := 0
    ;

Renew(ref mut P Own<TNode>) :
    Free(P)
    if True
        Raise RangeError
    ;
    P := New(TNode)
;

Main :
    P := New(TNode(FValue := 1))
    try
        Renew(P)
    except
        On RangeError
            PutLn(P.FValue)
        ;
    ;
;
