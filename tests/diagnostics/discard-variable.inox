== r3.93: `_ := N` is not a read of N: it would pass the unread-local rule (OPEN-4) without using N.
Type
    TPoint Struct
        FX Integer := 0
    ;

Twice(N Integer) Integer :
    Return 2 * N
;

Show(Text String) :
    PutLn(Text)
;

TPoint.Clear(Self mut) :
    Self.FX := 0
;

Main :
    N := Twice(2)
    _ := N
;
