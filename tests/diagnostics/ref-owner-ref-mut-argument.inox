== change read-only-through-owners: an owned field of a ref parameter passed as ref mut.
Type
    TNode Struct
        FValue Integer := 0
    ;
    THolder Struct
        FChild Own<TNode>
    ;
Increment(ref mut X Integer) :
    X += 1
;

Poke(ref H THolder) :
    Increment(H.FChild.FValue)
;

Main :
    H THolder := THolder(FChild := New(TNode))
    Poke(H)
    PutLn(H.FChild.FValue)
;
