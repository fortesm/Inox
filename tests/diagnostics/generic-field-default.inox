== r3.82: no instance may bring a default the generic struct does not
== guarantee, so a field of a type parameter has none.
Type
    TBox<T> Struct
        FValue T := 0
    ;

Main :
    X := TBox(FValue := 1)
    PutLn(X.FValue)
;
