== Safe pointers: `ensure` runs before Retry: what it frees is freed when
== the body runs again.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    try
        PutLn(P.FValue)
        Raise RangeError
    except
        On RangeError
            Retry(2)
        ;
    ensure
        Free(P)
    ;
    P := New(TNode)
    PutLn(P.FValue)
;
