== r3.82: a reused part without complete defaults leaves its struct without
== them too.
Type
    TStatus (Pending, Approved, Rejected)
    TFrame Struct
        FState TStatus
    ;
    TTagged Struct (TFrame)
        FLabel String := "tagged"
    ;

Main :
    T TTagged
    PutLn(T.FLabel)
;
