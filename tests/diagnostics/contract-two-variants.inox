== CANON-24: a loop has one variant.
Type
    TA Struct
        FX Integer := 0
    ;
    TB Struct (TA)
        FY Integer := 0
    ;
TA.Bump(Self mut) :
    Self.FX += 1
;
TA.Show(Self) Integer :
    pre Self.FX >= 0
    Return Self.FX
;
Inc(ref mut N Integer) :
    N += 1
;
Main :
    I := 0
    while I < 3
        variant 3 - I
        variant 4 - I
        I += 1
    ;
;
