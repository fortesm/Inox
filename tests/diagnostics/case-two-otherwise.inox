== ADR-0011: a case has at most one `otherwise`.
Module Diagnostics.CaseTwoOtherwise

Main :
    X := 4
    case X
        1 PutLn(1)
        otherwise PutLn(2)
        otherwise PutLn(3)
    ;
;
