== v3.56: structs are not ordered.
Type
    TPoint Struct
        FX Integer
    ;

Main :
    P TPoint := TPoint(FX := 1)
    Q TPoint := TPoint(FX := 2)
    if P < Q
        PutLn("smaller")
    ;
;
