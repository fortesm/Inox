== CANON-2: hexadecimal literals are written `$FF`. `0x` is not Inox syntax;
== before v3.31 it was accepted and lowered to invalid LLVM IR.
Module Diagnostics.Hex0xRejected

Main :
    X := 0xFF
    PutLn(X)
;
