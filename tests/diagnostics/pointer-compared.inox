== Safe pointers: Same, Alive and Value, never = on pointers.
Module Diagnostics.PointerCompared

Type
    TNo Struct
        FValor Integer := 0
        FProximo Option<Own<TNo>>
    ;

Main :
    P := New(TNo)
    L := Link(P)
    PutLn(L = Link(P))
;
