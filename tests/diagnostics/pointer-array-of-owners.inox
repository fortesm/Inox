== Safe pointers: an array of owners holds Option<Own<T>>, born None.
Type
    TNo Struct
        FValor Integer := 0
        FProximo Option<Own<TNo>>
    ;

Main :
    A Array[1..3] Own<TNo>
    PutLn(Length(A))
;
