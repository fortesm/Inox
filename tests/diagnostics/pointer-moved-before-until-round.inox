== Safe pointers: a false `until` goes on with the round, and the next round
== starts with the owner given away.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    I Integer := 0
    repeat
        I := I + 1
        PutLn(P.FValue)
        Free(P)
        until I = 3
    ;
;
