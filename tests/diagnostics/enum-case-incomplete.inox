== CANON-13, ADR-0011: a case on an enum without else names every literal;
== the message names the first missing one.
Type
    TSuit (Club, Diamond, Heart, Spade)

Main :
    S := Spade
    case S
        Club PutLn(1)
        Diamond | Heart PutLn(2)
    ;
;
