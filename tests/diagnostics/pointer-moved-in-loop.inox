== Safe pointers: an owner given away in a loop needs a new value before the next round.
Type
    TNo Struct
        FValor Integer := 0
        FProximo Option<Own<TNo>>
    ;

Main :
    P := New(TNo)
    for I in 1..2
        Q := Move(P)
        PutLn(Q.FValor, I)
    ;
;
