== change read-only-through-owners: no Link to an object owned by a field of a ref parameter.
Type
    TNode Struct
        FValue Integer := 0
    ;
    THolder Struct
        FChild Own<TNode>
    ;
Peek(ref H THolder) :
    L Link<TNode> := Link(H.FChild)
    PutLn(L.FValue)
;

Main :
    H THolder := THolder(FChild := New(TNode))
    Peek(H)
;
