== r3.82 (CANON-9): a construction gives every array field without default.
Type
    TPacket Struct
        FData Array[1..4] Byte
        FSize Integer := 0
    ;

Main :
    Q := TPacket(FSize := 1)
    PutLn(Q.FSize)
;
