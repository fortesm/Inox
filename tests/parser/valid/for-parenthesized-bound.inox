== ADR-0010: the bounds of a for header are range-level expressions, and a
== bound in parentheses is a bound, not a step.
Module ForParenthesizedBound

Main :
    N := 4
    for I in 1..(N - 1)
        PutLn(I)
    ;
    for J in (N - 3)..N step 2
        PutLn(J)
    ;
;
