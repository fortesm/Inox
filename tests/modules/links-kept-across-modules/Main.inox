Use Points

Main :
    PutLn("shifted ", Shifted(10))
    E := Escaped
    PutLn("escaped ", Alive(E))
    Q := New(TPoint(FX := 3, FY := 4))
    PutLn("total ", Total(Link(Q)))
    Free(Q)
;
