== Safe pointers (CANON-25, r3.136): a routine of another module that raises
== only after it gave back the owner it received as ref mut.
Type
    TNode Struct Public
    Public
        FValue Integer := 0
    ;

Renew(ref mut P Own<TNode>) Public :
    Before := P.FValue
    Free(P)
    P := New(TNode(FValue := Before + 1))
    Raise RangeError
;
