Type
    TAccount Struct Public
        FBalance Currency := 0.00
        FHistory Integer := 0
        invariant Self.FBalance >= 0.00, "the balance is never negative"
    Public
        FOwner String := ""
    ;

TAccount.Deposit(Self mut, Amount Currency) Public :
    pre Amount > 0.00, "a positive deposit"
    Self.FBalance += Amount
    Self.Log
;

TAccount.Withdraw(Self mut, Amount Currency) Public :
    pre Amount > 0.00 and Amount <= Self.FBalance, "enough balance"
    Self.FBalance -= Amount
    Self.Log
;

TAccount.Balance(Self) Currency Public :
    Return Self.FBalance
;

TAccount.Log(Self mut) :
    Self.FHistory += 1
;

OpenAccount(Owner String) TAccount Public :
    Return TAccount(FOwner := Owner)
;
