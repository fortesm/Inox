== r3.99 (C3): a struct of another module that reuses TBeing sees its
== public fields and methods; TBeing's methods still act on its private
== fields.
Use People.Being

Type
    TPerson Struct (TBeing)
        FName String := "Ana"
    ;

Main :
    P TPerson
    P.FKind := "person"
    PutLn(P.FName, " ", P.FKind, " ", P.Describe)
;
