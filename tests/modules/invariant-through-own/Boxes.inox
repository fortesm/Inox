== CANON-24 (safe-pointers-followups 3.1): a struct of another module with a
== public field keeps its invariant when that field is written through an
== Own in the importing module.
Type
    TBox Struct Public
    Public
        FValue Integer := 1
        invariant Self.FValue > 0, "the value is positive"
    ;
