== r3.99 (C1): outside its module a struct shows its public fields and
== methods; the balance changes only through Deposit and Withdraw, whose
== contracts keep it from going negative.
Use Bank.Accounts

Main :
    A := OpenAccount("Marcelo")
    A.Deposit(500.00)
    A.Withdraw(120.00)
    PutLn(A.FOwner, ": ", A.Balance)
    A.FOwner := "Maria"
    B TAccount
    C := TAccount(FOwner := "Ana")
    PutLn(A.FOwner, " ", B.Balance, " ", C.FOwner)
;
