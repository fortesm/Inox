== generic-struct-methods: the struct and its Public methods, used from
== another module; each instance is this module's routine.
Type
    TPair<K, V> Struct Public
        FKey K
    Public
        FValue V
    ;

MakePair<K, V>(Key K, Value V) TPair<K, V> Public :
    Return TPair(FKey := Key, FValue := Value)
;

TPair<K, V>.Key(Self) K Public :
    Return Self.FKey
;

TPair<K, V>.SetKey(Self mut, Key K) Public :
    Self.FKey := Key
;

TPair<K, V>.Hidden(Self) K :
    Return Self.FKey
;
