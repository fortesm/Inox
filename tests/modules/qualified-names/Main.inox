== r3.99 (A2): with the module's name, both Fee are reached; so are a
== public type, its public field and a public Const.
Use Bank.Accounts
Use Bank.Loans

Main :
    PutLn(Bank.Accounts.Fee(10), " ", Bank.Loans.Fee(10))
    A Bank.Accounts.TAccount
    A.FOwner := "Ana"
    PutLn(A.FOwner, " ", Bank.Accounts.MaxDeposit)
;
