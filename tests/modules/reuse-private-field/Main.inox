== r3.99 (C3): reusing a struct of another module does not open its
== private fields, neither from outside nor from the new struct's methods.
Use People.Being

Type
    TPerson Struct (TBeing)
        FName String := "Ana"
    ;

TPerson.Peek(Self) Integer :
    Return Self.FSecret
;

Main :
    P TPerson
    PutLn(P.Peek)
;
