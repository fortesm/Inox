== r3.99 (A3): `Use M as A` names the module A in this file; A.Fee,
== A.TAccount and A.MaxDeposit reach its public declarations, and two
== aliases tell the two Fee apart.
Use Bank.Accounts as Accounts
Use Bank.Loans as Loans

Main :
    PutLn(Accounts.Fee(10), " ", Loans.Fee(10))
    A Accounts.TAccount
    A.FOwner := "Ana"
    PutLn(A.FOwner, " ", Accounts.MaxDeposit)
;
