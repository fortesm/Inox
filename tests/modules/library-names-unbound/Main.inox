== r3.99: the entry file may declare names a library writes for its own
== locals and helpers (Text, ZeroPadded, Y); neither side sees the other.
Use Std.DateUtils

ZeroPadded(N Integer) String :
    Return "#" + String(N)
;

Main :
    Text := ZeroPadded(7)
    PutLn(Text, " ", FormatDateTime(EncodeDateTime(2026, 10, 29, 9, 5, 0), "dd/mm/yyyy hh:nn"))
;
