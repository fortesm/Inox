== r3.99: Export Use passes the public declarations of a module to the
== users of the module that writes it; Bank gives Bank.Accounts and
== Bank.Reports, and the qualified names of both work too.
Use Bank

Main :
    PutLn(Fee(10), " ", Report(10))
    PutLn(Bank.Accounts.Fee(1), " ", Bank.Fee(2))
;
