== r3.99: private names of different modules never meet: each module
== has its own Helper and Count, and so does Main.
Use Bank.Accounts
Use Bank.Loans

Helper Integer :
    Return 1
;

Main :
    PutLn(Helper, " ", Bank.Accounts.Fee(1), " ", Bank.Loans.Fee(1))
;
