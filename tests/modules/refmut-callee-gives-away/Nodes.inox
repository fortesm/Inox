== Safe pointers (CANON-25): a routine of another module that frees an owner
== received as ref mut and returns is rejected in its own module.
Type
    TNode Struct Public
    Public
        FValue Integer := 0
    ;

Release(ref mut P Own<TNode>) Public :
    Free(P)
;
