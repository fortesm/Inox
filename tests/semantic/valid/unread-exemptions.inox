== OPEN-4 covers locals only. Parameters, for iterators, exception bindings,
== State and Const may go unread.
Module UnreadExemptions

Const Unused := 1

State :
    Spare Integer := 0
;

Ignore(N Integer) :
    PutLn(1)
;

Main :
    Ignore(2)
    for I in 1..2
        PutLn(0)
    ;
    try
        Raise IOError
    except
        On E IOError
            PutLn(3)
        ;
    ;
;
