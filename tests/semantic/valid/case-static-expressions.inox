== ADR-0011: static choices include constant expressions: `not False`, a
== parenthesized comparison of constants, a Char Const, and literal-only Integer
== expressions read in the selector type.
Module CaseStaticExpressions

Const Letter := 'A'

Main :
    B := True
    case B
        not False PutLn(1)
        (1 > 2) PutLn(0)
    ;
    C := 'A'
    case C
        Letter PutLn(1)
        otherwise
    ;
    V UInt8 := UInt8(5)
    case V
        5 | 2 + 3 * 10 PutLn(1)
        otherwise
    ;
;
