== ADR-0011: a case accepted without `otherwise` covers every value, so a
== function whose arms all return does not reach its end.
Module CaseExhaustiveReturns

AsInt(B Bool) Integer :
    case B
        True Return 1
        False Return 0
    ;
;

Main :
    PutLn(AsInt(True))
;
