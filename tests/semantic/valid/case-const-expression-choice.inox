== ADR-0011: a Const whose value is a constant expression is a static choice,
== also when the Const is declared after the routine.
Module CaseConstExpressionChoice

Main :
    X := 5
    case X
        K PutLn(1)
        Twice | Twice + 1 PutLn(2)
        otherwise
    ;
;

Const K := 2 + 3
Const Twice := K * 2
