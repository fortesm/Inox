== ADR-0011: Ada/SPARK-style case. `|` separates alternatives, `A..B` is a
== static range (Const bounds are static), single-line arms are allowed, and
== `otherwise` covers the rest.
Module CaseAdaChoices

Const Low := 3
Const High := 9

Main :
    X := 4
    case X
        1 | 2
            PutLn("small")
        Low..High
            PutLn("medium")
        10 | 20..29 | 40 PutLn("mixed")
        otherwise
            PutLn("other")
    ;
;
