== v3.20: `break` and `finally` are no longer keywords; they are ordinary
== identifiers. `leave` exits a loop and `ensure` is the try cleanup clause.

Module FormerKeywordsAsIdentifiers

Main :
    Break Integer := 1
    Finally Integer := Break + 1

    while Break < 3
        Break := Break + 1
        if Break = 3
            leave
        ;
    ;

    try
        Finally := Finally + Break
    ensure
        Finally := Finally + 1
    ;
;
