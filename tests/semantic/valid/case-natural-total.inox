== ADR-0011 / CANON-8: Natural covers exactly 0..Int64.Max, so these choices
== are total and need no otherwise.
Module Semantic.CaseNaturalTotal

Main :
    N Natural := Natural(1)
    case N
        0 PutLn("zero")
        1..9223372036854775807 PutLn("positive")
    ;
;
