== ADR-0011: `otherwise` may be omitted when the choices provably cover every
== value of the selector type: Bool, UInt8 and the whole Int64 range here.
Module CaseExhaustiveWithoutOtherwise

Main :
    B := True
    case B
        True PutLn(1)
        False PutLn(0)
    ;
    V UInt8 := UInt8(7)
    case V
        0..127 PutLn(1)
        128..255 PutLn(2)
    ;
    X := 4
    case X
        -9223372036854775807 - 1..-1 PutLn(1)
        0 PutLn(0)
        1..9223372036854775807 PutLn(2)
    ;
;
