== CANON-5 and CANON-13: a Type section holds Struct, Range, short Enum and
== multi-line Enum declarations (their values: tests/runtime/enums.inox,
== tests/runtime/ranges.inox; a Char Range waits for Char values).
Type
    TPoint Struct
        FX Integer
    ;
    TMonth Range 1..12
    TLetter Range 'A'..'Z'
    TSuit (Club, Diamond, Heart, Spade)
    TDay Enum
        Monday
        Tuesday
    ;

Main :
    P TPoint
    PutLn(P.FX)
;
