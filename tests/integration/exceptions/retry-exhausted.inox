Module Integration.ExceptionsRetryExhausted

Main :
    Attempts := 0

    try
        try
            Attempts := Attempts + 1
            PutLn("attempt ", Attempts)
            Raise FileNotFound
        except
            On FileNotFound
                Retry(2)
            ;
        ensure
            PutLn("inner-ensure")
        ;
    except
        On IOError
            PutLn("outer-io")
        ;
    ;
;
