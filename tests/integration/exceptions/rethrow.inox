Module Integration.ExceptionsRethrow

Main :
    try
        try
            Raise RangeError
        except
            On RangeError
                PutLn("inner")
                Raise
            ;
        ensure
            PutLn("inner cleanup")
        ;
    except
        On RangeError
            PutLn("outer")
        ;
    ensure
        PutLn("outer cleanup")
    ;
;
