Module Integration.ExceptionsEnsureControlTransfers

Value Integer :
    try
        try
            Return 7
        ensure
            PutLn("return-inner")
        ;
    ensure
        PutLn("return-outer")
    ;
    Return 0
;

Main :
    V := Value
    PutLn("value=", V)

    while true
        try
            try
                leave
            ensure
                PutLn("leave-inner")
            ;
        ensure
            PutLn("leave-outer")
        ;
    ;

    for I in 1..2
        try
            PutLn("continue-body ", I)
            continue
        ensure
            PutLn("continue-cleanup")
        ;
    ;

    PutLn("before-exit")
    try
        Exit
    ensure
        PutLn("exit-cleanup")
    ;
    PutLn("unreachable")
;
