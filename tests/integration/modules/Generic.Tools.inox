== A module with generic routines and a generic struct (CANON-8), used by
== generics-across-modules.inox: each instance is made in the program that
== uses it.
Type
    TBox<T> Struct
        FItem T
    ;

Larger<T>(A T, B T) T :
    Return IIf(A > B, A, B)
;

Wrap<T>(X T) TBox<T> :
    Return TBox(FItem := X)
;
