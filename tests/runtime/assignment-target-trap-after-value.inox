== CANON-5: R's effects happen before the target is reached; its index out of range then stops the program, with no rollback (assignment-evaluation-order, Q3).
State
    I Integer := 1
    V Array[1..3] Integer := Fill(0)
;

Shift Integer :
    PutLn("value evaluated")
    I := 4
    Return 10
;

Main :
    V[I] := Shift
    PutLn("not reached")
;
