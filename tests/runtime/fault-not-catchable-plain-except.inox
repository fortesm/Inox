== Plain except is a catch-all for exceptions, but a runtime fault is not one.
Module Runtime.FaultNotCatchablePlainExcept

Main :
    M Integer := 9223372036854775807
    try
        PutLn(M + 1)
    except
        PutLn("caught")
    ;
    PutLn("continued")
;
