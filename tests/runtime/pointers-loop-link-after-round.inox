== Safe pointers (change loop-body-lifetime, r3.137): a Link to an owner
== declared in a loop body is dead once its round ends; reading through it
== after the loop stops with the dead-Link trap, never a read of freed
== memory.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    Keep := New(TNode(FValue := 0))
    L := Link(Keep)
    for I in 1..2
        P := New(TNode(FValue := I * 10))
        L := Link(P)
        PutLn(Value(L).FValue)
    ;
    PutLn(Value(L).FValue)
;
