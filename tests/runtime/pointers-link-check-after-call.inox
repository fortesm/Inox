== Safe pointers (CANON-25, safe-pointers-followups 1.3): a call between two
== uses of a Link may free its object (here by replacing the owner through
== ref mut), so the second use is checked, and traps.
Type
    TPoint Struct
        FX Integer := 0
    ;
    TBox Struct
        FPoint Own<TPoint>
    ;

Replace(ref mut P Own<TPoint>) :
    P := New(TPoint(FX := 2))
;

Main :
    P := New(TPoint(FX := 1))
    L := Link(P)
    PutLn("before ", L.FX)
    Replace(P)
    PutLn("after ", L.FX)
;
