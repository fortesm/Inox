== CANON-25: the routine frees the object its ref mut parameter reaches, then writes the parameter; the write stops the program, never reaching the freed object (reference-parameter-validity).
Type
    TNode Struct
        FV Integer := 1
    ;
    THolder Struct
        FChild Own<TNode>
    ;

State
    H THolder := THolder(FChild := New(TNode))
    K THolder := THolder(FChild := New(TNode))
;

Replace(ref mut X Integer) :
    H.FChild := New(TNode)
    K.FChild := New(TNode)
    X := 10
;

Main :
    Replace(H.FChild.FV)
    PutLn(H.FChild.FV, " ", K.FChild.FV)
;
