== CANON-13 and CANON-9: a struct field may be a fixed array (bounds may name
== a Const). It has no implicit value (r3.82): a default Fill(Literal), or
== the array given in the construction; every index is checked, and copying
== the struct copies the array.
Const Size := 4

Type
    TBuffer Struct
        FData Array[1..Size] Byte := Fill(0)
        FCount Integer := 2
        FPoints Array[0..1] TPoint
    ;
    TPoint Struct
        FX Integer := 7
        FY Integer
    ;

Load(ref mut Data Array[1..Size] Byte, Value Byte) :
    for I in Low(Data)..High(Data)
        Data[I] := Value
    ;
;

Total(Buffer TBuffer) Integer :
    Sum := 0
    for I in 1..Size
        Sum += Integer(Buffer.FData[I])
    ;
    Return Sum
;

Main :
    Origin TPoint
    B := TBuffer(FPoints := Fill(Origin))
    B.FData[2] := 200
    C TBuffer := B
    C.FData[2] := 1
    PutLn(B.FData[2], " ", C.FData[2], " ", B.FCount, " ", B.FPoints[1].FX)
    B.FPoints[0].FY := 3
    PutLn(B.FPoints[0].FY, " ", Low(B.FData), " ", High(B.FData), " ", Length(B.FData))
    Load(B.FData, 10)
    PutLn(Total(B))
    with B
        .FData[4] := 50
    ;
    PutLn(Total(B))
;
