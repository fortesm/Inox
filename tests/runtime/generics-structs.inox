== CANON-8 (r3.77): generic structs. `TPair<K, V> Struct` is a template; each
== list of types makes a struct of its own (TPair<String, Int64>). The types
== come from the written type, from the target of a construction, or from
== the values of the fields. Nested instances, an array field of T, a field
== default, arrays of instances, a State of an instance, generic routines
== over generic structs, and an owner of T (moved, never copied).
Type
    TPair<K, V> Struct
        FKey K
        FValue V
    ;
    TBox<T> Struct
        FItems Array[1..3] T
        FCount Integer := 0
    ;
    TNode Struct
        FValue Integer := 0
    ;
    THolder<T> Struct
        FItem Own<T>
        FLabel String := "holder"
    ;

State
    Last TPair<String, Integer> := TPair(FKey := "none", FValue := 0)
;

KeyOf<K, V>(P TPair<K, V>) K :
    Return P.FKey
;

Flip<K, V>(P TPair<K, V>) TPair<V, K> :
    Return TPair(FKey := P.FValue, FValue := P.FKey)
;

Keep<T>(P Own<T>) THolder<T> :
    Return THolder(FItem := Move(P))
;

Add<T>(ref mut B TBox<T>, X T) :
    B.FCount += 1
    B.FItems[B.FCount] := X
;

Main :
    P TPair<String, Integer> := TPair(FKey := "one", FValue := 1)
    Q := TPair(FKey := 2.5, FValue := True)
    PutLn(P.FKey, " ", P.FValue, " ", Q.FKey, " ", Q.FValue)
    N := TPair(FKey := "outer", FValue := TPair(FKey := 7, FValue := "inner"))
    PutLn(N.FKey, " ", N.FValue.FKey, " ", N.FValue.FValue)
    F := Flip(P)
    PutLn(F.FKey, " ", F.FValue, " ", KeyOf(P), " ", KeyOf(F))
    Words TBox<String> := TBox(FItems := Fill(""))
    Add(Words, "red")
    Add(Words, "green")
    PutLn(Words.FCount, " ", Words.FItems[1], " ", Words.FItems[2], " [", Words.FItems[3], "]")
    Table Array[1..2] TPair<String, Integer> := Fill(P)
    Table[1] := P
    Table[2] := TPair(FKey := "two", FValue := 2)
    for I in 1..2
        Put(Table[I].FKey, "=", Table[I].FValue, " ")
    ;
    PutLn("")
    Last := Table[2]
    PutLn(Last.FKey)
    H := Keep(New(TNode(FValue := 42)))
    PutLn(H.FItem.FValue, " ", H.FLabel)
;
