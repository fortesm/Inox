== r3.87 (CANON-2): != is inequality, the same operator as #, for every type
== that # compares; negation stays the word not.
Type
    TSuit (Club, Heart)

Main :
    A := 1
    B := 2
    PutLn(A != B, " ", A # B, " ", A != 1, " ", "x" != "y", " ", 'a' != 'a', " ", Heart != Club, " ", 1.5 != 1.5)
    if A != B and not (A = B)
        PutLn("different")
    ;
    while A != B
        A += 1
    ;
    PutLn(A)
;
