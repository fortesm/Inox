== r3.99: a line break only ends a complete line (as in Ruby), so a type
== name may stand alone on its line and its header follow on the next.
Type
    TBeing Struct Public
        FAlive Bool := True
    ;
    TPerson
        Struct(TBeing) Public
        FTag String := "t"
    Public
        FName String := "Ana"
    ;
    TPlain
        Struct
        FValue Integer := 7
    ;
    TDigit
        Range 0..9
    TColor
        (Red, Green, Blue)
    TSize
        Enum
        Small
        Large
    ;

Main :
    P TPerson
    Q TPlain
    D TDigit := 9
    PutLn(P.FName + " " + P.FTag)
    PutLn(P.FAlive)
    PutLn(Q.FValue)
    PutLn(D)
    PutLn(Green)
    PutLn(Large)
;
