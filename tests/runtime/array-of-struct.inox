== CANON-13: array elements may be structs; each element starts at the
== struct defaults; element fields and methods are reachable.
Type
    TPoint Struct
        FX Integer := -1
        FY Integer
    ;

TPoint.Move(Self mut, D Integer) :
    Self.FX := Self.FX + D
;

Make(X Integer) TPoint :
    Return TPoint(FX := X, FY := X)
;

Total(Points Array[1..3] TPoint) Integer :
    Sum := 0
    for I in 1..3
        Sum += Points[I].FX + Points[I].FY
    ;
    Return Sum
;

Main :
    A Array[1..3] TPoint
    PutLn(A[1].FX, " ", A[3].FX, " ", A[2].FY)
    A[2].FX := 5
    A[3] := Make(4)
    A[1].Move(11)
    PutLn(A[1].FX, " ", A[2].FX, " ", A[3].FY)
    PutLn(Total(A))
    M Array[1..2, 1..2] TPoint
    M[2, 2].FY := 8
    PutLn(M[1, 1].FX, " ", M[2, 2].FX, " ", M[2, 2].FY)
;
