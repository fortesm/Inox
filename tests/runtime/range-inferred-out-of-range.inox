== CANON-13 (range-types): `N := D * 2` declares a TMeters; a later result
== outside it stops the program with "value out of range" (kind 11).
Type
    TMeters Range 0..1000

Main :
    D TMeters := 300
    N := D * 2
    PutLn(N)
    N := D * 4
    PutLn(N)
;
