== v3.21: if/elif/else inside loop bodies (former backend gaps loop-if-elif and
== loop-if-else).
Module Runtime.LoopIfElifElse

Main :
    for I in 1..5
        if I = 1
            PutLn("one")
        elif I = 2
            PutLn("two")
        elif I < 5
            PutLn("few ", I)
        else
            PutLn("many")
        ;
    ;
    W Integer := 0
    while W < 2
        if W = 0
            PutLn("even")
        else
            PutLn("odd")
        ;
        W := W + 1
    ;
;
