== CANON-9: a struct field may be a struct declared anywhere in the Type
== section; field paths, methods and ref mut reach nested fields.
Module Runtime.StructNested

Type
    TLine Struct
        FA TPoint
        FB TPoint
        FVisible Bool := true
    ;
    TPoint Struct
        FX Integer := 1
        FY Integer
    ;

TPoint.Move(Self mut, D Integer) :
    Self.FX := Self.FX + D
;

TPoint.Sum(Self) Integer :
    Return Self.FX + Self.FY
;

Bump(ref mut P TPoint) :
    P.FY := P.FY + 100
;

Main :
    L TLine
    PutLn(L.FA.FX, " ", L.FB.FY, " ", L.FVisible)
    L.FB := TPoint(FX := 5, FY := 6)
    L.FB.FX := 7
    L.FA.Move(2)
    Bump(L.FB)
    PutLn(L.FA.FX, " ", L.FB.FX, " ", L.FB.FY, " ", L.FB.Sum)
    Copy TLine := L
    Copy.FA.FX := 0
    PutLn(L.FA.FX, " ", Copy.FA.FX)
    with L
        .FA.FY := 42
    ;
    PutLn(L.FA.FY)
;
