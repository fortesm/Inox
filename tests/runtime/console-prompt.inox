== CANON-17 (r3.88): the console belongs to libinoxrt. A prompt written with
== Put comes before the line read after it, and text in UTF-8 goes through
== unchanged, in and out.
Main :
    Name String := ""
    Put("Name? ")
    GetLn(Name)
    PutLn("Hello, ", Name, "!")
    Put("Age? ")
    Age Integer := 0
    GetLn(Age)
    PutLn(Name, " is ", Age, ", ", Age > 17, ", ", 1.5)
;
