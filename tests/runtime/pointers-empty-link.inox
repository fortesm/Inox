== A Link is born empty; using it traps (kind 16).
Module Runtime.PointersEmptyLink

Type
    TNo Struct
        FValor Integer := 0
    ;

Main :
    L Link<TNo>
    PutLn("vazio vivo: ", Alive(L))
    L.FValor := 1
;
