== r3.92 (D1-D3): Std.DateTime. A TDateTime counts microseconds from
== 0001-01-01 (proleptic Gregorian), a TDate days; both are Ranges, compared
== with the usual operators. 0001-01-01 was a Monday.
Use Std.DateTime

Main :
    T := EncodeDateTime(2026, 10, 22, 5, 57, 30)
    PutLn(YearOf(T), "-", MonthOf(T), "-", DayOf(T), " ", HourOf(T), ":", MinuteOf(T), ":", SecondOf(T), " ", DayOfWeek(T))
    Y Integer := 0
    M Integer := 0
    D Integer := 0
    DecodeDate(AddDays(T, 70), Y, M, D)
    PutLn(Y, "-", M, "-", D, " ", DaysBetween(T, AddDays(T, 70)), " ", DaysBetween(AddDays(T, 70), T))
    PutLn(IsLeapYear(2024), " ", IsLeapYear(1900), " ", IsLeapYear(2000), " ", DaysInMonth(2024, 2), " ",
          DaysInMonth(2023, 2), " ", DaysInMonth(2026, 4))
    First := EncodeDate(1, 1, 1)
    Last := EncodeDate(9999, 12, 31)
    PutLn(First, " ", Last, " ", DayOfWeek(DateTimeOf(First)), " ", DayOfWeek(DateTimeOf(Last)))
    PutLn(EncodeDate(2000, 3, 1) - EncodeDate(2000, 2, 28), " ", EncodeDate(1970, 1, 1), " ",
          DateOf(T) = EncodeDate(2026, 10, 22))
    U := AddSeconds(T, 45)
    PutLn(U > T, " ", MinuteOf(U), ":", SecondOf(U), " ", MicroSecondOf(T + 7), " ", T = EncodeDateTime(2026, 10, 22, 5, 57, 30))
    Winter := EncodeDateTime(2026, 1, 15, 12, 0, 0)
    PutLn(ToUTC(ToLocal(Winter)) = Winter, " ", Now > DateTimeOf(EncodeDate(2026, 1, 1)), " ", NowUTC > Winter)
;
