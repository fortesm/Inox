Module Runtime.ForSequentialMixedDirections

Main :
    for I in 1..3
        Put(I, " ")
    ;
    for I in 3..1
        Put(I, " ")
    ;
    for I in 2..2
        Put(I, " ")
    ;
    PutLn("")
;
