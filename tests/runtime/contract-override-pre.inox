== CANON-24: an Override's precondition is the inherited one or else its own
== pre else (Eiffel's require else).
Type
    TPessoa Struct
        FIdade Integer := 0
    ;
    TCliente Struct (TPessoa)
        FLimite Integer := 0
    ;

TPessoa.Aniversario(Self mut, Anos Integer) :
    pre Anos > 0 and Anos < 5
    Self.FIdade += Anos
;

TCliente.Aniversario(Self mut, Anos Integer) Override :
    pre else Anos >= 5 and Anos < 100
    Self.TPessoa.FIdade += Anos
;

Main :
    C TCliente
    C.Aniversario(3)
    C.Aniversario(50)
    PutLn(C.FIdade)
    C.Aniversario(200)
;
