== CANON-24: an Override's precondition is the inherited one or else its own
== pre else (Eiffel's require else).
Type
    TPerson Struct
        FAge Integer := 0
    ;
    TClient Struct (TPerson)
        FLimit Integer := 0
    ;

TPerson.Birthday(Self mut, Years Integer) :
    pre Years > 0 and Years < 5
    Self.FAge += Years
;

TClient.Birthday(Self mut, Years Integer) Override :
    pre else Years >= 5 and Years < 100
    Self.TPerson.FAge += Years
;

Main :
    C TClient
    C.Birthday(3)
    C.Birthday(50)
    PutLn(C.FAge)
    C.Birthday(200)
;
