== Safe pointers: arrays of optional owners, owned arrays, owned Strings and
== Integers (with a method), State owners and Links to State, with on an owner.
Const Size := 3

Type
    TNode Struct
        FValue Integer := 0
    ;

State
    Global Option<Own<TNode>>
    Counter Integer := 0
;

Integer.Twice(Self) Integer :
    Return Self * 2
;

Main :
    == An array of optional owners.
    A Array[1..Size] Option<Own<TNode>> := Fill(None)
    A[1] := New(TNode(FValue := 11))
    A[3] := New(TNode(FValue := 33))
    for I in 1..Size
        L := Link(A[I])
        if Alive(L)
            PutLn(I, ": ", L.FValue)
        else
            PutLn(I, ": empty")
        ;
    ;
    == An owned array, indexed and linked through its owner.
    T Array[1..Size] Integer := Fill(0)
    T[2] := 20
    Arr := New(T)
    Arr[1] := 10
    E := Link(Arr[2])
    Value(E) := Value(E) + 1
    PutLn("arr ", Arr[1], " ", Arr[2], " ", Arr[3])
    == An owned String and an owned Integer with a method.
    S := New("text")
    N := New(21)
    PutLn(Value(S), " ", Value(N).Twice, " ", N.Twice)
    == State: an owner and a Link to a State variable.
    Global := New(TNode(FValue := 7))
    LC := Link(Counter)
    Value(LC) := 99
    PutLn("global ", Link(Global).FValue, ", counter ", Counter)
    == with on an owner.
    P := New(TNode(FValue := 1))
    with P
        .FValue := .FValue + 1
    ;
    PutLn("with ", P.FValue)
;
