== Change uint64: Get reads 0..18446744073709551615 into a UInt64, PutLn and
== WriteLn print it unsigned, and a file keeps it.
Use Std.IOUtils

Main :
    U UInt64 := 0
    V UInteger := 0
    Get(U, V)
    PutLn(U, " ", V)
    F := Create("uint64-io.txt")
    WriteLn(F, U, " ", V + 1)
    Close(F)
    R := OpenRead("uint64-io.txt")
    PutLn(ReadLn(R))
    Close(R)
    DeleteFile("uint64-io.txt")
;
