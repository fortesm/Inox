== Safe pointers (CANON-25, safe-pointers-followups 1.3): a Link checked in a
== protected region is checked again when Retry runs the region again: the
== handler freed its object, so the use traps.
Type
    TInner Struct
        FValue Integer := 0
    ;

Main :
    P := New(TInner(FValue := 1))
    H := Link(P)
    Tries := 0
    try
        Tries := Tries + 1
        PutLn("try ", Tries)
        PutLn("value ", H.FValue)
        if Tries = 1
            Raise RangeError
        ;
    except
        On RangeError
            Free(P)
            P := New(TInner(FValue := 2))
            Retry(1)
        ;
    ;
;
