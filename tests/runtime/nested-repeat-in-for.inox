== v3.21: a repeat loop nested in a for loop; until exits only the repeat.
Module Runtime.NestedRepeatInFor

Main :
    for I in 1..2
        R Integer := 0
        repeat
            R := R + 1
            PutLn(I * 10 + R)
            until R = 2
        ;
    ;
;
