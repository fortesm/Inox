== CANON-24 (safe-pointers-followups 3.1): a field written through a Link
== keeps the invariant of the struct the Link points at.
Type
    TBox Struct
        FValue Integer := 1
        invariant Self.FValue > 0, "the value is positive"
    ;
    THolder Struct
        FBox TBox
    ;
    TOuter Struct (TBox)
        FName String := ""
    ;
    TPair<T> Struct
        FLow T
        FHigh T
        invariant Self.FLow <= Self.FHigh, "the low bound is not above the high one"
    ;

Main :
    B := TBox(FValue := 2)
    L := Link(B)
    Value(L).FValue := 3
    PutLn(B.FValue)
    Value(L).FValue := -1
    PutLn("not reached ", B.FValue)
;
