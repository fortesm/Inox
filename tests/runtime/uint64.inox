== Change uint64 (CANON-8): UInt64 values above Int64.Max in locals, State,
== a Const, struct fields with defaults, array elements, parameters and
== results; every operator (+ - * div mod ^ shl shr bitand bitor bitxor
== bitnot and the comparisons) compared and computed unsigned; IIf; checked
== conversions in both directions; case with ranges and else; for loops up
== and down to 2^64-1; a generic routine with a UInt64 and literals.
Type
    TCounter Struct
        FTotal UInt64 := 18446744073709551615
        FSmall UInteger := 0
    ;

State
    Seed UInt64 := 12345678901234567890
;

Const Big := UInt64(18446744073709551615)

Twice(X UInt64) UInt64 :
    Return X * 2
;

Max<T>(A T, B T) T :
    Return IIf(A > B, A, B)
;

Main :
    U UInt64 := 18446744073709551615
    H UInt64 := 9223372036854775808
    PutLn(U, " ", H, " ", Big, " ", Seed, " ", $FFFFFFFFFFFFFFFF = U)
    P UInt64 := 9223372036854775807
    P += 1
    PutLn(P, " ", P > 9223372036854775807)
    PutLn(U - 1, " ", H + 5, " ", H * 1, " ", Twice(H - 1))
    PutLn(U div 10, " ", U mod 10, " ", U div H, " ", U mod H)
    PutLn(H shl 0, " ", H shr 63, " ", U shr 1, " ", U bitand $FF, " ", H bitor 1, " ", U bitxor H)
    PutLn(bitnot U, " ", bitnot H, " ", UInt64(2) ^ 63, " ", UInt64(10) ^ 19)
    PutLn(U > H, " ", H < U, " ", H >= 1, " ", U = 18446744073709551615, " ", H # U, " ", 0 < H)
    PutLn(IIf(U > H, U, 0), " ", IIf(H > U, 7, H))
    C TCounter
    C.FSmall += 3
    PutLn(C.FTotal, " ", C.FSmall)
    A Array[1..3] UInt64
    A[1] := U
    A[2] := H
    A[3] := A[1] - A[2]
    PutLn(A[3], " ", A[2] + A[3])
    I := Integer(H - 1)
    N := Natural(UInt64(5))
    B := Byte(UInt64(200))
    V := UInt64(I)
    PutLn(I, " ", N, " ", B, " ", V, " ", UInt64(B) + 1)
    case U
        0..9
            PutLn("small")
        9223372036854775808..18446744073709551614
            PutLn("high")
        18446744073709551615
            PutLn("max")
        else
            PutLn("other")
    ;
    Count := 0
    for K in 18446744073709551610..U
        Count += 1
    ;
    for K in U..18446744073709551600 step 5
        Put(K mod 100, " ")
    ;
    PutLn(Count)
    PutLn(Max(H, 5), " ", Max(H, 18446744073709551615), " ", Max(5, H))
    Seed := Seed + 1
    PutLn(Seed, " ", Seed > H)
;
