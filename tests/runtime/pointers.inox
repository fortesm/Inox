== Safe pointers (change safe-pointers): Own, Option<Own>, Link, New, Free,
== Move, Value, Alive, Same, None; leak-checked by string_leak_check.
Type
    TNode Struct
        FValue Integer := 0
        FName String := ""
        FNext Option<Own<TNode>>
    ;
    TPasta Struct
        FName String := ""
        FParent Link<TPasta>
        FChild Option<Own<TPasta>>
    ;
    TCrate Struct
        FContent Own<TNode>
        FLabel String := "box"
    ;
    TPoint Struct
        FX Integer := 0
        FY Integer := 0
    ;

TPoint.Relocate(Self mut, DX Integer) :
    Self.FX += DX
;

TPoint.Sum(Self) Integer :
    Return Self.FX + Self.FY
;

NewList(N Integer) Own<TNode> :
    List := New(TNode(FValue := 1, FName := "one"))
    Current := Link(List)
    for I in 2..N
        Current.FNext := New(TNode(FValue := I))
        Current := Link(Current.FNext)
    ;
    Return Move(List)
;

Add(Start Link<TNode>) Integer :
    Total := 0
    N := Start
    while Alive(N)
        Total += N.FValue
        N := Link(N.FNext)
    ;
    Return Total
;

CountUp(List Own<TNode>) Integer :
    Return Add(Link(List))
;

Leak Link<Integer> :
    X Integer := 42
    Return Link(X)
;

NewBox(Amount Integer) TCrate :
    Return TCrate(FContent := New(TNode(FValue := Amount, FName := "inside")))
;

Main :
    == A list built by a routine, owned by Main.
    L := NewList(4)
    PutLn("sum ", Add(Link(L)), ", first ", L.FName, " ", L.FValue)

    == A Link to a variable, written through it.
    X Integer := 10
    Spy := Link(X)
    Value(Spy) := 7
    PutLn("X ", X, ", spy ", Value(Spy), ", same ", Same(Spy, Link(X)))

    == A Link to a field and to an element.
    Pt TPoint
    LX := Link(Pt.FX)
    Value(LX) := 5
    Pt.Relocate(1)
    Table Array[1..3] Integer := Fill(0)
    LE := Link(Table[2])
    Value(LE) := 9
    PutLn("point ", Pt.FX, ", sum ", Pt.Sum, ", table ", Table[2])

    == Methods through an owner and a Link.
    P := New(TPoint(FX := 1, FY := 2))
    P.Relocate(10)
    LP := Link(P)
    LP.Relocate(100)
    PutLn("P ", P.FX, " ", LP.Sum, " ", Value(P).FY)

    == Free: every Link to the object dies.
    Free(P)
    PutLn("alive after Free: ", Alive(LP))
    P := New(TPoint(FX := 3))
    PutLn("again: ", P.FX, ", the old Link stays dead: ", Alive(LP))

    == A Link that outlives its variable is detected.
    H := Leak
    PutLn("leaked alive: ", Alive(H))

    == Move: the owner changes hands; to a routine, which frees it.
    Q := Move(L)
    PutLn("moved ", Q.FValue)
    PutLn("counted ", CountUp(Move(Q)))

    == An Option field: None frees the child; Free empties it.
    Root := New(TPasta(FName := "root"))
    Root.FChild := New(TPasta(FName := "docs", FParent := Link(Root)))
    Child := Link(Root.FChild)
    PutLn("child ", Child.FName, ", parent ", Child.FParent.FName, ", alive ", Alive(Child))
    Root.FChild := None
    PutLn("after None: ", Alive(Child), " ", Alive(Root.FChild))
    Root.FChild := New(TPasta(FName := "photos"))
    Free(Root.FChild)
    PutLn("after Free: ", Alive(Root.FChild))

    == A value that holds an owner moves like one.
    C := NewBox(8)
    D := Move(C)
    PutLn(D.FLabel, " ", D.FContent.FValue, " ", D.FContent.FName)

    == Value: a copy of the whole object; replacing it keeps its Links.
    V := New(TPoint(FX := 4, FY := 6))
    LV := Link(V)
    Duplicate := Value(V)
    Value(V) := TPoint(FX := 40, FY := 60)
    PutLn("copy ", Duplicate.FX, ", new ", LV.FX, " ", Alive(LV))

    == A long list is freed without recursion.
    LongText := NewList(100000)
    PutLn("longtext ", Add(Link(LongText)))
;
