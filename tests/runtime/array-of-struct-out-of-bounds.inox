== CANON-13: the index of an array of structs is checked.
Module Runtime.ArrayOfStructOutOfBounds

Type
    TPoint Struct
        FX Integer
    ;

Main :
    A Array[1..3] TPoint
    I Integer := 3
    I += 1
    A[I].FX := 1
    PutLn(A[1].FX)
;
