Module Runtime.ShiftValid

Main :
    A Integer := 1
    B Integer := 62
    PutLn(A shl B)
    C Integer := -16
    D Integer := 2
    PutLn(C shr D)
    E Integer := 63
    PutLn(A shl E)
;
