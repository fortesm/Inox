Main :
    A Integer := 1
    B Integer := 62
    PutLn(A shl B)
    C Integer := -16
    D Integer := 2
    PutLn(C shr D)
    == r3.97: 1 shl 63 leaves Int64 (tests/runtime/shl-overflow.inox); -1 shl 63
    == is Int64.Min, a valid product.
    E Integer := 63
    M Integer := -1
    PutLn(M shl E)
;
