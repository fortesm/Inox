== CANON-13 Q5: Succ past the last literal stops the program with "value
== out of range".
Type
    TSuit (Club, Diamond, Heart, Spade)

Main :
    S := Heart
    S := Succ(S)
    PutLn(S)
    PutLn(Succ(S))
;
