== r3.93: a discard keeps every obligation of the call: its precondition is
== checked, and a broken one stops the program.
Metade(N Integer) Integer :
    pre N mod 2 = 0, "N is even"
    Return N / 2
;

Main :
    _ := Metade(4)
    PutLn("4 is even")
    _ := Metade(3)
    PutLn("never")
;
