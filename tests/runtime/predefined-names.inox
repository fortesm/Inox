== CANON-2 (r3.74): True, False, Exit and the bit operators are predefined
== names, not reserved words: they keep their meaning in any spelling and
== may name fields and methods, never a variable, a parameter, a routine, a
== type or a Const. Main is an ordinary name. A case ends with `else`.
Type
    TDoor Struct
        Exit Integer := 6
        Main Bool := TRUE
        True String := "field"
    ;

TDoor.BitAnd(Self, Mask Integer) Integer :
    Return Self.Exit bitand Mask
;

TDoor.OpenIt(Self mut) :
    if Self.Main
        Self.Exit += 1
        Exit
    ;
    Self.Exit := 0
;

Classify(N Integer) String :
    case N
        0 Return "zero"
        1..9 Return "small"
        else Return "large"
    ;
;

Main :
    P TDoor
    PutLn(P.Exit, " ", P.Main, " ", P.True)
    P.OpenIt
    PutLn(P.Exit, " ", P.BitAnd(3))
    PutLn(5 BITOR 2, " ", 6 BitXor 3, " ", bitnot 0)
    PutLn(true, " ", False, " ", not FALSE)
    PutLn(Classify(0), " ", Classify(7), " ", Classify(42))
;
