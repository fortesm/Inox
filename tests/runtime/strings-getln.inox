== CANON-17 (v3.50): GetLn(S) reads one line into a String, without the line
== break (a CR before it is dropped too); at end of input S is "". Lines read
== at run time are heap Strings, so this test moves them through every kind of
== slot; the sanitizer gate runs it with leak detection.
Module Runtime.StringsGetLn

Type
    TPerson Struct
        FName String
        FAge Integer := 0
    ;

State :
    Last String := ""
;

Keep(Text String) String :
    Return Text
;

Pick(A String, B String, First Bool) String :
    if First
        Return A
    ;
    Return B
;

Remember(Text String) :
    Last := Text
;

Main :
    Name String := ""
    GetLn(Name)
    PutLn("[", Name, "]")
    Copy := Name
    GetLn(Name)
    PutLn(Copy, " ", Name, " ", Copy = Name, " ", Keep(Copy) = Copy)

    P TPerson
    P.FName := Keep(Name)
    Q := P
    P.FName := Pick(Copy, Name, true)
    PutLn(P.FName, " ", Q.FName)

    Words Array[1..3] String
    for I in 1..3
        Line String := ""
        GetLn(Line)
        Words[I] := Line
        Remember(Line)
    ;
    Again := Words
    Words[2] := "?"
    PutLn(Words[1], Words[2], Words[3], " ", Again[2], " ", Last)

    GetLn(Last)
    PutLn("crlf [", Last, "]")
    GetLn(Name)
    PutLn("empty [", Name, "]")
    GetLn(Name)
    PutLn("last [", Name, "]")
    GetLn(Name)
    PutLn("eof [", Name, "]")
;
