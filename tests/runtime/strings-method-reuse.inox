== CANON-9 method reuse with Strings in the parts (OpenSpec change
== method-reuse): arrays, State, by-value and ref mut parameters, results
== and an exception keep every String owned once (string_leak_check runs
== this program). A field of `Self mut` is a writable place for ref mut.
Type
    TEndereco Struct
        FCidade String := ""
    ;
    TPessoa Struct (TEndereco)
        FNome String := ""
    ;
    TAssinatura Struct (TPessoa)
        FPlano String := ""
    ;

State
    Global TAssinatura
;

TEndereco.Mudar(Self mut, Cidade String) :
    Self.FCidade := Cidade
;

TPessoa.UpdateNome(Self mut, Nome String) :
    Self.FNome := Nome
;

TPessoa.Describe(Self) String :
    Return Self.FNome
;

SetName(ref mut Field String, Value String) :
    Field := Value
;

TPessoa.Rename(Self mut, Nome String) :
    SetName(Self.FNome, Nome)
;

ShowAll(P TAssinatura) :
    PutLn(P.Describe, " em ", P.FCidade)
;

Preencher(ref mut P TAssinatura, Nome String) :
    P.UpdateNome(Nome)
    P.Mudar("Olinda")
;

Make(Nome String) TAssinatura :
    R TAssinatura
    R.Rename(Nome)
    Return R
;

Main :
    Vazia TAssinatura
    L Array[1..2] TAssinatura := Fill(Vazia)
    L[1].UpdateNome("Um")
    L[2].Rename("Dois")
    L[2].Mudar("Recife")
    for I in 1..2
        ShowAll(L[I])
    ;
    Global.UpdateNome("Global")
    Global.Mudar("Natal")
    ShowAll(Global)
    X TAssinatura
    Preencher(X, "Preenchido")
    ShowAll(X)
    Y := Make("Feito")
    ShowAll(Y)
    try
        Y.Rename("Antes")
        Raise RangeError
    except
        On RangeError
            PutLn("capturada: ", Y.FNome)
        ;
    ;
;
