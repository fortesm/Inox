== CANON-9 method reuse with Strings in the parts (OpenSpec change
== method-reuse): arrays, State, by-value and ref mut parameters, results
== and an exception keep every String owned once (string_leak_check runs
== this program). A field of `Self mut` is a writable place for ref mut.
Type
    TAddress Struct
        FCity String := ""
    ;
    TPerson Struct (TAddress)
        FName String := ""
    ;
    TSubscription Struct (TPerson)
        FPlan String := ""
    ;

State
    Global TSubscription
;

TAddress.Change(Self mut, City String) :
    Self.FCity := City
;

TPerson.UpdateName(Self mut, Name String) :
    Self.FName := Name
;

TPerson.Describe(Self) String :
    Return Self.FName
;

SetName(ref mut Field String, Value String) :
    Field := Value
;

TPerson.Rename(Self mut, Name String) :
    SetName(Self.FName, Name)
;

ShowAll(P TSubscription) :
    PutLn(P.Describe, " in ", P.FCity)
;

FillIn(ref mut P TSubscription, Name String) :
    P.UpdateName(Name)
    P.Change("Olinda")
;

Make(Name String) TSubscription :
    R TSubscription
    R.Rename(Name)
    Return R
;

Main :
    EmptyOne TSubscription
    L Array[1..2] TSubscription := Fill(EmptyOne)
    L[1].UpdateName("Um")
    L[2].Rename("Two")
    L[2].Change("Recife")
    for I in 1..2
        ShowAll(L[I])
    ;
    Global.UpdateName("Global")
    Global.Change("Natal")
    ShowAll(Global)
    X TSubscription
    FillIn(X, "Filled")
    ShowAll(X)
    Y := Make("Done")
    ShowAll(Y)
    try
        Y.Rename("Before")
        Raise RangeError
    except
        On RangeError
            PutLn("caught: ", Y.FName)
        ;
    ;
;
