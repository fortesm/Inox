== CANON-5: R raises before the target is reached; the element keeps its value and R's effects stay, with no rollback (assignment-evaluation-order).
State
    I Integer := 1
    Steps Integer := 0
    V Array[1..3] String := Fill("")
;

Fail String :
    Steps += 1
    Raise RangeError
    Return "never"
;

Main :
    V[1] := "kept"
    try
        V[I] := Fail
    except
        On RangeError
            PutLn("caught ", Steps)
        ;
    ;
    PutLn(V[1])
;
