== CANON-24 (kept by F5): nested loops each check their own contracts, in
== order, the inner ones at each inner iteration; each variant is its own.
Seen(What String, Value Integer) Bool :
    PutLn(What, " ", Value)
    Return True
;

Measure(Value Integer) Integer :
    PutLn("variant ", Value)
    Return Value
;

Main :
    I := 0
    while I < 2
        invariant Seen("outer", I)
        variant Measure(10 - I)
        J := 0
        while J < 2
            invariant Seen("inner", J)
            variant Measure(20 - J)
            for K in 1..2
                invariant Seen("for", K)
                PutLn("body ", I, J, K)
            ;
            J += 1
        ;
        I += 1
    ;
;
