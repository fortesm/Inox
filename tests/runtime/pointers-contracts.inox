== Safe pointers and contracts (CANON-24): a pre reads an owner the routine
== takes, a pos reads what it held through old, and a Link parameter.
Type
    TNode Struct
        FValue Integer := 0
    ;

Add(P Own<TNode>, L Link<TNode>) Integer :
    pre P.FValue > 0, "a positive amount"
    pre Alive(L), "the link is alive"
    pos Result = old P.FValue + old L.FValue
    Return P.FValue + L.FValue
;

Main :
    A := New(TNode(FValue := 2))
    B := New(TNode(FValue := 3))
    PutLn(Add(Move(A), Link(B)))
    PutLn(Add(New(TNode(FValue := 10)), Link(B)))
;
