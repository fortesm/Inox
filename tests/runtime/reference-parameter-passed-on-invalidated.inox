== CANON-25: a ref mut parameter passed on to another routine keeps the check of the caller's object (reference-parameter-validity).
Type
    TNode Struct
        FV Integer := 1
    ;
    THolder Struct
        FChild Own<TNode>
    ;

State
    H THolder := THolder(FChild := New(TNode))
    K THolder := THolder(FChild := New(TNode))
;

Replace(ref mut X Integer) :
    H.FChild := New(TNode)
    K.FChild := New(TNode)
    X := 10
;

PassOn(ref mut Y Integer) :
    Replace(Y)
;

Main :
    PassOn(H.FChild.FV)
    PutLn(H.FChild.FV, " ", K.FChild.FV)
;
