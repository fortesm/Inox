== r3.89 (C3): Std.Strings classifies a Char by Unicode (Unicode 15.1, never a
== locale): IsLetter (L*), IsDigit (Nd), IsSpace (White_Space), IsUpper (Lu),
== IsLower (Ll), IsPunctuation (P*); UpperCase(C) and LowerCase(C) map one
== character to one, as the String functions do.
Use Std.Strings

Show(C Char) :
    PutLn(C, " ", IsLetter(C), " ", IsDigit(C), " ", IsSpace(C), " ", IsUpper(C), " ", IsLower(C), " ",
          IsPunctuation(C), " ", UpperCase(C), LowerCase(C))
;

Main :
    Text String := "aZ7 !éΩ٣日_-ß"
    for I in 1..Length(Text)
        Show(CharAt(Text, I))
    ;
    Show(Char(160))
    PutLn(UpperCase("abc"), " ", LowerCase('Q'), " ", UpperCase('ω'))
;
