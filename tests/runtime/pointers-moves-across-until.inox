== Safe pointers (CANON-25 rule 3): a true `until` takes its owners out of
== the repeat; assigned again before it, they are usable after it.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    I Integer := 0
    repeat
        I := I + 1
        Free(P)
        P := New(TNode(FValue := I))
        until I = 3
    ;
    PutLn("after until ", P.FValue)

    == until inside a while inside the repeat
    I := 0
    repeat
        while True
            I := I + 1
            Q := Move(P)
            P := Move(Q)
            until I > 1
            leave
        ;
    ;
    PutLn("until in while ", P.FValue, " ", I)

    == an owner declared in the body, given away before until
    I := 0
    repeat
        I := I + 1
        R := New(TNode(FValue := I * 10))
        Free(R)
        until I = 2
    ;
    PutLn("body owner ", I)
;
