== CANON-24 (safe-pointers-followups 3.1): a struct that reuses another
== keeps the reused part's invariant when written through an Own.
Type
    TBox Struct
        FValue Integer := 1
        invariant Self.FValue > 0, "the value is positive"
    ;
    THolder Struct
        FBox TBox
    ;
    TOuter Struct (TBox)
        FName String := ""
    ;
    TPair<T> Struct
        FLow T
        FHigh T
        invariant Self.FLow <= Self.FHigh, "the low bound is not above the high one"
    ;

Main :
    P := New(TOuter(TBox := TBox(FValue := 2), FName := "a"))
    P.FValue := 7
    PutLn(P.FValue, " ", P.FName)
    P.FValue := -7
    PutLn("not reached ", P.FValue)
;
