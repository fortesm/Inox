== Safe pointers (CANON-25, safe-pointers-followups 1.2 and 1.3): a local
== every Link to which stays in its block lives on the stack, with no
== generation block and no check; a local one Link may outlive keeps its
== generation block, and that Link is dead once the local is gone. The
== results are the same either way: what changes is where the local lives
== (tests/codegen/llvm-link-storage-smoke.inox).
Type
    TPoint Struct
        FX Integer := 0
        FY Integer := 0
    ;
    THolder Struct
        FLink Link<Integer>
    ;

State
    Kept Link<Integer>
;

TPoint.Shift(Self mut, D Integer) :
    Self.FX += D
;

TPoint.Total(Self) Integer :
    Return Self.FX + Self.FY
;

== Kept: written and read through Links in the local's own block, in
== nested blocks, a loop body, a protected region and its handler.
InBlock :
    P TPoint := TPoint(FX := 1, FY := 2)
    L := Link(P)
    L.FX := 10
    L.Shift(5)
    PutLn("kept ", P.FX, " ", L.Total, " ", Alive(L), " ", Same(L, Link(P)))
    A Array[1..3] Integer := Fill(0)
    E := Link(A[2])
    Value(E) := 7
    if A[2] = 7
        Inner := Link(A[3])
        Value(Inner) := Value(E) + 1
    ;
    PutLn("array ", A[1], " ", A[2], " ", A[3])
    Sum := 0
    for I in 1..3
        N Integer := I * 10
        R := Link(N)
        Value(R) := Value(R) + 1
        Sum += Value(R)
    ;
    PutLn("rounds ", Sum)
    try
        T Integer := 4
        LT := Link(T)
        Value(LT) := 40
        PutLn("try ", T)
        Raise RangeError
    except
        On RangeError
            C Integer := 1
            LC := Link(C)
            Value(LC) := Value(LC) + 1
            PutLn("handler ", C)
        ;
    ;
;

== Returned: the local gets a generation block, and the Link is dead.
Leak Link<Integer> :
    X Integer := 3
    Return Link(X)
;

== Into State, a field, an array element and an argument.
Store(L Link<Integer>) :
    Kept := L
;

Spread THolder :
    S Integer := 1
    Kept := Link(S)
    PutLn("state inside ", Alive(Kept), " ", Value(Kept))
    F Integer := 2
    H := THolder(FLink := Link(F))
    G Integer := 3
    Links Array[1..1] Link<Integer> := Fill(Link(G))
    PutLn("array inside ", Alive(Links[1]))
    Return H
;

Argument :
    Y Integer := 5
    Store(Link(Y))
    PutLn("argument inside ", Alive(Kept), " ", Value(Kept))
;

Main :
    InBlock
    PutLn("returned ", Alive(Leak))
    H := Spread
    PutLn("state after ", Alive(Kept), " field after ", Alive(H.FLink))
    Argument
    PutLn("argument after ", Alive(Kept))
    == A Link kept outside the loop sees each round's local die.
    Outer := Link(Kept)
    for I in 1..2
        Z Integer := I
        Outer := Link(Z)
        PutLn("round ", I, " ", Alive(Outer), " ", Value(Outer))
    ;
    PutLn("after the loop ", Alive(Outer))
;
