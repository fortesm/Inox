== CANON-25: an Option<Own> reached by a Link whose object the index replaces stops the program, never writing the object that reuses its block (assignment-evaluation-order).
Type
    TNode Struct
        FV Array[1..3] Integer := Fill(1)
    ;
    THolder Struct
        FChild Option<Own<TNode>>
    ;

State
    H THolder := THolder(FChild := New(TNode))
    K THolder := THolder(FChild := New(TNode))
;

ChangeOwner Integer :
    H.FChild := New(TNode)
    K.FChild := New(TNode)
    Return 2
;

Main :
    L := Link(H.FChild)
    if Alive(L)
        Value(L).FV[ChangeOwner] := 10
    ;
    M := Link(K.FChild)
    if Alive(M)
        PutLn(Value(M).FV[2])
    ;
;
