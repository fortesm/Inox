== r3.88: without `Use Std.Terminal` its routine names are free for the
== program's own routines.
Flush :
    PutLn("my flush")
;

ClearScreen(Lines Integer) :
    PutLn("clearing ", Lines)
;

Main :
    Flush
    ClearScreen(3)
;
