== Safe pointers (CANON-25, safe-pointers-followups 1.3): a Link checked by
== one statement is not checked again by the next only while nothing can free
== its object; Free between the two uses keeps the check, which traps.
Type
    TPoint Struct
        FX Integer := 0
    ;
    TBox Struct
        FPoint Own<TPoint>
    ;

Main :
    P := New(TPoint(FX := 1))
    L := Link(P)
    PutLn("before ", L.FX)
    PutLn("again ", L.FX)
    Free(P)
    PutLn("after ", L.FX)
;
