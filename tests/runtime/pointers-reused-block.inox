== A freed block reused by a new object of the same size: an old Link
== never matches it (the generation changed).
Module Runtime.PointersReusedBlock

Type
    TPeca Struct
        FPeso Integer := 0
    ;

Main :
    A := New(TPeca(FPeso := 1))
    Velha := Link(A)
    Free(A)
    B := New(TPeca(FPeso := 2))
    PutLn("novo ", B.FPeso, ", velha viva: ", Alive(Velha))
    PutLn(Velha.FPeso)
;
