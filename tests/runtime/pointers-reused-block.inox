== A freed block reused by a new object of the same size: an old Link
== never matches it (the generation changed).
Type
    TPiece Struct
        FWeight Integer := 0
    ;

Main :
    A := New(TPiece(FWeight := 1))
    Stale := Link(A)
    Free(A)
    B := New(TPiece(FWeight := 2))
    PutLn("newvalue ", B.FWeight, ", stale alive: ", Alive(Stale))
    PutLn(Stale.FWeight)
;
