== CANON-24 (safe-pointers-followups 3.1): a method called through an Own
== may break the invariant inside, through Self, but it must hold again
== when the method returns.
Type
    TBox Struct
        FValue Integer := 1
        invariant Self.FValue > 0, "the value is positive"
    ;
    THolder Struct
        FBox TBox
    ;
    TOuter Struct (TBox)
        FName String := ""
    ;
    TPair<T> Struct
        FLow T
        FHigh T
        invariant Self.FLow <= Self.FHigh, "the low bound is not above the high one"
    ;

TBox.Swing(Self mut, X Integer) :
    Self.FValue := -100
    Self.FValue := X
;

Main :
    P := New(TBox(FValue := 2))
    P.Swing(8)
    PutLn(P.FValue)
    P.Swing(-8)
    PutLn("not reached ", P.FValue)
;
