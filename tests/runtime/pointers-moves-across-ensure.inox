== Safe pointers (CANON-25 rule 3): `ensure` runs on every path that leaves
== its try; when it assigns an owner again, every such path has it back.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    == leave: ensure assigns again
    for I in 1..3
        try
            Free(P)
            leave
        ensure
            P := New(TNode(FValue := 10))
        ;
    ;
    PutLn("leave ", P.FValue)

    == continue: ensure assigns again before the next round
    for I in 1..3
        PutLn("round ", I, " ", P.FValue)
        try
            Free(P)
            continue
        ensure
            P := New(TNode(FValue := 20 + I))
        ;
    ;

    == until: ensure assigns again
    I Integer := 0
    repeat
        I := I + 1
        try
            Free(P)
            until I = 2
        ensure
            P := New(TNode(FValue := 30))
        ;
    ;
    PutLn("until ", P.FValue)

    == an ensure that does not touch the owner
    for J in 1..2
        try
            leave
        ensure
            PutLn("ensure ", J)
        ;
    ;
    PutLn("end ", P.FValue)
;
