== CANON-5: a compound target is evaluated once: the method on its path runs once (assignment-evaluation-order).
Type
    TPoint Struct
        FX Integer := 0
    ;
    TBox Struct
        FPoint Own<TPoint>
    ;

State
    Calls Integer := 0
;

TBox.Current(Self mut) Link<TPoint> :
    Calls += 1
    Return Link(Self.FPoint)
;

Main :
    Box := TBox(FPoint := New(TPoint))
    Box.Current.FX += 5
    PutLn(Calls, " ", Value(Box.Current).FX)
;
