== CANON-5 (r3.62): 'State' has no ':' and closes with ';'. A module may
== have several State sections, between Consts, Type sections and routines.
Module Runtime.StateSectionBoundaries

State
    Counter Integer := 1
    Origin TPoint
;
Const Delta := 10
State
    Total := Counter + Delta
;
Type
    TPoint Struct
        FX Integer := 5
    ;
State
    Last Integer := 0
;
Twice(N Integer) Integer :
    Return N * 2
;
TPoint.Shift(Self mut, D Integer) :
    Self.FX += D
;
State
    Ready Bool := true
;
Main :
    Counter += Twice(Total)
    Origin.Shift(Delta)
    Last := Origin.FX
    PutLn(Counter, " ", Total, " ", Last, " ", Ready)
;
