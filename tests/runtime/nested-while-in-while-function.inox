== v3.21: a while loop nested in a while loop inside an Integer function.
Module Runtime.NestedWhileInWhileFunction

Main :
    PutLn(Count(3))
    PutLn(Count(0))
;

Count(N Integer) Integer :
    T Integer := 0
    I Integer := 0
    while I < N
        J Integer := 0
        while J < N
            T := T + 1
            J := J + 1
        ;
        I := I + 1
    ;
    Return T
;
