== r3.91 (C2): Get reads a Currency or a Crypto strictly: an optional minus,
== digits and at most the type's decimals; Write and WriteLn write it as PutLn.
Use Std.IOUtils

Main :
    Price Currency := 0
    Rate Crypto := 0
    Get(Price, Rate)
    PutLn(Price, " ", Rate, " ", Price * 2)
    Out := Create("inox-test-decimals.txt")
    WriteLn(Out, Price, " ", Rate)
    Close(Out)
    Back := OpenRead("inox-test-decimals.txt")
    PutLn(ReadLn(Back))
    Close(Back)
    DeleteFile("inox-test-decimals.txt")
    GetLn(Price)
;
