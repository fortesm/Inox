== r3.96, as in Ada: `/` truncates toward zero, `mod` has the sign of the
== divisor and `rem` the sign of the dividend.
Main :
    A Integer := -7
    B Integer := 2
    PutLn(A / B)
    PutLn(A mod B, " ", A rem B)
    C Integer := 7
    D Integer := -2
    PutLn(C / D)
    PutLn(C mod D, " ", C rem D)
;
