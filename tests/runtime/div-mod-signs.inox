Module Runtime.DivModSigns

Main :
    A Integer := -7
    B Integer := 2
    PutLn(A div B)
    PutLn(A mod B)
    C Integer := 7
    D Integer := -2
    PutLn(C div D)
    PutLn(C mod D)
;
