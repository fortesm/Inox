== CANON-5: module State variables are module-level mutable storage, read and
== written by any routine of the module, initialized in source order before
== Main runs (an initializer may call a function or use an earlier State).
Module Runtime.StateLowering

Twice(N Integer) Integer :
    Return N * 2
;

State
    Counter Integer := 0
    Total := Twice(10)
    Ready Bool := false
    Ratio Float := 1.5
    Limit Natural := 3
    Base := Total + 1

Bump :
    Counter += 1
    Total := Total + Counter
;

Main :
    Bump
    Bump
    Ready := Counter = 2
    PutLn(Counter, " ", Total, " ", Ready, " ", Ratio * 2.0, " ", Twice(Limit), " ", Base)
    for I in 1..3
        Counter += I
    ;
    PutLn(Counter)
;
