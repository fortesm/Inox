== CANON-5: State variables may be structs and arrays. Without an
== initializer they start at their type defaults; initializers run in source
== order before Main.
Type
    TPoint Struct
        FX Integer := 7
        FY Integer
    ;

State
    Origin TPoint := TPoint(FX := 1, FY := 2)
    Home TPoint
    Counts Array[1..3] Integer := Fill(0)
    Grid Array[1..2, 1..2] TPoint := Fill(Home)
    Total Integer := Origin.FX + Origin.FY
;

Bump :
    Counts[2] += 5
    Origin.FY += 10
    Grid[2, 1].FY := 9
;

Main :
    Bump
    Bump
    PutLn(Counts[1], " ", Counts[2], " ", Origin.FX, " ", Origin.FY, " ", Total)
    PutLn(Home.FX, " ", Home.FY, " ", Grid[2, 1].FX, " ", Grid[2, 1].FY, " ", Grid[1, 2].FX)
;
