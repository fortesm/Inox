== An owner given away on a path the compile-time analysis does not follow
== (here through `leave`) is caught at run time: kind 17, never a null access.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 5))
    for I in 1..3
        Q := Move(P)
        PutLn("round ", I, ": ", Q.FValue)
        leave
        P := New(TNode)
    ;
    PutLn(P.FValue)
;
