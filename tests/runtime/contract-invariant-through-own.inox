== CANON-24 (safe-pointers-followups 3.1): a field written through an Own
== from outside the struct's methods keeps its invariant.
Type
    TBox Struct
        FValue Integer := 1
        invariant Self.FValue > 0, "the value is positive"
    ;
    THolder Struct
        FBox TBox
    ;
    TOuter Struct (TBox)
        FName String := ""
    ;
    TPair<T> Struct
        FLow T
        FHigh T
        invariant Self.FLow <= Self.FHigh, "the low bound is not above the high one"
    ;

Main :
    P := New(TBox(FValue := 2))
    P.FValue := 3
    PutLn(P.FValue)
    P.FValue := -1
    PutLn("not reached ", P.FValue)
;
