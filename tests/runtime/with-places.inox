== CANON-11: the target of `with` may be any place: a variable, a field, an
== array element, a field of a ref mut parameter, State, or an object reached
== through Own, Link or Value. It is evaluated once, on entry (an index that
== changes inside the body, or a call in the index, does not move it), and
== every `.Member` acts on that storage, never on a copy.
Type
    TGrades Struct
        FTotal Integer := 0
        FLast String := ""
    ;
    TClient Struct
        FName String := ""
        FGrades TGrades
    ;

TGrades.Add(Self mut, Text String) :
    Self.FTotal += 1
    Self.FLast := Text
;

State
    GClient TClient
    GCalls Integer := 0
;

NextOne(N Integer) Integer :
    GCalls += 1
    Return N + 1
;

Annotate(ref mut C TClient) :
    with C.FGrades
        .Add("do coupleâmetro")
    ;
;

Show(C TClient) :
    with C.FGrades
        PutLn(C.FName, ": ", .FTotal, " grades, the last ", .FLast)
    ;
;

Main :
    C TClient
    with C
        .FName := "Ana"
        with .FGrades
            .Add("first")
        ;
    ;
    with C.FGrades
        .Add("second")
        Pause
        .Add("third")
    ;
    Annotate(C)
    Show(C)

    Empty TClient
    A Array[1..3] TClient := Fill(Empty)
    I := 2
    with A[I]
        .FName := "Bia"
        I := 3
        .FGrades.FTotal := 5
    ;
    PutLn(A[2].FName, " ", A[2].FGrades.FTotal, " ", A[3].FGrades.FTotal, " ", I)
    with A[NextOne(0)].FGrades
        .Add("a")
        .Add("b")
    ;
    PutLn(GCalls, " ", A[1].FGrades.FTotal)

    with GClient
        .FName := "Caio"
    ;
    PutLn(GClient.FName)

    P := New(TClient)
    with P
        .FName := "Dani"
    ;
    with P.FGrades
        .Add("through the owner")
    ;
    L := Link(P)
    with L.FGrades
        .Add("through the Link")
    ;
    with Value(L)
        .FName := "Daniela"
    ;
    PutLn(P.FName, " ", P.FGrades.FTotal, " ", P.FGrades.FLast)
;

Pause :
    PutLn("...")
;
