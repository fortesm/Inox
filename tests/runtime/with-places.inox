== CANON-11: the target of `with` may be any place: a variable, a field, an
== array element, a field of a ref mut parameter, State, or an object reached
== through Own, Link or Value. It is evaluated once, on entry (an index that
== changes inside the body, or a call in the index, does not move it), and
== every `.Member` acts on that storage, never on a copy.
Type
    TNotas Struct
        FTotal Integer := 0
        FUltima String := ""
    ;
    TCliente Struct
        FNome String := ""
        FNotas TNotas
    ;

TNotas.Add(Self mut, Texto String) :
    Self.FTotal += 1
    Self.FUltima := Texto
;

State
    GCliente TCliente
    GChamadas Integer := 0
;

Proximo(N Integer) Integer :
    GChamadas += 1
    Return N + 1
;

Anotar(ref mut C TCliente) :
    with C.FNotas
        .Add("do parâmetro")
    ;
;

Mostrar(C TCliente) :
    with C.FNotas
        PutLn(C.FNome, ": ", .FTotal, " notas, a última ", .FUltima)
    ;
;

Main :
    C TCliente
    with C
        .FNome := "Ana"
        with .FNotas
            .Add("primeira")
        ;
    ;
    with C.FNotas
        .Add("segunda")
        Pausa
        .Add("terceira")
    ;
    Anotar(C)
    Mostrar(C)

    A Array[1..3] TCliente
    I := 2
    with A[I]
        .FNome := "Bia"
        I := 3
        .FNotas.FTotal := 5
    ;
    PutLn(A[2].FNome, " ", A[2].FNotas.FTotal, " ", A[3].FNotas.FTotal, " ", I)
    with A[Proximo(0)].FNotas
        .Add("a")
        .Add("b")
    ;
    PutLn(GChamadas, " ", A[1].FNotas.FTotal)

    with GCliente
        .FNome := "Caio"
    ;
    PutLn(GCliente.FNome)

    P := New(TCliente)
    with P
        .FNome := "Dani"
    ;
    with P.FNotas
        .Add("pelo dono")
    ;
    L := Link(P)
    with L.FNotas
        .Add("pelo Link")
    ;
    with Value(L)
        .FNome := "Daniela"
    ;
    PutLn(P.FNome, " ", P.FNotas.FTotal, " ", P.FNotas.FUltima)
;

Pausa :
    PutLn("...")
;
