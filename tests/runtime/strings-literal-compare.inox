== CANON-14: comparing Strings uses the String runtime even when the program
== owns no String and raises nothing, so the driver must link libinoxrt.
IsYes(Answer String) Bool :
    Return Answer = "yes"
;

Main :
    PutLn("a" = "b", " ", "x" # "x", " ", IsYes("yes"))
;
