== CANON-8 (generic-struct-methods): methods of generic structs, one

== CANON-24 with CANON-8 (generic-struct-invariants): the invariant of a
== generic struct holds in every instance: after a construction, after a
== method and after a field written from outside.
Type
    TRange<T> Struct
        FLow T
        FHigh T
        invariant Self.FLow <= Self.FHigh, "the low bound is not above the high one"
    ;

TRange<T>.SetHigh(Self mut, X T) :
    Self.FHigh := X
;

Widen(ref mut R TRange<Integer>) :
    R.SetHigh(R.FHigh + 10)
;

Main :
    R := TRange(FLow := 1, FHigh := 5)
    R.SetHigh(9)
    Widen(R)
    PutLn(R.FHigh)
    S := TRange(FLow := "a", FHigh := "c")
    S.FHigh := "b"
    PutLn(S.FHigh)
    R.FHigh := 0
    PutLn("not reached")
;
