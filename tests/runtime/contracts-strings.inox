== Contracts over Strings: old copies of Strings, a String Result and an
== invariant on a String field; checked for leaks by string_leak_check.
Module ContractsStrings

Type
    TNome Struct
        FNome String := "anônimo"
        FAnterior String := ""
        invariant Self.FNome # "", "o nome nunca é vazio"
    ;

TNome.Trocar(Self mut, Novo String) :
    pre Novo # "", "novo nome"
    pos Self.FAnterior = old Self.FNome
    pos Self.FNome = Novo
    Self.FAnterior := Self.FNome
    Self.FNome := Novo
;

TNome.Atual(Self) String :
    pos Result = Self.FNome
    Return Self.FNome
;

Escolher(A String, B String, PrimeiroA Bool) String :
    pos Result = A or Result = B
    if PrimeiroA
        Return A
    ;
    Return B
;

Main :
    N TNome
    for I in 1..3
        N.Trocar(Escolher("Ana", "Bia", I mod 2 = 1))
        PutLn(N.FAnterior, " -> ", N.Atual)
    ;
    M TNome := TNome(FNome := "Caio")
    M.Trocar(N.Atual)
    PutLn(M.FAnterior, " -> ", M.FNome)
;
