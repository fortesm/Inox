== Contracts over Strings: old copies of Strings, a String Result and an
== invariant on a String field; checked for leaks by string_leak_check.
Type
    TName Struct
        FName String := "anonymous"
        FPrevious String := ""
        invariant Self.FName # "", "the name is never empty"
    ;

TName.Swap(Self mut, NewValue String) :
    pre NewValue # "", "newvalue name"
    pos Self.FPrevious = old Self.FName
    pos Self.FName = NewValue
    Self.FPrevious := Self.FName
    Self.FName := NewValue
;

TName.Current(Self) String :
    pos Result = Self.FName
    Return Self.FName
;

Choose(A String, B String, FirstA Bool) String :
    pos Result = A or Result = B
    if FirstA
        Return A
    ;
    Return B
;

Main :
    N TName
    for I in 1..3
        N.Swap(Choose("Ana", "Bia", I mod 2 = 1))
        PutLn(N.FPrevious, " -> ", N.Current)
    ;
    M TName := TName(FName := "Caio")
    M.Swap(N.Current)
    PutLn(M.FPrevious, " -> ", M.FName)
;
