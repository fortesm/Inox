== CANON-8 (generic-struct-methods): methods of generic structs, one

== CANON-24 with CANON-8: a new value of an instance satisfies its
== invariant.
Type
    TRange<T> Struct
        FLow T
        FHigh T
        invariant Self.FLow <= Self.FHigh
    ;

Main :
    S := TRange(FLow := "a", FHigh := "b")
    PutLn(S.FLow)
    R := TRange(FLow := 2.5, FHigh := 1.5)
    PutLn(R.FLow)
;
