== Strings read at run time inside owned objects: moved, replaced, freed,
== and left by an exception (leak-checked by string_leak_check).
Type
    TItem Struct
        FText String := ""
        FNext Option<Own<TItem>>
    ;
    TCouple Struct
        FA Own<TItem>
        FB String := ""
    ;

ReadIt String :
    S := ""
    GetLn(S)
    Return S
;

Push(Top Option<Own<TItem>>, Text String) Own<TItem> :
    NewValue := New(TItem(FText := Text))
    NewValue.FNext := Move(Top)
    Return Move(NewValue)
;

Fail(Item Own<TItem>) :
    PutLn("before fail: ", Item.FText)
    Raise IOError
;

Main :
    Stack Option<Own<TItem>>
    for I in 1..3
        Stack := Push(Move(Stack), ReadIt)
    ;
    Top := Link(Stack)
    while Alive(Top)
        PutLn("item ", Top.FText)
        Top := Link(Top.FNext)
    ;
    Couple := TCouple(FA := New(TItem(FText := ReadIt)), FB := ReadIt)
    Other := Move(Couple)
    PutLn("couple ", Other.FA.FText, " ", Other.FB)
    Value(Other.FA) := TItem(FText := ReadIt)
    PutLn("swapped ", Other.FA.FText)
    try
        Fail(New(TItem(FText := ReadIt)))
    except
        On IOError
            PutLn("the exception freed the item")
        ;
    ;
    Stack := None
    PutLn("end")
;
