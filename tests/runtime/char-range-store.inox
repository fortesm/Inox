== Change char-values: a Char outside a Char Range, stored into it, stops the
== program (kind 11).
Type
    TLetter Range 'A'..'Z'

Main :
    Code := 'Z'
    Upper TLetter := Code
    PutLn(Upper)
    Code := 'a'
    Upper := Code
    PutLn(Upper)
;
