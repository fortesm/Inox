== CANON-19: an exception raised by a function called without arguments
== (`N := Fail`) inside try reaches the handler. Before the String runtime this
== call was emitted with `call` instead of `invoke`, and the program aborted.
Fail Integer :
    Raise RangeError
    Return 1
;

Main :
    try
        N := Fail
        PutLn(N)
    except
        On RangeError
            PutLn("caught")
        ;
    ;
;
