== r3.93 (E2): `_ := F(X)` calls F for its effect and drops its result on
== purpose. The call runs exactly once, with its effects, its exceptions and
== its contracts; an owned result (a String, an owner, a struct with a
== String) is released. Every kind of call: a function, one without
== arguments, a method with and without arguments, a generic routine, a
== library function, a function that raises.
Use Std.Strings

Type
    TNode Struct
        FValue Integer
        FName String := ""
    ;
    TCounter Struct
        FTotal Integer := 0
    ;
    TGrade Struct
        FText String := ""
        FWeight Integer := 1
    ;

State
    Calls Integer := 0
;

Record(Text String) Integer :
    Calls += 1
    PutLn(Text)
    Return Calls
;

NextOne Integer :
    Calls += 1
    Return Calls
;

Saudacao(Name String) String :
    Calls += 1
    Return "hello, " + Name + "!"
;

NewNode(Amount Integer) Own<TNode> :
    Calls += 1
    Return New(TNode(FValue := Amount, FName := "nó " + String(Amount)))
;

Grade(Text String) TGrade :
    Calls += 1
    Return TGrade(FText := Text + " (copy)")
;

Price(Units Integer) Currency :
    Calls += 1
    Return 19.99 * Currency(Units)
;

First<T>(A T, B T) T :
    Calls += 1
    Return A
;

ReadIt(Text String) Integer :
    Calls += 1
    Return Integer(Text)
;

TCounter.Add(Self mut, N Integer) Integer :
    Self.FTotal += N
    Return Self.FTotal
;

TCounter.DoubleIt(Self mut) Integer :
    Self.FTotal *= 2
    Return Self.FTotal
;

Main :
    _ := Record("an effect")
    _ := NextOne
    _ := Saudacao("Marcelo")
    _ := NewNode(7)
    _ := Grade("draft")
    _ := Price(3)
    _ := First("a", "b")
    _ := UpperCase("discarded")
    PutLn("calls: ", Calls)

    C TCounter
    _ := C.Add(5)
    _ := C.DoubleIt
    PutLn("total: ", C.FTotal)

    for I in 1..1000
        _ := Saudacao(String(I))
    ;
    PutLn("calls: ", Calls)

    _ := ReadIt("42")
    try
        _ := ReadIt("forty-two")
        PutLn("never")
    except
        On ConversionError
            PutLn("the exception goes through the discard")
        ;
    ;
    PutLn("calls: ", Calls)
;
