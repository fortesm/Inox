== CANON-25: a later argument replaces the owner a reference argument crosses; the call stops the program, never writing the freed object (reference-argument-validity).
Type
    TNode Struct
        FV Integer := 1
    ;
    THolder Struct
        FChild Own<TNode>
    ;

State
    H THolder := THolder(FChild := New(TNode))
    K THolder := THolder(FChild := New(TNode))
;

Drop Integer :
    H.FChild := New(TNode)
    K.FChild := New(TNode)
    Return 10
;

Store(ref mut X Integer, V Integer) :
    X := V
;

Main :
    Store(H.FChild.FV, Drop)
    PutLn(H.FChild.FV, " ", K.FChild.FV)
;
