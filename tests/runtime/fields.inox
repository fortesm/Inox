== r3.90 (B4): FieldCount(S, Sep) and Field(S, Sep, I) (Std.StrUtils) split a
== String at a separator, counted from 1: one more field than separators,
== empty fields included; an empty separator leaves one field, S. A field
== outside 1..FieldCount stops the program with "string index out of range".
Use Std.StrUtils

Main :
    Line := "ana;bia;;carla"
    Count := FieldCount(Line, ";")
    for I in 1..Count
        Put("[", Field(Line, ";", I), "]")
    ;
    PutLn(" ", Count)
    PutLn(FieldCount("", ","), " ", FieldCount("a,b,", ","), " [", Field("a,b,", ",", 3), "] ", FieldCount("só", ""),
          " ", Field("só", "", 1), " ", Field("x::y::z", "::", 2), " ", FieldCount("日,本", ","))
    PutLn(Field(Line, ";", 5))
;
