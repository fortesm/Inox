== Safe pointers (CANON-25, safe-pointers-followups 1.1): a Link to the object
== of a value owner parameter, returned by the routine, is dead once the
== routine freed the object: reading it traps, never reads freed memory.
Type
    TNode Struct
        FValue Integer := 0
    ;

Grab(P Own<TNode>) Link<TNode> :
    Return Link(P)
;

Main :
    L := Grab(New(TNode(FValue := 1)))
    PutLn(Value(L).FValue)
;
