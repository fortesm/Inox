== CANON-14, CANON-18 (change std-strings): without `Use Std.StrUtils` the
== names of its functions are free. A program declares its own Trim and
== Left, and a variable named Contains; two empty literals in one call lex
== as two Strings.
Trim(S String) String :
    Return "[" + S + "]"
;

Left(A String, B String) String :
    Return A + "|" + B
;

Main :
    Contains := 3
    PutLn(Trim(" x "), " ", Left("", ""), " ", Contains)
    PutLn(Left("", "b"), Left("a", ""), "" + "")
;
