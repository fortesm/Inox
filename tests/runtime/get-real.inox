== r3.89 (C2): Get reads a Float or a Float32 strictly: an optional minus,
== digits, an optional fraction and exponent, then white space or the end. A
== Float32 is rounded once from the text, as a literal is.
Main :
    A Float := 0.0
    B Float := 0.0
    C Float := 0.0
    D Float32 := 0.0
    N Integer := 0
    Get(A, B, C)
    GetLn(D, N)
    PutLn(A, " ", B, " ", C, " ", D > 1.0, " ", N)
    E Float := 0.0
    GetLn(E)
    PutLn(E * 1.0e6)
;
