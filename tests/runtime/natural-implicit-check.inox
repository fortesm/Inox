== ADR-0015 (Ada): storing an Integer into a Natural checks the range at run
== time, with no conversion written: initialization, assignment, compound
== assignment, argument and return.
Module Runtime.NaturalImplicitCheck

Half(N Natural) Natural :
    Return N div 2
;

Main :
    X Integer := 7
    N Natural := X
    N += 1
    M Natural := N * 3
    PutLn(N, " ", M, " ", Half(X), " ", Half(M - 4))
;
