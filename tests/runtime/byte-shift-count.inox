== CANON-8: the shift count of a fixed-width type must be 0..width-1; for
== Byte that is 0..7, even when the shifted value is 0.
Module Runtime.ByteShiftCount

Main :
    B Byte := 0
    N Integer := 8
    PutLn(B shl Byte(N))
;
