== CANON-24 (kept by F5): an exception leaves a loop without any check: no
== final invariant.
Seen(What String, Value Integer) Bool :
    PutLn(What, " ", Value)
    Return True
;

Measure(Value Integer) Integer :
    PutLn("variant ", Value)
    Return Value
;

Main :
    I := 0
    try
        while I < 5
            invariant Seen("while", I)
            variant Measure(10 - I)
            I += 1
            if I = 2
                Raise RangeError
            ;
        ;
        PutLn("not reached")
    except
        On RangeError
            PutLn("caught at ", I)
        ;
    ;
;
