== CANON-8 / CANON-19: Natural(X) of a negative run-time value is a
== deterministic runtime fault, not a wrap to a large unsigned value.
Module Runtime.NaturalConversionNegative

Main :
    X Integer := 2
    X := X - 3
    PutLn("before")
    N Natural := Natural(X)
    PutLn(N)
;
