== Change float-conversions: Float32(F) of a finite F beyond Float32 stops
== the program (kind 11), instead of becoming an infinity.
Main :
    Value := 3.0
    for Index in 1..39
        Value := Value * 10.0
    ;
    PutLn(Float32(Value / 10.0) > Float32(1.0))
    PutLn(Float32(Value))
;
