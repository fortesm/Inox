== CANON-25: a slice bound that replaces the owner the slice crosses stops the program before the element is read (assignment-evaluation-order).
Type
    TNode Struct
        FV Array[1..3] Integer := Fill(1)
    ;
    THolder Struct
        FChild Own<TNode>
    ;

State
    H THolder := THolder(FChild := New(TNode))
    K THolder := THolder(FChild := New(TNode))
;

ChangeOwner Integer :
    H.FChild := New(TNode)
    K.FChild := New(TNode)
    K.FChild.FV[1] := 7
    Return 3
;

Main :
    X := H.FChild.FV[1..ChangeOwner][1]
    PutLn(X)
;
