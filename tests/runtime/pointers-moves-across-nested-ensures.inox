== Safe pointers (CANON-25 rule 3): nested ensures run inner first; the outer
== one assigns again what the inner one frees, so the owner is usable after
== the loop.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    P := New(TNode(FValue := 1))
    for I in 1..3
        try
            try
                leave
            ensure
                Free(P)
            ;
        ensure
            P := New(TNode(FValue := 2))
        ;
    ;
    PutLn("after loop ", P.FValue)
;
