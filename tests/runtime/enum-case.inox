== CANON-13, ADR-0011 (change enum-range-set): a case on an enum that
== names every literal needs no else; ranges and alternatives of literals.
Type
    TSuit (Club, Diamond, Heart, Spade)

Color(S TSuit) String :
    case S
        Club | Spade
            Return "black"
        Diamond..Heart
            Return "red"
    ;
;

Main :
    for S in Club..Spade
        case S
            Club PutLn(S, " ", Color(S))
            Diamond PutLn(S, " ", Color(S))
            Heart..Spade PutLn(S, " ", Color(S), " high")
        ;
    ;
;
