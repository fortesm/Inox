== CANON-24 (safe-pointers-followups 3.1): a field of a struct held by a
== struct an Own points at keeps the inner struct's invariant.
Type
    TBox Struct
        FValue Integer := 1
        invariant Self.FValue > 0, "the value is positive"
    ;
    THolder Struct
        FBox TBox
    ;
    TOuter Struct (TBox)
        FName String := ""
    ;
    TPair<T> Struct
        FLow T
        FHigh T
        invariant Self.FLow <= Self.FHigh, "the low bound is not above the high one"
    ;

Main :
    H := New(THolder(FBox := TBox(FValue := 2)))
    H.FBox.FValue := 4
    PutLn(H.FBox.FValue)
    H.FBox.FValue := 0
    PutLn("not reached ", H.FBox.FValue)
;
