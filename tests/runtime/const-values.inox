== P-C stage 1: module Const values are resolved by semantic analysis and
== read by the backend from the semantic result.
Module Runtime.ConstValues

Const Limit := 10
Const Mask Integer := $FF
Const Enabled := true

Main :
    PutLn(Limit + 1)
    PutLn(Mask)
    if Enabled
        PutLn("enabled")
    ;
    for I in 1..Limit step Limit div 2
        Put(I, " ")
    ;
    PutLn("")
;
