== CANON-25: a read whose index replaces the owner the place crosses stops the program, never reading the freed object (assignment-evaluation-order).
Type
    TNode Struct
        FV Array[1..3] Integer := Fill(1)
    ;
    THolder Struct
        FChild Own<TNode>
    ;

State
    H THolder := THolder(FChild := New(TNode))
    K THolder := THolder(FChild := New(TNode))
;

ChangeOwner Integer :
    H.FChild := New(TNode)
    K.FChild := New(TNode)
    K.FChild.FV[2] := 7
    Return 2
;

Main :
    X := H.FChild.FV[ChangeOwner]
    PutLn(X, " ", H.FChild.FV[2], " ", K.FChild.FV[2])
;
