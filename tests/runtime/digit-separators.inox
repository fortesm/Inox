== CANON-2 (v3.3): `_` separates digits in integer, real and hexadecimal
== literals; it is cosmetic.
Module Runtime.DigitSeparators

Const Big := 1_000_000
Const Mask := $FF_FF

Main :
    X := 10_000_000 + Big
    PutLn(X)
    PutLn(Mask)
    PutLn(3.141_592 > 3.141_591)
;
