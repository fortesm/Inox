== A Link to a freed object never reaches it: the use traps (kind 16),
== also inside try (change safe-pointers).
Module Runtime.PointersFreedLink

Type
    TConta Struct
        FSaldo Integer := 0
    ;

Main :
    Conta := New(TConta(FSaldo := 10))
    Visao := Link(Conta)
    PutLn("saldo ", Visao.FSaldo)
    Free(Conta)
    try
        PutLn("depois ", Visao.FSaldo)
    except
        PutLn("caught")
    ;
;
