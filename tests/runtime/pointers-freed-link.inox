== A Link to a freed object never reaches it: the use traps (kind 16),
== also inside try (change safe-pointers).
Type
    TAccount Struct
        FBalance Integer := 0
    ;

Main :
    Account := New(TAccount(FBalance := 10))
    View := Link(Account)
    PutLn("balance ", View.FBalance)
    Free(Account)
    try
        PutLn("after ", View.FBalance)
    except
        PutLn("caught")
    ;
;
