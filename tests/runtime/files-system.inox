== Std.IOUtils F7 (OpenSpec change file-io): Exists, RenameFile (raising
== AlreadyExists onto an existing file, on every system) and DeleteFile.
Use Std.IOUtils

Main :
    First String := "inox-test-files-a.txt"
    Second String := "inox-test-files-b.txt"
    PutLn(Exists(First), " ", Exists(Second))
    Create(First)
    PutLn(Exists(First), " ", Exists(Second))
    RenameFile(First, Second)
    PutLn(Exists(First), " ", Exists(Second))
    Create(First)
    try
        RenameFile(First, Second)
    except
        On AlreadyExists
            PutLn("AlreadyExists")
        ;
    ;
    DeleteFile(First)
    DeleteFile(Second)
    PutLn(Exists(First), " ", Exists(Second), " ", Exists("."))
;
