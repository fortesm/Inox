== CANON-5: a String Const is a value like a literal: printed, stored,
== passed and compared.
Module Runtime.ConstString

Const Nome := "dados.txt"
Const Vazio := ""

Mostrar(S String) :
    PutLn("[", S, "]")
;

Main :
    PutLn(Nome)
    Copia := Nome
    Mostrar(Nome)
    Mostrar(Vazio)
    PutLn(Copia = Nome, " ", Nome # Vazio)
;
