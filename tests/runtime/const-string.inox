== CANON-5: a String Const is a value like a literal: printed, stored,
== passed and compared.
Const Name := "data.txt"
Const Empty := ""

Show(S String) :
    PutLn("[", S, "]")
;

Main :
    PutLn(Name)
    Duplicate := Name
    Show(Name)
    Show(Empty)
    PutLn(Duplicate = Name, " ", Name # Empty)
;
