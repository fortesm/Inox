== Safe pointers (CANON-25, safe-pointers-followups 1.3): assigning a value
== that holds owners frees the object it replaces, so a Link to that object
== is checked again after the assignment, and traps.
Type
    TPoint Struct
        FX Integer := 0
    ;
    TBox Struct
        FPoint Own<TPoint>
    ;

Main :
    B := TBox(FPoint := New(TPoint(FX := 1)))
    L := Link(B.FPoint)
    PutLn("before ", L.FX)
    B.FPoint := New(TPoint(FX := 2))
    PutLn("after ", L.FX)
;
