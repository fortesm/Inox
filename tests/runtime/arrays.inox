== CANON-13: fixed arrays Array[Low..High] T. Value type (assignment and
== by-value parameters copy), bounds from literals or Consts, negative bounds,
== multi-dimensional M[I, J], narrow element storage (Byte, Int8), Float and
== Bool elements, Low/High/Length as constants, compound assignment on an
== element, array parameters and results.
Const Size := 5

Sum(V Array[1..Size] Integer) Integer :
    Total Integer := 0
    for I in Low(V)..High(V)
        Total += V[I]
    ;
    Return Total
;

Squares Array[1..Size] Integer :
    R Array[1..Size] Integer
    for I in 1..Size
        R[I] := I * I
    ;
    Return R
;

Main :
    A Array[1..Size] Integer
    for I in Low(A)..High(A)
        A[I] := I * I
    ;
    A[2] += 100
    Total Integer := 0
    for I in 1..Length(A)
        Total += A[I]
    ;
    PutLn(A[2], " ", Total, " ", Length(A), " ", Low(A), " ", High(A))
    M Array[1..2, -1..1] Byte
    M[1, 0] := 200
    M[2, -1] := M[1, 0] + 55
    PutLn(M[1, 0], " ", M[2, -1], " ", M[2, 1])
    B Array[1..Size] Integer := A
    B[1] := -7
    PutLn(A[1], " ", B[1])
    F Array[0..2] Float
    F[1] := 2.5
    Flags Array[0..1] Bool
    Flags[1] := F[1] > 2.0
    PutLn(F[1], " ", Flags[0], " ", Flags[1])
    K Array[1..2] Int8
    K[1] := -128
    PutLn(K[1])
    Row Array[-1..1] Byte := M[2]
    PutLn(Row[-1])
    PutLn(Sum(A), " ", Sum(Squares), " ", Squares[3])
;