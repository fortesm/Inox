== CANON-9 method reuse (OpenSpec change method-reuse): `Struct (TPart)`
== offers the fields and methods of TPart at every level, a reused method
== runs on its part (delegation: TPerson.Show calls TPerson.Title), Override
== replaces a reused method for callers of the outer struct, and the full
== path always works. Built-in type methods (String.UpdateStr) act on fields.
Type
    TAddress Struct
        FStreet String := ""
        FCity String := ""
    ;
    TPerson Struct (TAddress)
        FId Integer := 0
        FName String := ""
    ;
    TSubscription Struct (TPerson)
        FIdAss Integer := 0
        FPlan String := ""
    ;
    TA Struct
        FX Integer := 1
    ;
    TB Struct
        FY Integer := 2
    ;
    TC Struct (TA, TB)
        FZ Integer := 3
    ;

TAddress.Change(Self mut, Street String, City String) :
    Self.FStreet := Street
    Self.FCity := City
;

TPerson.UpdateName(Self mut, Name String) :
    if Name # ""
        Self.FName := Name
    ;
;

TPerson.Title(Self) String :
    Return "Person"
;

TPerson.Show(Self) :
    PutLn(Self.Title, ": ", Self.FName, " (", Self.FCity, ")")
;

TSubscription.Title(Self) String Override :
    Return "Subscriber"
;

String.UpdateStr(Self mut, Value String) :
    if Value # ""
        Self := Value
    ;
;

TA.Show(Self) :
    PutLn("A ", Self.FX)
;

TB.Show(Self) :
    PutLn("B ", Self.FY)
;

== Two parts have Show: TC replaces both, and still reaches each by its path.
TC.Show(Self) Override :
    PutLn("C ", Self.FZ)
    Self.TA.Show
    Self.TB.Show
;

Main :
    A TSubscription
    A.UpdateName("Marcelo")
    A.Change("Street A", "Recife")
    A.FPlan.UpdateStr("Plan9")
    A.FPlan.UpdateStr("")
    A.TPerson.TAddress.Change("Street B", "Natal")
    PutLn(A.FName, " ", A.FCity, " ", A.FStreet, " ", A.FPlan)
    PutLn(A.Title, " / ", A.TPerson.Title)
    A.Show
    A.FId := 7
    PutLn(A.FId, " ", A.TPerson.FId)
    with A
        .FName := "With with"
        .UpdateName("With with 2")
    ;
    PutLn(A.FName)
    B := A
    B.UpdateName("Duplicate")
    PutLn(A.FName, " ", B.FName)
    P := TPerson(FName := "Part")
    D := TSubscription(TPerson := P, FPlan := "Gold")
    PutLn(D.FName, " ", D.FPlan)
    C TC
    C.Show
    PutLn(C.FX + C.FY + C.FZ)
;
