== CANON-24 design by contract, the contracts that hold: pre and pos with
== old and Result, a struct invariant with a reused part, an Override that
== inherits and extends the contracts it replaces, loop invariant and
== variant, contracts on a method of a built-in type, recursion, a body that
== raises (its pos is not checked) and a String in old.
Type
    TPerson Struct
        FName String := ""
        FAge Integer := 0
        invariant Self.FAge >= 0, "a non-negative age"
    ;
    TClient Struct (TPerson)
        FLimit Integer := 0
        invariant Self.FLimit <= 1000
    ;

TPerson.Birthday(Self mut, Years Integer) :
    pre Years > 0 and Years < 5
    pos Self.FAge = old Self.FAge + Years
    Self.FAge += Years
;

TPerson.Rename(Self mut, Name String) :
    pre Name # ""
    pos Self.FName = Name
    pos Self.FName # old Self.FName or Name = old Self.FName
    Self.FName := Name
;

TPerson.Age(Self) Integer :
    pos Result = Self.FAge
    Return Self.FAge
;

TClient.Birthday(Self mut, Years Integer) Override :
    pre else Years >= 5 and Years < 100
    pos then Self.FLimit = old Self.FLimit
    Self.TPerson.FAge += Years
;

String.Swap(Self mut, NewValue String) :
    pre NewValue # ""
    pos Self = NewValue
    Self := NewValue
;

Factorial(N Integer) Integer :
    pre N >= 0 and N <= 20
    pos Result >= 1
    if N = 0
        Return 1
    ;
    Return N * Factorial(N - 1)
;

Root(N Integer) Integer :
    pre N >= 0
    pos Result * Result <= N and (Result + 1) * (Result + 1) > N
    R := 0
    while (R + 1) * (R + 1) <= N
        invariant R * R <= N
        variant N - R * R
        R += 1
    ;
    Return R
;

Add(N Integer) Integer :
    pre N >= 0
    pos Result = N * (N + 1) / 2
    Total := 0
    for I in 1..N
        invariant Total = (I - 1) * I / 2
        Total += I
    ;
    Return Total
;

CountUp(N Integer) Integer :
    I := N
    Steps := 0
    repeat
        invariant I >= 0
        variant I
        if I = 0
            leave
        ;
        I -= 1
        Steps += 1
    ;
    Return Steps
;

Fail(N Integer) Integer :
    pos Result = N + 1
    if N > 0
        Raise RangeError
    ;
    Return N
;

Main :
    C TClient
    C.Rename("Ana")
    C.Birthday(3)                == pre of TPerson (inherited)
    C.Birthday(40)               == pre else of TClient
    PutLn(C.FName, " ", C.Age, " ", C.FLimit)
    C.FLimit := 1000
    S := "x"
    S.Swap("y")
    PutLn(S, " ", Factorial(10), " ", Root(99), " ", Root(100), " ", Add(10), " ", CountUp(4))
    try
        PutLn(Fail(1))
    except
        On RangeError
            PutLn("RangeError: the pos of Fail is not checked")
        ;
    ;
;
