== v3.21: a while loop nested in a for loop; the inner counter is a loop-body local.
Module Runtime.NestedWhileInFor

Main :
    for I in 1..3
        K Integer := 0
        while K < I
            K := K + 1
        ;
        PutLn(I, " ", K)
    ;
;
