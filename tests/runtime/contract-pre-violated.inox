== CANON-24: a broken precondition is the caller's fault; it traps, even inside try.
Type
    TAccount Struct
        FBalance Integer := 0
        invariant Self.FBalance >= 0, "the balance is never negative"
    ;

TAccount.Deposit(Self mut, Amount Integer) :
    pre Amount > 0, "a positive deposit"
    pos Self.FBalance = old Self.FBalance + Amount
    Self.FBalance += Amount
;

TAccount.DepositWrong(Self mut, Amount Integer) :
    pos Self.FBalance = old Self.FBalance + Amount
    Self.FBalance += Amount + 1
;

TAccount.Reset(Self mut) :
    Self.FBalance := -1
;

Twice(N Integer) Integer :
    pos Result = 2 * N
    Return N + N + 1
;

Adjust(ref mut Amount Integer, NewValue Integer) :
    Amount := NewValue
;

Main :
    C TAccount
    try
        C.Deposit(0)
    except
        PutLn("never: a contract trap is not an exception")
    ;
;
