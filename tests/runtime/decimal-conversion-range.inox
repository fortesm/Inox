== r3.91 (A4): a Crypto beyond Currency stops the conversion with "integer
== conversion out of range", as an integer conversion does.
Main :
    Huge Crypto := 100_000_000_000_000.0
    PutLn(Huge)
    PutLn(Currency(Huge))
;
