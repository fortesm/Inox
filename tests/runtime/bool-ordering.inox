== v3.57 (Marcelo Fortes, 2026-10-12): Bool is ordered false < true, as in
== Pascal and Ada, with every comparison operator.
Module Runtime.BoolOrdering

Main :
    F Bool := false
    T Bool := true
    PutLn(F < T, " ", T < F, " ", F <= F, " ", T >= F, " ", T > T, " ", F # T)
    PutLn(false < true, " ", (1 > 2) < (2 > 1), " ", not (T <= F))
    for I in 1..3
        Even := I mod 2 = 0
        if Even > F
            PutLn(I, " par")
        ;
    ;
;
