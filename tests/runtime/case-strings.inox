== Change case-strings (ADR-0011): a case on a String. Each choice is a
== String literal or a String Const, compared byte for byte as = compares;
== several choices share an arm with |; else is required. The selector is
== evaluated once, also when it is a call or a concatenation.
Use Std.StrUtils

Const Quit := "quit"

Command(Line String) String :
    case Trim(Line)
        "start" | "go"
            Return "starting"
        "stop" | "halt" | Quit
            Return "stopping"
        "" | "\t"
            Return "empty"
        "café"
            Return "accented"
        else
            Return "unknown: " + Line
    ;
;

Main :
    Line String := ""
    for Index in 1..7
        GetLn(Line)
        PutLn(Command(Line))
    ;
    Word := "Go"
    case Word + "!"
        "go!"
            PutLn("lower")
        "Go!"
            PutLn("as written")
        else
            PutLn("other")
    ;
;
