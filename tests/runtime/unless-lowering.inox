== `unless C` runs its body when C is false; it composes with loops.
Module Runtime.UnlessLowering

Main :
    N Integer := 3
    unless N = 0
        PutLn("not zero")
    ;
    unless N > 0
        PutLn("never")
    ;
    for I in 1..5
        unless I mod 2 = 0
            Put(I, " ")
        ;
    ;
    PutLn("")
;
