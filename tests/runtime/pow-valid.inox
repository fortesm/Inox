Module Runtime.PowValid

Main :
    A Integer := 2
    B Integer := 62
    PutLn(A ^ B)
    C Integer := 0
    PutLn(C ^ C)
    D Integer := -2
    E Integer := 63
    PutLn(D ^ E)
;
