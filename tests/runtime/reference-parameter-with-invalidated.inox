== CANON-25: a with on a ref mut parameter keeps the check of the caller's object (reference-parameter-validity).
Type
    TBox Struct
        FN Integer := 0
    ;
    TNode Struct
        FD TBox
    ;
    THolder Struct
        FChild Own<TNode>
    ;

State
    H THolder := THolder(FChild := New(TNode))
    K THolder := THolder(FChild := New(TNode))
;

Replace(ref mut X TBox) :
    with X
        H.FChild := New(TNode)
        K.FChild := New(TNode)
        .FN := 10
    ;
;

Main :
    Replace(H.FChild.FD)
    PutLn(H.FChild.FD.FN, " ", K.FChild.FD.FN)
;
