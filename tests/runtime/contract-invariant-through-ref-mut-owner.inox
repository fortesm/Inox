== CANON-24 (safe-pointers-followups 3.1): a routine that receives an
== owner as ref mut and writes through it keeps the invariant.
Type
    TBox Struct
        FValue Integer := 1
        invariant Self.FValue > 0, "the value is positive"
    ;
    THolder Struct
        FBox TBox
    ;
    TOuter Struct (TBox)
        FName String := ""
    ;
    TPair<T> Struct
        FLow T
        FHigh T
        invariant Self.FLow <= Self.FHigh, "the low bound is not above the high one"
    ;

Lower(ref mut P Own<TBox>, X Integer) :
    P.FValue := X
;

Main :
    P := New(TBox(FValue := 2))
    Lower(P, 1)
    PutLn(P.FValue)
    Lower(P, 0)
    PutLn("not reached ", P.FValue)
;
