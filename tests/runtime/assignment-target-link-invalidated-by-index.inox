== CANON-25: a place reached through a Link whose object its index frees stops the program, never writing the freed object (assignment-evaluation-order).
Type
    TNode Struct
        FV Array[1..3] Integer := Fill(1)
    ;
    THolder Struct
        FChild Own<TNode>
    ;

State
    H THolder := THolder(FChild := New(TNode))
    K THolder := THolder(FChild := New(TNode))
;

ChangeOwner Integer :
    H.FChild := New(TNode)
    K.FChild := New(TNode)
    Return 2
;

Main :
    L := Link(H.FChild)
    PutLn(Alive(L))
    Value(L).FV[ChangeOwner] := 10
    PutLn(K.FChild.FV[2])
;
