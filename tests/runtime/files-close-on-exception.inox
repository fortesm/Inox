== Std.Files F1 (OpenSpec change file-io): a File is closed when its routine
== is left by an exception, so what it wrote is in the file; a File passed
== as ref mut is written by the callee and still open in the caller.
Use Std.IOUtils

WriteThenFail(Path String) :
    F := Create(Path)
    WriteLn(F, "written before the exception")
    Raise RangeError
;

AddLines(ref mut Target File, Count Integer) :
    for I in 1..Count
        WriteLn(Target, "line ", I)
    ;
;

ReadAll(ref mut Source File) Integer :
    Lines Integer := 0
    while not Eof(Source)
        PutLn("  ", ReadLn(Source))
        Lines += 1
    ;
    Return Lines
;

Main :
    Path String := "inox-test-files-close.txt"
    try
        WriteThenFail(Path)
    except
        On RangeError
            PutLn("caught")
        ;
    ;
    R := OpenRead(Path)
    PutLn(ReadLn(R))
    Close(R)

    Out := Create(Path)
    AddLines(Out, 3)
    WriteLn(Out, "end")
    Close(Out)
    Input := OpenRead(Path)
    PutLn(ReadAll(Input), " lines")
    Close(Input)
    DeleteFile(Path)
;
