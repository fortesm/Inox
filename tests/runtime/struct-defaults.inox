== CANON-9 / CANON-5 rule 4: a struct without initializer takes its field
== defaults, or zero; literal defaults exist for every scalar type.
Type
    TConfig Struct
        FPort Integer := 8080
        FRetries Int8 := -3
        FMask Integer := $FF
        FLevel Byte := 200
        FCount Natural := 7
        FRate Float := 1.5
        FScale Float32 := 0.25
        FHalf Float32 := 0.5
        FEnabled Bool := true
        FSpare Integer
    ;

Main :
    C TConfig
    PutLn(C.FPort, " ", C.FRetries, " ", C.FMask, " ", C.FLevel, " ", C.FCount)
    PutLn(C.FRate, " ", C.FEnabled, " ", C.FSpare)
    == Float32 values are not printed yet; compare them instead.
    PutLn(C.FScale < C.FHalf, " ", C.FScale = C.FScale)
;
