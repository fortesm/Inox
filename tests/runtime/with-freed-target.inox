== CANON-11 with CANON-25: a `with` target reached through a pointer is
== checked at every `.Member`; freeing its object inside the body stops the
== program at the next use, never reading freed memory.
Type
    TGrades Struct
        FTotal Integer := 0
    ;
    TClient Struct
        FGrades TGrades
    ;

Main :
    P := New(TClient)
    with P.FGrades
        .FTotal := 1
        Free(P)
        PutLn("freed")
        .FTotal := 2
    ;
;
