== CANON-19 (P-A, approved 2026-10-09): a runtime arithmetic fault is a
== deterministic Inox trap, not an exception. No handler, Else, plain except or
== finally block may run; "before" must still appear (output is flushed).
Module Runtime.FaultNotCatchable

Main :
    A Integer := 0
    try
        PutLn("before")
        PutLn(10 div A)
        PutLn("after")
    except
        On DivisionByZero
            PutLn("caught DivisionByZero")
        ;
        On ArithmeticError
            PutLn("caught ArithmeticError")
        ;
        Else
            PutLn("caught something")
        ;
    finally
        PutLn("finally ran")
    ;
    PutLn("continued")
;
