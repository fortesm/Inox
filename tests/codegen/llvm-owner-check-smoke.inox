== Safe pointers (CANON-25): reading an owner emits the check of an owner
== given away (trap 17): a null test, expected false, and the fault call
== with kind 17.
Type
    TNode Struct
        FValue Integer := 0
    ;

Peek(P Own<TNode>) Integer :
    Return P.FValue
;

Main :
    P := New(TNode(FValue := 3))
    PutLn(Peek(Move(P)))
;
