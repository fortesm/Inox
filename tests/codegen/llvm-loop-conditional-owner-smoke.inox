== Change loop-body-lifetime (r3.137): an owner declared on a conditional
== path of a loop body has its slot allocated and emptied in the entry
== block, and the body's end loads it from that slot, frees it and empties
== it again, so a round in which the declaration did not run is safe and no
== value is used where it is not defined.
Type
    TNode Struct
        FValue Integer := 0
    ;

Main :
    for I in 1..2
        if I = 1
            P := New(TNode(FValue := I))
            PutLn(P.FValue)
        ;
    ;
;
