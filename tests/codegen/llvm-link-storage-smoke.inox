== Safe pointers (CANON-25, safe-pointers-followups 1.2): Kept's locals are
== reached only by Links that stay in their blocks, so they live on the
== stack: no generation block and no check of a Link to them. Escaping's
== local is returned through a Link, so it gets the module's only
== generation block (`__inox_own_alloc(i64 0)`).
Type
    TPoint Struct
        FX Integer := 0
        FY Integer := 0
    ;

Kept Integer :
    P TPoint := TPoint(FX := 1, FY := 2)
    L := Link(P)
    L.FX := 10
    Total := 0
    for I in 1..3
        N Integer := I
        R := Link(N)
        Value(R) := Value(R) * 2
        Total += Value(R)
    ;
    Return Total + L.FX + L.FY
;

Escaping Link<Integer> :
    X Integer := 1
    Return Link(X)
;

Main :
    PutLn(Kept, " ", Alive(Escaping))
;
