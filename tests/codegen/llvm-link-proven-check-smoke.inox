== Safe pointers (CANON-25, safe-pointers-followups 1.3): Sum uses its Link
== in three statements with nothing between them that can free an object:
== only the first use is checked. Mixed calls a routine between its two
== uses, so both are checked: three checks in the module (five before).
Type
    TPoint Struct
        FX Integer := 0
        FY Integer := 0
        FZ Integer := 0
    ;

Sum(L Link<TPoint>) Integer :
    A := L.FX
    B := L.FY
    C := L.FZ
    Return A + B + C
;

Twice(V Integer) Integer :
    Return V * 2
;

Mixed(L Link<TPoint>) Integer :
    A := L.FX
    B := Twice(A)
    Return B + L.FY
;

Main :
    P := New(TPoint(FX := 1, FY := 2, FZ := 3))
    PutLn(Sum(Link(P)), " ", Mixed(Link(P)))
;
