#
# The BUILD part of the Inox version (canon SECTION 02, VERSIONING): the
# number of commits in the history being compiled. On main it only grows,
# and two builds of the same commit get the same number. Run at every build
# (`cmake -P`); the header is rewritten only when the number changes, so
# nothing recompiles otherwise. Outside a git checkout the number is 0.
#
# Inputs: SOURCE_DIR (the repository), OUTPUT (the header to write).

set(build_number 0)
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-list --count HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE git_count
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE git_result
        ERROR_QUIET)
    if(git_result EQUAL 0 AND git_count MATCHES "^[0-9]+$")
        set(build_number "${git_count}")
    endif()
endif()

set(content "// Generated by cmake/InoxBuildNumber.cmake; do not edit.\n#pragma once\n\nnamespace inox::compiler::support {\n\ninline constexpr unsigned kBuildNumber = ${build_number};\n\n} // namespace inox::compiler::support\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
else()
    set(existing "")
endif()
if(NOT existing STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
