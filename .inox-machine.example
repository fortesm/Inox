# SPDX-License-Identifier: MPL-2.0
# Machine identity for AI agents working on Inox (template).
#
# Copy this file to `.inox-machine` in the repository root of each of Marcelo's
# machines and fill it in. `.inox-machine` is listed in .gitignore and must never
# be committed: it describes one physical machine, not the project.
#
# Agents read it at the start of a session (AGENTS.md, "Machine identity").
# Format: one `key = value` per line; `#` starts a comment.

# Short unique name, used in test reports and PR descriptions.
id = trabalho

# What the machine is for. Suggested values:
#   work-test  machine at Marcelo's workplace, for implementation tests
#   home-dev   machine at Marcelo's home, for day-to-day development
role = work-test

os = Windows 11 x64
repo_path = F:\Projetos\Inox

# Toolchain as installed on this machine (versions matter: CI uses others).
compiler = clang 22.1.6 (x86_64-pc-windows-msvc)
build_tools = MSVC Build Tools, CMake, Ninja, PowerShell 7
build_preset = windows-clang-msvc-debug
test_command = pwsh -ExecutionPolicy Bypass -File .\scripts\run-tests.ps1 -InoxExe .\build\windows-clang-msvc\Debug\inox.exe

# What agents may do here, in Marcelo's words.
allowed = build, run tests, local experiments, push to feature branches
not_allowed = push to main, merge pull requests

notes =
