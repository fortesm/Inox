== CANON-5: as compound-assignment-value-before-target, the index changed through ref mut (assignment-evaluation-order).
Shift(ref mut J Integer) Integer :
    J := 2
    Return 10
;

Main :
    V Array[1..3] Integer := Fill(0)
    I := 1
    V[1] := 100
    V[2] := 200
    V[I] += Shift(I)
    PutLn(V[1], " ", V[2], " ", I)
;
