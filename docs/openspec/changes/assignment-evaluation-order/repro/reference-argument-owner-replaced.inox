== Q1 of assignment-evaluation-order: a reference argument whose owner a later argument replaces. Expected output to be set by the decision on Q1.
Type
    TNode Struct
        FV Integer := 1
    ;
    THolder Struct
        FChild Own<TNode>
    ;

State
    H THolder := THolder(FChild := New(TNode))
    K THolder := THolder(FChild := New(TNode))
;

Drop Integer :
    H.FChild := New(TNode)
    K.FChild := New(TNode)
    Return 10
;

Store(ref mut X Integer, V Integer) :
    X := V
;

Main :
    Store(H.FChild.FV, Drop)
    PutLn(H.FChild.FV, " ", K.FChild.FV)
;
