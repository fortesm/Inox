== CANON-5: L op= R evaluates R, then L once; Drop replaces the owner the target crosses (assignment-evaluation-order).
Type
    TNode Struct
        FV Integer := 1
    ;
    THolder Struct
        FChild Own<TNode>
    ;

State
    H THolder := THolder(FChild := New(TNode))
    K THolder := THolder(FChild := New(TNode))
;

Drop Integer :
    H.FChild := New(TNode)
    K.FChild := New(TNode)
    Return 10
;

Main :
    H.FChild.FV += Drop
    PutLn(H.FChild.FV, " ", K.FChild.FV)
;
