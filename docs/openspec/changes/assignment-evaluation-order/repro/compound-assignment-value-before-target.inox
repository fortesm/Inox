== CANON-5: the element V[I] += Shift updates is chosen after Shift changes I (assignment-evaluation-order).
State
    I Integer := 1
    V Array[1..3] Integer := Fill(0)
;

Shift Integer :
    I := 2
    Return 10
;

Main :
    V[1] := 100
    V[2] := 200
    V[I] += Shift
    PutLn(V[1], " ", V[2], " ", I)
;
