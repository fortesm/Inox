== A bank teller machine on the terminal, with a numbered menu: balance,
== deposit, withdrawal, transfer to another account, cancellation of the
== last operation and the statement. Every change is saved in
== inox-banco.txt (the accounts) and inox-banco-extrato.txt (the
== statement, readable by people), so the next run continues from there.
==
== Composition with method reuse (CANON-9):
==   TSaldo    knows how to deposit and withdraw
==   TTitular  knows who owns the account
==   TConta    Struct (TTitular, TSaldo): an account reuses both, and
==             overrides Apresentar to add the balance
==   TCaixa    the machine: two accounts and the last operation
==
== Inox does not convert text to numbers yet (planned with Std.Strings), so
== inox-banco.txt keeps each number one digit per line, closed by "-".
== Typing something that is not a number at a prompt stops the program
== (Get reads Integer values).
Module BankAtm
Use Std.IOUtils

Const Arquivo := "inox-banco.txt"
Const Extrato := "inox-banco-extrato.txt"
Const Cabecalho := "Inox Banco: um digito por linha; '-' fecha cada numero"

Type
    TSaldo Struct
        FSaldo Integer := 0
    ;
    TTitular Struct
        FNumero Integer := 0
        FNome String := ""
    ;
    TConta Struct (TTitular, TSaldo)
        FAgencia Integer := 1
    ;
    TCaixa Struct
        FOrigem TConta
        FDestino TConta
        FUltimaOperacao Integer := 0      == 0 nenhuma, 1 depósito, 2 saque, 3 envio
        FUltimoValor Integer := 0
    ;

== ---------- TSaldo: money in and out ----------

TSaldo.Depositar(Self mut, Valor Integer) :
    Self.FSaldo += Valor
;

TSaldo.Sacar(Self mut, Valor Integer) Bool :
    if Valor > Self.FSaldo
        Return false
    ;
    Self.FSaldo -= Valor
    Return true
;

== ---------- TTitular and TConta ----------

TTitular.Apresentar(Self) :
    PutLn("Conta ", Self.FNumero, " - ", Self.FNome)
;

TConta.Apresentar(Self) Override :
    Put("Agência ", Self.FAgencia, ", ")
    Self.TTitular.Apresentar
    PutLn("  saldo: R$ ", Self.FSaldo)
;

== ---------- Numbers in the text file ----------

SalvarNumero(ref mut F File, N Integer) :
    D := 1
    while D <= N div 10
        D *= 10
    ;
    repeat
        WriteLn(F, N div D mod 10)
        D := D div 10
        until D = 0
    ;
    WriteLn(F, "-")
;

Digito(S String) Integer :
    if S = "0"
        Return 0
    elif S = "1"
        Return 1
    elif S = "2"
        Return 2
    elif S = "3"
        Return 3
    elif S = "4"
        Return 4
    elif S = "5"
        Return 5
    elif S = "6"
        Return 6
    elif S = "7"
        Return 7
    elif S = "8"
        Return 8
    elif S = "9"
        Return 9
    ;
    Raise IOError                         == not a digit: the file is damaged
;

LerNumero(ref mut F File) Integer :
    N Integer := 0
    Linha := ReadLn(F)
    while Linha # "-"
        N := N * 10 + Digito(Linha)
        Linha := ReadLn(F)
    ;
    Return N
;

Registrar(Operacao String, Valor Integer, Saldo Integer) :
    try
        G := OpenAppend(Extrato)
        WriteLn(G, Operacao, " R$ ", Valor, " -> saldo R$ ", Saldo)
    except
        On IOError
            PutLn("Aviso: o extrato não pôde ser gravado.")
        ;
    ;
;

== ---------- TCaixa: the machine ----------

TCaixa.Iniciar(Self mut) :
    Self.FOrigem := TConta(TTitular := TTitular(FNumero := 1, FNome := "Marcelo"),
                           TSaldo := TSaldo(FSaldo := 1000))
    Self.FDestino := TConta(TTitular := TTitular(FNumero := 2, FNome := "Ana"),
                            TSaldo := TSaldo(FSaldo := 500))
    Self.FUltimaOperacao := 0
    Self.FUltimoValor := 0
;

TCaixa.Salvar(Self) :
    try
        F := Create(Arquivo)
        WriteLn(F, Cabecalho)
        SalvarNumero(F, Self.FOrigem.FSaldo)
        SalvarNumero(F, Self.FDestino.FSaldo)
        SalvarNumero(F, Self.FUltimaOperacao)
        SalvarNumero(F, Self.FUltimoValor)
    except
        On IOError
            PutLn("Aviso: as contas não puderam ser gravadas.")
        ;
    ;
;

TCaixa.Reiniciar(Self mut) :
    Self.Iniciar
    Self.Salvar
    try
        G := Create(Extrato)
        WriteLn(G, "Contas reiniciadas: conta 1 R$ 1000, conta 2 R$ 500")
    except
        On IOError
            PutLn("Aviso: o extrato não pôde ser gravado.")
        ;
    ;
;

TCaixa.Carregar(Self mut) :
    Self.Iniciar
    if not Exists(Arquivo)
        Self.Reiniciar                    == first run: the accounts are created
        Exit
    ;
    try
        F := OpenRead(Arquivo)
        if ReadLn(F) # Cabecalho
            Raise IOError
        ;
        Self.FOrigem.FSaldo := LerNumero(F)
        Self.FDestino.FSaldo := LerNumero(F)
        Self.FUltimaOperacao := LerNumero(F)
        Self.FUltimoValor := LerNumero(F)
    except
        On IOError
            PutLn("O arquivo ", Arquivo, " está danificado: contas reiniciadas.")
            Self.Reiniciar
        ;
    ;
;

TCaixa.Lembrar(Self mut, Operacao Integer, Valor Integer) :
    Self.FUltimaOperacao := Operacao
    Self.FUltimoValor := Valor
    Self.Salvar
;

TCaixa.Depositar(Self mut, Valor Integer) :
    Self.FOrigem.Depositar(Valor)                     == TSaldo.Depositar, through TConta
    Registrar("Depósito", Valor, Self.FOrigem.FSaldo)
    Self.Lembrar(1, Valor)
    PutLn("Depósito feito. Saldo: R$ ", Self.FOrigem.FSaldo)
;

TCaixa.Sacar(Self mut, Valor Integer) :
    if Self.FOrigem.Sacar(Valor)
        Registrar("Saque", Valor, Self.FOrigem.FSaldo)
        Self.Lembrar(2, Valor)
        PutLn("Retire as notas. Saldo: R$ ", Self.FOrigem.FSaldo)
    else
        PutLn("Saldo insuficiente: R$ ", Self.FOrigem.FSaldo)
    ;
;

TCaixa.Enviar(Self mut, Valor Integer) :
    if Self.FOrigem.Sacar(Valor)
        Self.FDestino.Depositar(Valor)
        Registrar("Envio para a conta 2", Valor, Self.FOrigem.FSaldo)
        Self.Lembrar(3, Valor)
        PutLn("Enviado para ", Self.FDestino.FNome, ". Saldo: R$ ", Self.FOrigem.FSaldo)
    else
        PutLn("Saldo insuficiente: R$ ", Self.FOrigem.FSaldo)
    ;
;

== Cancels the last operation by doing its opposite.
TCaixa.Cancelar(Self mut) :
    Valor := Self.FUltimoValor
    Feito := false
    if Self.FUltimaOperacao = 1
        Feito := Self.FOrigem.Sacar(Valor)
    elif Self.FUltimaOperacao = 2
        Self.FOrigem.Depositar(Valor)
        Feito := true
    elif Self.FUltimaOperacao = 3
        if Self.FDestino.Sacar(Valor)
            Self.FOrigem.Depositar(Valor)
            Feito := true
        ;
    else
        PutLn("Não há operação para cancelar.")
        Exit
    ;
    if Feito
        Registrar("Cancelamento", Valor, Self.FOrigem.FSaldo)
        Self.Lembrar(0, 0)
        PutLn("Operação cancelada. Saldo: R$ ", Self.FOrigem.FSaldo)
    else
        PutLn("Não foi possível cancelar: o valor já foi usado.")
    ;
;

MostrarExtrato :
    try
        F := OpenRead(Extrato)
        Numero Integer := 0
        while not Eof(F)
            Linha := ReadLn(F)
            Numero += 1
            PutLn(Numero, ". ", Linha)
        ;
    except
        On FileNotFound
            PutLn("Ainda não há extrato.")
        ;
    ;
;

Menu :
    PutLn("")
    PutLn("===== Caixa Inox =====")
    PutLn("1 - Saldo")
    PutLn("2 - Depósito")
    PutLn("3 - Saque")
    PutLn("4 - Envio para a conta 2")
    PutLn("5 - Cancelar a última operação")
    PutLn("6 - Extrato")
    PutLn("7 - Recarregar do arquivo")
    PutLn("9 - Reiniciar as contas")
    PutLn("0 - Sair")
    Put("Opção: ")
;

LerValor Integer :
    Valor Integer := 0
    Put("Valor: R$ ")
    Get(Valor)
    Return Valor
;

Main :
    Caixa TCaixa
    Caixa.Carregar
    PutLn("Caixa Inox: contas em ", Arquivo, ", extrato em ", Extrato)
    Opcao Integer := -1
    while Opcao # 0
        Menu
        Get(Opcao)
        if Opcao = 1
            Caixa.FOrigem.Apresentar                    == TConta.Apresentar (Override)
        elif Opcao = 2 or Opcao = 3 or Opcao = 4
            Valor := LerValor
            if Valor <= 0
                PutLn("Valor inválido.")
            elif Opcao = 2
                Caixa.Depositar(Valor)
            elif Opcao = 3
                Caixa.Sacar(Valor)
            else
                Caixa.Enviar(Valor)
            ;
        elif Opcao = 5
            Caixa.Cancelar
        elif Opcao = 6
            MostrarExtrato
        elif Opcao = 7
            Caixa.Carregar
            PutLn("Contas lidas de ", Arquivo, ".")
            Caixa.FOrigem.Apresentar
            Caixa.FDestino.Apresentar
        elif Opcao = 9
            Caixa.Reiniciar
            PutLn("Contas reiniciadas.")
        elif Opcao # 0
            PutLn("Opção inexistente.")
        ;
    ;
    PutLn("Obrigado por usar o Caixa Inox.")
;
