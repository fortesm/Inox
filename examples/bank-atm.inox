== A bank teller machine on the terminal, with a numbered menu: balance,
== deposit, withdrawal, transfer to another account, cancellation of the
== last operation and the statement. Every change is saved in
== inox-bank.txt (the accounts) and inox-bank-statement.txt (the
== statement, readable by people), so the next run continues from there.
==
== Composition with method reuse (CANON-9):
==   TBalance   knows how to deposit and withdraw
==   THolder    knows who owns the account
==   TAccount   Struct (THolder, TBalance): an account reuses both, and
==              overrides Present to add the balance
==   TTeller    the machine: two accounts and the last operation
==
== Inox does not convert text to numbers yet (planned with Std.Strings), so
== inox-bank.txt keeps each number one digit per line, closed by "-".
== Typing something that is not a number at a prompt stops the program
== (Get reads Integer values).
Use Std.IOUtils

Const AccountsFile := "inox-bank.txt"
Const StatementFile := "inox-bank-statement.txt"
Const Header := "Inox Bank: one digit per line; '-' closes each number"

Type
    TBalance Struct
        FBalance Integer := 0
    ;
    THolder Struct
        FNumber Integer := 0
        FName String := ""
    ;
    TAccount Struct (THolder, TBalance)
        FBranch Integer := 1
    ;
    TTeller Struct
        FSource TAccount
        FTarget TAccount
        FLastOperation Integer := 0       == 0 none, 1 deposit, 2 withdrawal, 3 transfer
        FLastAmount Integer := 0
    ;

== ---------- TBalance: money in and out ----------

TBalance.Deposit(Self mut, Amount Integer) :
    Self.FBalance += Amount
;

TBalance.Withdraw(Self mut, Amount Integer) Bool :
    if Amount > Self.FBalance
        Return false
    ;
    Self.FBalance -= Amount
    Return true
;

== ---------- THolder and TAccount ----------

THolder.Present(Self) :
    PutLn("Account ", Self.FNumber, " - ", Self.FName)
;

TAccount.Present(Self) Override :
    Put("Branch ", Self.FBranch, ", ")
    Self.THolder.Present
    PutLn("  balance: $ ", Self.FBalance)
;

== ---------- Numbers in the text file ----------

SaveNumber(ref mut F File, N Integer) :
    D := 1
    while D <= N / 10
        D *= 10
    ;
    repeat
        WriteLn(F, N / D mod 10)
        D := D / 10
        until D = 0
    ;
    WriteLn(F, "-")
;

Digit(S String) Integer :
    if S = "0"
        Return 0
    elif S = "1"
        Return 1
    elif S = "2"
        Return 2
    elif S = "3"
        Return 3
    elif S = "4"
        Return 4
    elif S = "5"
        Return 5
    elif S = "6"
        Return 6
    elif S = "7"
        Return 7
    elif S = "8"
        Return 8
    elif S = "9"
        Return 9
    ;
    Raise IOError                         == not a digit: the file is damaged
;

ReadNumber(ref mut F File) Integer :
    N Integer := 0
    Line := ReadLn(F)
    while Line # "-"
        N := N * 10 + Digit(Line)
        Line := ReadLn(F)
    ;
    Return N
;

Record(Operation String, Amount Integer, Balance Integer) :
    try
        G := OpenAppend(StatementFile)
        WriteLn(G, Operation, " $ ", Amount, " -> balance $ ", Balance)
    except
        On IOError
            PutLn("Warning: the statement could not be saved.")
        ;
    ;
;

== ---------- TTeller: the machine ----------

TTeller.Start(Self mut) :
    Self.FSource := TAccount(THolder := THolder(FNumber := 1, FName := "Marcelo"),
                             TBalance := TBalance(FBalance := 1000))
    Self.FTarget := TAccount(THolder := THolder(FNumber := 2, FName := "Ann"),
                             TBalance := TBalance(FBalance := 500))
    Self.FLastOperation := 0
    Self.FLastAmount := 0
;

TTeller.Save(Self) :
    try
        F := Create(AccountsFile)
        WriteLn(F, Header)
        SaveNumber(F, Self.FSource.FBalance)
        SaveNumber(F, Self.FTarget.FBalance)
        SaveNumber(F, Self.FLastOperation)
        SaveNumber(F, Self.FLastAmount)
    except
        On IOError
            PutLn("Warning: the accounts could not be saved.")
        ;
    ;
;

TTeller.Reset(Self mut) :
    Self.Start
    Self.Save
    try
        G := Create(StatementFile)
        WriteLn(G, "Accounts reset: account 1 $ 1000, account 2 $ 500")
    except
        On IOError
            PutLn("Warning: the statement could not be saved.")
        ;
    ;
;

TTeller.Load(Self mut) :
    Self.Start
    if not Exists(AccountsFile)
        Self.Reset                        == first run: the accounts are created
        Exit
    ;
    try
        F := OpenRead(AccountsFile)
        if ReadLn(F) # Header
            Raise IOError
        ;
        Self.FSource.FBalance := ReadNumber(F)
        Self.FTarget.FBalance := ReadNumber(F)
        Self.FLastOperation := ReadNumber(F)
        Self.FLastAmount := ReadNumber(F)
    except
        On IOError
            PutLn("The file ", AccountsFile, " is damaged: accounts reset.")
            Self.Reset
        ;
    ;
;

TTeller.Remember(Self mut, Operation Integer, Amount Integer) :
    Self.FLastOperation := Operation
    Self.FLastAmount := Amount
    Self.Save
;

TTeller.Deposit(Self mut, Amount Integer) :
    Self.FSource.Deposit(Amount)                      == TBalance.Deposit, through TAccount
    Record("Deposit", Amount, Self.FSource.FBalance)
    Self.Remember(1, Amount)
    PutLn("Deposit done. Balance: $ ", Self.FSource.FBalance)
;

TTeller.Withdraw(Self mut, Amount Integer) :
    if Self.FSource.Withdraw(Amount)
        Record("Withdrawal", Amount, Self.FSource.FBalance)
        Self.Remember(2, Amount)
        PutLn("Take your cash. Balance: $ ", Self.FSource.FBalance)
    else
        PutLn("Insufficient funds: $ ", Self.FSource.FBalance)
    ;
;

TTeller.Transfer(Self mut, Amount Integer) :
    if Self.FSource.Withdraw(Amount)
        Self.FTarget.Deposit(Amount)
        Record("Transfer to account 2", Amount, Self.FSource.FBalance)
        Self.Remember(3, Amount)
        PutLn("Sent to ", Self.FTarget.FName, ". Balance: $ ", Self.FSource.FBalance)
    else
        PutLn("Insufficient funds: $ ", Self.FSource.FBalance)
    ;
;

== Cancels the last operation by doing its opposite.
TTeller.Cancel(Self mut) :
    Amount := Self.FLastAmount
    Done := false
    if Self.FLastOperation = 1
        Done := Self.FSource.Withdraw(Amount)
    elif Self.FLastOperation = 2
        Self.FSource.Deposit(Amount)
        Done := true
    elif Self.FLastOperation = 3
        if Self.FTarget.Withdraw(Amount)
            Self.FSource.Deposit(Amount)
            Done := true
        ;
    else
        PutLn("There is no operation to cancel.")
        Exit
    ;
    if Done
        Record("Cancellation", Amount, Self.FSource.FBalance)
        Self.Remember(0, 0)
        PutLn("Operation cancelled. Balance: $ ", Self.FSource.FBalance)
    else
        PutLn("Could not cancel: the money was already used.")
    ;
;

ShowStatement :
    try
        F := OpenRead(StatementFile)
        Number Integer := 0
        while not Eof(F)
            Line := ReadLn(F)
            Number += 1
            PutLn(Number, ". ", Line)
        ;
    except
        On FileNotFound
            PutLn("There is no statement yet.")
        ;
    ;
;

Menu :
    PutLn("")
    PutLn("===== Inox Teller =====")
    PutLn("1 - Balance")
    PutLn("2 - Deposit")
    PutLn("3 - Withdrawal")
    PutLn("4 - Transfer to account 2")
    PutLn("5 - Cancel the last operation")
    PutLn("6 - Statement")
    PutLn("7 - Reload from the file")
    PutLn("9 - Reset the accounts")
    PutLn("0 - Quit")
    Put("Option: ")
;

ReadAmount Integer :
    Amount Integer := 0
    Put("Amount: $ ")
    Get(Amount)
    Return Amount
;

Main :
    Teller TTeller
    Teller.Load
    PutLn("Inox Teller: accounts in ", AccountsFile, ", statement in ", StatementFile)
    Option Integer := -1
    while Option # 0
        Menu
        Get(Option)
        if Option = 1
            Teller.FSource.Present                      == TAccount.Present (Override)
        elif Option = 2 or Option = 3 or Option = 4
            Amount := ReadAmount
            if Amount <= 0
                PutLn("Invalid amount.")
            elif Option = 2
                Teller.Deposit(Amount)
            elif Option = 3
                Teller.Withdraw(Amount)
            else
                Teller.Transfer(Amount)
            ;
        elif Option = 5
            Teller.Cancel
        elif Option = 6
            ShowStatement
        elif Option = 7
            Teller.Load
            PutLn("Accounts read from ", AccountsFile, ".")
            Teller.FSource.Present
            Teller.FTarget.Present
        elif Option = 9
            Teller.Reset
            PutLn("Accounts reset.")
        elif Option # 0
            PutLn("No such option.")
        ;
    ;
    PutLn("Thank you for using the Inox Teller.")
;
