Module IfReturn

Max(A Integer, B Integer) Integer :
    if A > B
        Return A
    else
        Return B
    ;
;

Main :
    A, B Integer := 0
    Result Integer := 0

    A := 7
    B := 3

    Result := Max(A, B)

    PutLn("Max number is: ", Result)
;
