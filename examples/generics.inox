== Generics (CANON-8): one stack, written once, for Integers and Strings.
== `TStack<T>` is a template; `TStack<Integer>` and `TStack<String>` are two
== structs the compiler makes from it, each with its own copy of the
== methods Push, Pop and Peek, made on the first call (`Numbers.Push(3)`).
== The types are never written in a call: they come from the receiver, from
== the arguments (`Max(3, 8)`) or from the target (`Top Integer := ...`).
== There are no constraints: Max works for any type with `>`, and using it
== on a struct is an error that names the instance (Max<TPoint>). A field
== of type T, or of an array of T, has no default: each stack is built with
== its items, `TStack(FItems := Fill(0))`.
Const Capacity := 8

Type
    TStack<T> Struct
        FItems Array[1..Capacity] T
        FCount Integer := 0
    ;
    TPair<K, V> Struct
        FKey K
        FValue V
    ;

TStack<T>.Push(Self mut, X T) :
    if Self.FCount = Capacity
        PutLn("stack full")
        Exit
    ;
    Self.FCount += 1
    Self.FItems[Self.FCount] := X
;

TStack<T>.Pop(Self mut) T :
    Top := Self.FItems[Self.FCount]
    Self.FCount -= 1
    Return Top
;

TStack<T>.Peek(Self) T :
    Return Self.FItems[Self.FCount]
;

TStack<T>.IsEmpty(Self) Bool :
    Return Self.FCount = 0
;

Max<T>(A T, B T) T :
    Return IIf(A > B, A, B)
;

Main :
    Numbers TStack<Integer> := TStack(FItems := Fill(0))
    for I in 1..5
        Numbers.Push(I * I)
    ;
    PutLn("top: ", Numbers.Peek)
    Total := 0
    while not Numbers.IsEmpty
        Total += Numbers.Pop
    ;
    PutLn("sum of squares: ", Total)

    Words TStack<String> := TStack(FItems := Fill(""))
    Words.Push("first")
    Words.Push("second")
    Words.Push("third")
    while not Words.IsEmpty
        Put(Words.Pop, " ")
    ;
    PutLn("")

    Best := TPair(FKey := "none", FValue := 0)
    Scores TStack<TPair<String, Integer>> := TStack(FItems := Fill(Best))
    Scores.Push(TPair(FKey := "ana", FValue := 7))
    Scores.Push(TPair(FKey := "bia", FValue := 9))
    Scores.Push(TPair(FKey := "caio", FValue := 4))
    while not Scores.IsEmpty
        Score := Scores.Pop
        if Score.FValue > Best.FValue
            Best := Score
        ;
    ;
    PutLn("best: ", Best.FKey, " with ", Best.FValue)
    PutLn(Max(3, 8), " ", Max("pear", "apple"), " ", Max(2.5, 1.5))
;
