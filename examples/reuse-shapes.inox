== Method reuse (CANON-9), example 1: one behavior, many structs.
== TPosition knows how to move. TCircle, TRectangle and TText reuse it:
== none of them writes MoveBy again, and each one moves itself.
Type
    TPosition Struct
        FX Integer := 0
        FY Integer := 0
    ;
    TCircle Struct (TPosition)
        FRadius Integer := 1
    ;
    TRectangle Struct (TPosition)
        FWidth Integer := 1
        FHeight Integer := 1
    ;
    TText Struct (TPosition)
        FContent String := ""
    ;

== The behavior lives in one place.
TPosition.MoveBy(Self mut, DX Integer, DY Integer) :
    Self.FX += DX
    Self.FY += DY
;

TPosition.AtOrigin(Self) Bool :
    Return Self.FX = 0 and Self.FY = 0
;

TPosition.Where(Self) :
    Put("(", Self.FX, ", ", Self.FY, ")")
;

== Each struct adds only what is its own.
TCircle.Area(Self) Integer :
    Return 3 * Self.FRadius * Self.FRadius      == pi ~ 3, Integer only
;

TRectangle.Area(Self) Integer :
    Return Self.FWidth * Self.FHeight
;

Main :
    C := TCircle(FRadius := 2)
    R := TRectangle(FWidth := 4, FHeight := 3)
    T := TText(FContent := "Hello")

    C.MoveBy(10, 5)                == TPosition.MoveBy, on the TPosition part of C
    R.MoveBy(-2, 7)
    R.MoveBy(2, -7)                == back to the origin
    T.MoveBy(1, 1)

    Put("circle at ")
    C.Where
    PutLn(", area ", C.Area)
    Put("rectangle at ")
    R.Where
    PutLn(", area ", R.Area, ", at the origin: ", R.AtOrigin)
    Put("text '", T.FContent, "' at ")
    T.Where
    PutLn("")
;
