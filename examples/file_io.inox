== Tour of file I/O in Inox 0.2: every operation of Std.Files and
== Std.IOUtils, and every way a file operation fails, handled with try.
== Run it with `inox examples/file_io.inox`; it creates its files in the
== current directory and deletes them at the end. The test suite runs it
== and compares its output with tests/examples/file_io.out.
==
== Text files only: binary files, streams, positions (Seek), directories
== and other encodings are later changes (CANON-17).

Use Std.IOUtils                 == Std.Files (File and the basics) plus Exists, DeleteFile, RenameFile

== A routine that receives an open file takes it as `ref mut`: a File is
== never copied (CANON-17).
WriteNumbers(ref mut Target File, First Integer, Last Integer) :
    for N in First..Last
        WriteLn(Target, "linha ", N)
    ;
;

== Reads to the end, prints the last line and returns how many lines it read.
CountLines(ref mut Source File) Integer :
    Lines Integer := 0
    Last String := ""
    while not Eof(Source)
        Last := ReadLn(Source)
        Lines += 1
    ;
    PutLn("  última lida: [", Last, "]")
    Return Lines
;

== Opens, reads one line and returns it: F closes when the function
== returns, with no Close written.
FirstLine(Path String) String :
    F := OpenRead(Path)
    Return ReadLn(F)
;

== Copies a text file line by line and returns how many lines it copied.
CopyText(From String, To String) Integer :
    Source := OpenRead(From)
    Target := Create(To)
    Copied Integer := 0
    while not Eof(Source)
        WriteLn(Target, ReadLn(Source))
        Copied += 1
    ;
    Return Copied
;

== Prints a whole file with line numbers.
Show(Title String, Path String) :
    PutLn("--- ", Title, " (", Path, ")")
    F := OpenRead(Path)
    Number Integer := 0
    while not Eof(F)
        Line := ReadLn(F)
        Number += 1
        PutLn(Number, ": [", Line, "]")
    ;
;

== Writes and then fails: the exception leaves the routine, and F is
== closed (and flushed) on the way out.
WriteThenFail(Path String) :
    F := Create(Path)
    WriteLn(F, "escrita antes da exceção")
    Raise RangeError
;

Main :
    Notes String := "inox-file-io-notas.txt"
    Copy String := "inox-file-io-copia.txt"
    Moved String := "inox-file-io-movido.txt"
    Missing String := "inox-file-io-nao-existe.txt"
    Big String := "inox-file-io-grande.txt"

    try
        == 1. Create writes a new file (or truncates an existing one).
        PutLn("== 1. Create, Write, WriteLn")
        Out := Create(Notes)
        WriteLn(Out, "Olá, Inox!")
        WriteLn(Out, "Integer ", 42, ", Bool ", true, ", Float ", 2.5, ", negativo ", -7)
        Write(Out, "Write não quebra a linha; ")
        Write(Out, "continua aqui")
        WriteLn(Out)                                    == only the line end
        WriteLn(Out, "UTF-8: ação, coração, 日本語, ✓")
        WriteLn(Out, "")                                == an empty line
        Close(Out)
        Close(Out)                                      == closing twice does nothing
        Show("depois de Create", Notes)

        == 2. OpenAppend writes at the end of an existing file.
        PutLn("== 2. OpenAppend")
        More := OpenAppend(Notes)
        WriteLn(More, "linha anexada")
        Close(More)
        Show("depois de OpenAppend", Notes)

        == 3. Reading: ReadLn and Eof; past the end ReadLn gives "".
        PutLn("== 3. OpenRead, ReadLn, Eof")
        Input := OpenRead(Notes)
        PutLn("primeira: [", ReadLn(Input), "] Eof=", Eof(Input))
        Rest := CountLines(Input)
        PutLn("restantes: ", Rest)
        PutLn("depois do fim: [", ReadLn(Input), "] Eof=", Eof(Input))
        Close(Input)

        == 4. Files in routines: ref mut parameters, and a function that
        == opens, reads and returns (its file closes on Return).
        PutLn("== 4. Arquivos em rotinas")
        Numbers := Create(Big)
        WriteNumbers(Numbers, 1, 1000)
        WriteLn(Numbers, "fim")
        Close(Numbers)
        Counter := OpenRead(Big)
        Total := CountLines(Counter)
        PutLn("linhas em ", Big, ": ", Total)
        Close(Counter)
        PutLn("primeira linha: ", FirstLine(Big))
        PutLn("copiadas: ", CopyText(Notes, Copy))
        Show("cópia", Copy)

        == 5. One variable, several files: storing a new file closes the
        == old one; a File declared in a loop closes at the next round.
        PutLn("== 5. Reabrir")
        Again := OpenRead(Notes)
        PutLn("A: ", ReadLn(Again))
        Again := OpenRead(Big)                          == closes the first
        PutLn("B: ", ReadLn(Again))
        Close(Again)
        for Round in 1..3
            Each := OpenRead(Big)
            PutLn("volta ", Round, ": ", ReadLn(Each))
            Close(Each)                                 == Windows does not delete an open file
        ;

        == 6. Std.IOUtils: Exists, RenameFile, DeleteFile.
        PutLn("== 6. Exists, RenameFile, DeleteFile")
        PutLn("Exists(cópia)=", Exists(Copy), " Exists(movido)=", Exists(Moved))
        RenameFile(Copy, Moved)
        PutLn("depois de RenameFile: Exists(cópia)=", Exists(Copy), " Exists(movido)=", Exists(Moved))
        PutLn("Exists(.)=", Exists("."), " (um diretório não é um arquivo)")
        DeleteFile(Moved)
        PutLn("depois de DeleteFile: Exists(movido)=", Exists(Moved))

        == 7. Failures are exceptions (CANON-17).
        PutLn("== 7. Erros com try")

        == 7a. A missing file: FileNotFound, and ensure always runs.
        try
            F := OpenRead(Missing)
            PutLn("inesperado: ", ReadLn(F))
        except
            On FileNotFound
                PutLn("7a. FileNotFound: ", Missing)
            ;
        ensure
            PutLn("7a. ensure")
        ;

        == 7b. FileNotFound is an IOError: the family handler catches it.
        try
            DeleteFile(Missing)
        except
            On IOError
                PutLn("7b. On IOError pega FileNotFound")
            ;
        ;

        == 7c. RenameFile onto an existing file: AlreadyExists.
        Other := Create(Copy)
        Close(Other)
        try
            RenameFile(Notes, Copy)
        except
            On AlreadyExists
                PutLn("7c. AlreadyExists: ", Copy, " já existe")
            ;
        ;
        PutLn("7c. a origem continua: ", Exists(Notes))

        == 7d. Retry: the handler creates the missing file and runs the try
        == block once more.
        Attempts Integer := 0
        try
            Attempts += 1
            Late := OpenRead(Missing)
            PutLn("7d. tentativa ", Attempts, ": ", ReadLn(Late))
            Close(Late)
        except
            On FileNotFound
                PutLn("7d. tentativa ", Attempts, ": não existe, criando")
                Fresh := Create(Missing)
                WriteLn(Fresh, "criado pelo handler")
                Close(Fresh)
                Retry(1)
            ;
        ;

        == 7e. Reading a file opened for writing: IOError, here caught by
        == Else (any exception not named before it).
        Writer := Create(Copy)
        try
            Line := ReadLn(Writer)
            PutLn("inesperado: ", Line)
        except
            On FileNotFound
                PutLn("inesperado")
            ;
            Else
                PutLn("7e. Else: ler um arquivo aberto para escrita")
            ;
        ;

        == 7f. Writing to a closed file: IOError.
        Close(Writer)
        try
            WriteLn(Writer, "depois de Close")
        except
            On IOError
                PutLn("7f. IOError: arquivo fechado")
            ;
        ;

        == 7g. A directory is not a text file: IOError on every system
        == (PermissionDenied on some, which is an IOError too).
        try
            Dir := Create(".")
            WriteLn(Dir, "x")
        except
            On IOError
                PutLn("7g. IOError: Create de um diretório")
            ;
        ;
        try
            DeleteFile(".")
        except
            On IOError
                PutLn("7g. IOError: DeleteFile nunca apaga um diretório")
            ;
        ;

        == 7h. A missing directory in the path: FileNotFound.
        try
            Nowhere := Create("inox-file-io-sem-pasta/arquivo.txt")
            WriteLn(Nowhere, "x")
        except
            On FileNotFound
                PutLn("7h. FileNotFound: a pasta não existe")
            ;
        ;

        == 7i. An exception leaves a routine that holds a file: the file is
        == closed and what was written is on disk.
        try
            WriteThenFail(Copy)
        except
            On RangeError
                PutLn("7i. RangeError capturada; no arquivo: ", FirstLine(Copy))
            ;
        ;

        == 7j. Nested try: the inner handler cleans up and raises again.
        try
            try
                Gone := OpenRead("inox-file-io-sumiu.txt")
                PutLn("inesperado: ", ReadLn(Gone))
            except
                On FileNotFound
                    PutLn("7j. interno: FileNotFound, repassando")
                    Raise
                ;
            ensure
                PutLn("7j. ensure interno")
            ;
        except
            On IOError
                PutLn("7j. externo: IOError")
            ;
        ;
    ensure
        == Clean up whatever exists, whatever happened above.
        for Index in 1..5
            Path String := IIf(Index = 1, Notes, IIf(Index = 2, Copy, IIf(Index = 3, Moved, IIf(Index = 4, Missing, Big))))
            if Exists(Path)
                DeleteFile(Path)
            ;
        ;
        PutLn("== limpeza: ", Exists(Notes), " ", Exists(Copy), " ", Exists(Moved), " ", Exists(Missing), " ", Exists(Big))
    ;
;
