== A tree of folders with safe pointers (CANON-25): every folder is owned by
== its parent (its first child, then each child its next sibling), and points
== back to the parent with a Link, which owns nothing, so there is no cycle to
== leak. Removing a folder frees its whole subtree, and every Link into it
== sees that (Alive is false) instead of reading freed memory.
Type
    TFolder Struct
        FName String := ""
        FParent Link<TFolder>                   == the parent: points, does not own
        FFirstChild Option<Own<TFolder>>        == owns its first child
        FNextSibling Option<Own<TFolder>>       == each child owns the next one
    ;

== Adds a child at the front of Parent's children and returns a Link to it.
AddFolder(Parent Link<TFolder>, Name String) Link<TFolder> :
    Folder := New(TFolder(FName := Name, FParent := Parent))
    Folder.FNextSibling := Move(Parent.FFirstChild)
    Parent.FFirstChild := Move(Folder)
    Return Link(Parent.FFirstChild)
;

== The path from the root, printed by walking the parent Links.
ShowPath(Folder Link<TFolder>) :
    if Alive(Folder.FParent)
        ShowPath(Folder.FParent)
        Put("/")
    ;
    Put(Folder.FName)
;

Show(Folder Link<TFolder>, Level Integer) :
    Indent := Level
    while Indent > 0
        Put("  ")
        Indent -= 1
    ;
    PutLn(Folder.FName)
    Child := Link(Folder.FFirstChild)
    while Alive(Child)
        Show(Child, Level + 1)
        Child := Link(Child.FNextSibling)
    ;
;

CountFolders(Folder Link<TFolder>) Integer :
    Total := 1
    Child := Link(Folder.FFirstChild)
    while Alive(Child)
        Total += CountFolders(Child)
        Child := Link(Child.FNextSibling)
    ;
    Return Total
;

Main :
    Root := New(TFolder(FName := "root"))
    R := Link(Root)
    Docs := AddFolder(R, "docs")
    Photos := AddFolder(R, "photos")
    Trip := AddFolder(Photos, "trip")
    Beach := AddFolder(Trip, "beach")
    Contracts := AddFolder(Docs, "contracts")
    PutLn("The tree (", CountFolders(R), " folders):")
    Show(R, 0)
    Put("The path of beach: ")
    ShowPath(Beach)
    PutLn("")
    Put("The path of contracts: ")
    ShowPath(Contracts)
    PutLn("")
    PutLn("The parent of beach: ", Beach.FParent.FName, ", the grandparent: ", Beach.FParent.FParent.FName)

    == Removing "photos" (the first child of the root) frees its subtree.
    R.FFirstChild := Move(Photos.FNextSibling)
    PutLn("After removing photos (", CountFolders(R), " folders):")
    Show(R, 0)
    PutLn("photos alive: ", Alive(Photos), ", beach alive: ", Alive(Beach), ", docs alive: ", Alive(Docs))
;
