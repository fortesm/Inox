== One behavior for thousands of soldiers (CANON-9). A behavior is written
== once per TYPE, never per value: the 1000 soldiers of an array share
== TSoldier.Run. TArcher reuses Run without writing it again; TKnight
== replaces it with an Override.
==
== Each kind lives in its own array, as in the Entity Component System of
== modern game engines: values of one kind side by side in memory. One
== array that mixes kinds needs a variant struct (FUTURE, change
== variant-structs), never subtyping.
Const Total := 1000

Type
    TSoldier Struct
        FX Integer := 0
        FSpeed Integer := 1
    ;
    TArcher Struct (TSoldier)
        FArrows Integer := 20
    ;
    TKnight Struct (TSoldier)
        FHorse String := "Dapple"
    ;

== Written once, for every soldier and for every struct that reuses TSoldier.
TSoldier.Run(Self mut) :
    Self.FX += Self.FSpeed
;

TArcher.Shoot(Self mut) :
    if Self.FArrows > 0
        Self.FArrows -= 1
    ;
;

== A knight runs twice as far: the soldier's step, twice.
TKnight.Run(Self mut) Override :
    Self.TSoldier.Run
    Self.TSoldier.Run
;

Main :
    Recruit TSoldier
    Archer TArcher
    Knight TKnight
    Infantry Array[1..Total] TSoldier := Fill(Recruit)
    Archers Array[1..Total] TArcher := Fill(Archer)
    Knights Array[1..Total] TKnight := Fill(Knight)
    for Turn in 1..10
        for I in 1..Total
            Infantry[I].Run                        == TSoldier.Run
            Archers[I].Run                         == TSoldier.Run, reused
            Knights[I].Run                         == TKnight.Run (Override)
        ;
        Archers[Turn].Shoot
    ;
    PutLn("After 10 turns, ", Total, " of each kind:")
    PutLn("  soldier: position ", Infantry[1].FX)
    PutLn("  archer:  position ", Archers[1].FX, ", arrows ", Archers[1].FArrows,
          " (archer ", Total, " has ", Archers[Total].FArrows, ")")
    PutLn("  knight:  position ", Knights[Total].FX, " on the horse ", Knights[Total].FHorse)
;
