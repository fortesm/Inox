== One behavior for thousands of soldiers (CANON-9). A behavior is written
== once per TYPE, never per value: the 1000 soldiers of an array share
== TSoldado.Correr. TArqueiro reuses Correr without writing it again;
== TCavaleiro replaces it with an Override.
==
== Each kind lives in its own array, as in the Entity Component System of
== modern game engines: values of one kind side by side in memory. One
== array that mixes kinds needs a variant struct (FUTURE, change
== variant-structs), never subtyping.
Module ReuseArmy

Const Total := 1000

Type
    TSoldado Struct
        FX Integer := 0
        FVelocidade Integer := 1
    ;
    TArqueiro Struct (TSoldado)
        FFlechas Integer := 20
    ;
    TCavaleiro Struct (TSoldado)
        FCavalo String := "Tordilho"
    ;

== Written once, for every soldier and for every struct that reuses TSoldado.
TSoldado.Correr(Self mut) :
    Self.FX += Self.FVelocidade
;

TArqueiro.Atirar(Self mut) :
    if Self.FFlechas > 0
        Self.FFlechas -= 1
    ;
;

== A knight runs twice as far: the soldier's step, twice.
TCavaleiro.Correr(Self mut) Override :
    Self.TSoldado.Correr
    Self.TSoldado.Correr
;

Main :
    Infantaria Array[1..Total] TSoldado
    Arqueiros Array[1..Total] TArqueiro
    Cavaleiros Array[1..Total] TCavaleiro
    for Turno in 1..10
        for I in 1..Total
            Infantaria[I].Correr                   == TSoldado.Correr
            Arqueiros[I].Correr                    == TSoldado.Correr, reused
            Cavaleiros[I].Correr                   == TCavaleiro.Correr (Override)
        ;
        Arqueiros[Turno].Atirar
    ;
    PutLn("Após 10 turnos, ", Total, " de cada tipo:")
    PutLn("  soldado:   posição ", Infantaria[1].FX)
    PutLn("  arqueiro:  posição ", Arqueiros[1].FX, ", flechas ", Arqueiros[1].FFlechas,
          " (o arqueiro ", Total, " tem ", Arqueiros[Total].FFlechas, ")")
    PutLn("  cavaleiro: posição ", Cavaleiros[Total].FX, " no cavalo ", Cavaleiros[Total].FCavalo)
;
