== Method reuse (CANON-9), example 2: two parts, and Override.
== TContact (e-mail, phone) and TAudit (who changed it, how many times) are
== small structs with their own methods. TCustomer and TSupplier reuse both.
== Both parts have Summary, so each struct that reuses them writes its own
== Summary, marked Override; the parts' versions stay reachable by path.
Type
    TContact Struct
        FEmail String := ""
        FPhone String := ""
    ;
    TAudit Struct
        FChangedBy String := "nobody"
        FChanges Integer := 0
    ;
    TCustomer Struct (TContact, TAudit)
        FName String := ""
        FCreditLimit Integer := 0
    ;
    TSupplier Struct (TContact, TAudit)
        FCompanyName String := ""
    ;

TContact.ChangeEmail(Self mut, Email String) :
    if Email # ""
        Self.FEmail := Email
    ;
;

TContact.Summary(Self) :
    PutLn("  contact: ", Self.FEmail, " / ", Self.FPhone)
;

TAudit.Record(Self mut, User String) :
    Self.FChangedBy := User
    Self.FChanges += 1
;

TAudit.Summary(Self) :
    PutLn("  audit: ", Self.FChanges, " change(s), last by ", Self.FChangedBy)
;

== A method of TCustomer that combines what the parts know how to do.
TCustomer.UpdateEmail(Self mut, Email String, User String) :
    Self.ChangeEmail(Email)
    Self.Record(User)
;

TCustomer.Summary(Self) Override :
    PutLn("Customer ", Self.FName, " (limit ", Self.FCreditLimit, ")")
    Self.TContact.Summary
    Self.TAudit.Summary
;

TSupplier.Summary(Self) Override :
    PutLn("Supplier ", Self.FCompanyName)
    Self.TContact.Summary
    Self.TAudit.Summary
;

Main :
    C := TCustomer(FName := "Marcelo", FCreditLimit := 5000)
    C.FPhone := "+55 85 99999-0000"          == a field of the TContact part
    C.UpdateEmail("marcelo@example.com", "teller1")
    C.UpdateEmail("", "teller2")              == an empty e-mail is ignored, the change is still audited
    C.Summary

    S := TSupplier(FCompanyName := "Inox Ltd")
    S.ChangeEmail("sales@inox.dev")           == reused directly from TContact
    S.Record("purchasing")                    == reused directly from TAudit
    S.Summary
;
