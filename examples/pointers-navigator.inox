== A navigator over an array of records (CANON-25), as Marcelo Fortes asked:
== first, last, next, previous, and the current record read and written in
== place through a Link, with no copy. "Next" in an array is the index plus
== one, never pointer arithmetic; the Link gives the direct access.
Const Tamanho := 5

Type
    TContato Struct
        FNome String := ""
        FTelefone String := ""
        FIdade Integer := 0
    ;
    TNavegador Struct
        FTabela Link<Array[1..Tamanho] TContato>    == points to the array, owns nothing
        FIndice Integer := 1
    ;

TNavegador.Primeiro(Self mut) :
    Self.FIndice := 1
;

TNavegador.Ultimo(Self mut) :
    Self.FIndice := Tamanho
;

TNavegador.Proximo(Self mut) :
    pre not Self.NoFim, "não há próximo"
    Self.FIndice += 1
;

TNavegador.Anterior(Self mut) :
    pre not Self.NoInicio, "não há anterior"
    Self.FIndice -= 1
;

TNavegador.NoInicio(Self) Bool :
    Return Self.FIndice = 1
;

TNavegador.NoFim(Self) Bool :
    Return Self.FIndice = Tamanho
;

== The current record, inside the array: nothing is copied.
TNavegador.Atual(Self) Link<TContato> :
    Return Link(Self.FTabela[Self.FIndice])
;

TNavegador.Mostrar(Self) :
    C := Self.Atual
    PutLn(Self.FIndice, ". ", C.FNome, " - ", C.FTelefone, " (", C.FIdade, " anos)")
;

Main :
    Contatos Array[1..Tamanho] TContato
    Contatos[1] := TContato(FNome := "Ana", FTelefone := "1111", FIdade := 30)
    Contatos[2] := TContato(FNome := "Bia", FTelefone := "2222", FIdade := 25)
    Contatos[3] := TContato(FNome := "Caio", FTelefone := "3333", FIdade := 41)
    Contatos[4] := TContato(FNome := "Davi", FTelefone := "4444", FIdade := 19)
    Contatos[5] := TContato(FNome := "Eva", FTelefone := "5555", FIdade := 52)

    Nav := TNavegador(FTabela := Link(Contatos))

    PutLn("Do primeiro ao último:")
    Nav.Primeiro
    Nav.Mostrar
    while not Nav.NoFim
        Nav.Proximo
        Nav.Mostrar
    ;

    PutLn("Do último ao primeiro:")
    Nav.Ultimo
    Nav.Mostrar
    while not Nav.NoInicio
        Nav.Anterior
        Nav.Mostrar
    ;

    == Writing through the navigator changes the array itself.
    Nav.Ultimo
    Nav.Atual.FIdade += 1
    Nav.Atual.FTelefone := "5556"
    PutLn("Eva no array: ", Contatos[Tamanho].FIdade, " anos, telefone ", Contatos[Tamanho].FTelefone)
;
