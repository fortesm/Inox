== A navigator over an array of records (CANON-25), as Marcelo Fortes asked:
== first, last, next, previous, and the current record read and written in
== place through a Link, with no copy. "Next" in an array is the index plus
== one, never pointer arithmetic; the Link gives the direct access.
Const Size := 5

Type
    TContact Struct
        FName String := ""
        FPhone String := ""
        FAge Integer := 0
    ;
    TNavigator Struct
        FTable Link<Array[1..Size] TContact>    == points to the array, owns nothing
        FIndex Integer := 1
    ;

TNavigator.First(Self mut) :
    Self.FIndex := 1
;

TNavigator.Last(Self mut) :
    Self.FIndex := Size
;

TNavigator.Next(Self mut) :
    pre not Self.AtEnd, "there is no next record"
    Self.FIndex += 1
;

TNavigator.Previous(Self mut) :
    pre not Self.AtStart, "there is no previous record"
    Self.FIndex -= 1
;

TNavigator.AtStart(Self) Bool :
    Return Self.FIndex = 1
;

TNavigator.AtEnd(Self) Bool :
    Return Self.FIndex = Size
;

== The current record, inside the array: nothing is copied.
TNavigator.Current(Self) Link<TContact> :
    Return Link(Self.FTable[Self.FIndex])
;

TNavigator.Show(Self) :
    C := Self.Current
    PutLn(Self.FIndex, ". ", C.FName, " - ", C.FPhone, " (", C.FAge, " years)")
;

Main :
    Contacts Array[1..Size] TContact
    Contacts[1] := TContact(FName := "Ann", FPhone := "1111", FAge := 30)
    Contacts[2] := TContact(FName := "Ben", FPhone := "2222", FAge := 25)
    Contacts[3] := TContact(FName := "Carl", FPhone := "3333", FAge := 41)
    Contacts[4] := TContact(FName := "Dave", FPhone := "4444", FAge := 19)
    Contacts[5] := TContact(FName := "Eve", FPhone := "5555", FAge := 52)

    Nav := TNavigator(FTable := Link(Contacts))

    PutLn("From first to last:")
    Nav.First
    Nav.Show
    while not Nav.AtEnd
        Nav.Next
        Nav.Show
    ;

    PutLn("From last to first:")
    Nav.Last
    Nav.Show
    while not Nav.AtStart
        Nav.Previous
        Nav.Show
    ;

    == Writing through the navigator changes the array itself.
    Nav.Last
    Nav.Current.FAge += 1
    Nav.Current.FPhone := "5556"
    PutLn("Eve in the array: ", Contacts[Size].FAge, " years, phone ", Contacts[Size].FPhone)
;
