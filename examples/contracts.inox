== Design by contract (CANON-24), as in Eiffel:
==   pre        what the caller must guarantee (Eiffel require)
==   pos        what the routine guarantees on return (Eiffel ensure);
==              old X is X on entry, Result the returned value
==   invariant  what is always true of a struct, between calls
==   pre else / pos then   an Override weakens / strengthens what it inherits
==   invariant / variant   on the first lines of a loop
== A broken contract stops the program with "Inox runtime error: ...", like
== an overflow: it is a bug, not an exception.
Const Capacity := 5

Type
    TStack Struct
        FItems Array[1..Capacity] Integer := Fill(0)
        FCount Integer := 0
        invariant Self.FCount >= 0 and Self.FCount <= Capacity, "count in range"
    ;
    TCountedStack Struct (TStack)
        FOperations Integer := 0
    ;

TStack.IsEmpty(Self) Bool :
    Return Self.FCount = 0
;

TStack.IsFull(Self) Bool :
    Return Self.FCount = Capacity
;

TStack.Push(Self mut, X Integer) :
    pre not Self.IsFull, "the stack is not full"
    pos Self.FCount = old Self.FCount + 1
    pos Self.Top = X
    Self.FCount += 1
    Self.FItems[Self.FCount] := X
;

TStack.Pop(Self mut) Integer :
    pre not Self.IsEmpty, "the stack is not empty"
    pos Self.FCount = old Self.FCount - 1
    pos Result = old Self.Top
    X := Self.FItems[Self.FCount]
    Self.FCount -= 1
    Return X
;

TStack.Top(Self) Integer :
    pre not Self.IsEmpty
    Return Self.FItems[Self.FCount]
;

== The counted stack keeps the contract of Push and promises more.
TCountedStack.Push(Self mut, X Integer) Override :
    pos then Self.FOperations = old Self.FOperations + 1
    Self.TStack.Push(X)
    Self.FOperations += 1
;

Sum(N Integer) Integer :
    pre N >= 0
    pos Result = N * (N + 1) / 2
    Total := 0
    I := 0
    while I < N
        invariant Total = I * (I + 1) / 2
        variant N - I
        I += 1
        Total += I
    ;
    Return Total
;

Main :
    S TCountedStack
    for I in 1..3
        S.Push(I * 10)
    ;
    PutLn("top ", S.Top, ", count ", S.FCount, ", operations ", S.FOperations)
    PutLn("popped ", S.Pop, ", top now ", S.Top)
    PutLn("sum of 1 to 100: ", Sum(100))
;
