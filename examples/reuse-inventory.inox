== Method reuse (CANON-9), example 3: three levels, arrays and methods of
== built-in types.
==   TPreco          the price and its discounts
==   TItem (TPreco)  a priced thing with a stock count
==   TProduto (TItem) a product with a name; it gets TItem's and TPreco's
==                    methods without forwarding them
== Integer.Porcento and String.Rotulo are methods of built-in types: they
== work on any Integer or String, fields included.
Module ReuseInventory

Type
    TPreco Struct
        FCentavos Integer := 0
    ;
    TItem Struct (TPreco)
        FQuantidade Integer := 0
    ;
    TProduto Struct (TItem)
        FNome String := ""
    ;

Integer.Porcento(Self, P Integer) Integer :
    Return Self * P div 100
;

String.Rotulo(Self mut, Padrao String) :
    if Self = ""
        Self := Padrao
    ;
;

TPreco.Descontar(Self mut, P Integer) :
    Self.FCentavos -= Self.FCentavos.Porcento(P)
;

TItem.Entrada(Self mut, N Integer) :
    Self.FQuantidade += N
;

TItem.Saida(Self mut, N Integer) Bool :
    if N > Self.FQuantidade
        Return false
    ;
    Self.FQuantidade -= N
    Return true
;

TItem.ValorEmEstoque(Self) Integer :
    Return Self.FCentavos * Self.FQuantidade
;

Main :
    Estoque Array[1..3] TProduto
    Estoque[1] := TProduto(FNome := "Parafuso")
    Estoque[2] := TProduto(FNome := "Porca")
    Estoque[1].FCentavos := 50
    Estoque[2].FCentavos := 30
    Estoque[3].FCentavos := 1000
    Estoque[3].FNome.Rotulo("(sem nome)")    == String helper on a field
    Estoque[1].FNome.Rotulo("(sem nome)")    == already has a name: unchanged

    for I in 1..3
        Estoque[I].Entrada(100)              == TItem.Entrada, one level down
    ;
    Estoque[3].Descontar(10)                 == TPreco.Descontar, two levels down
    PutLn("venda de 30 porcas: ", Estoque[2].Saida(30))
    PutLn("venda de 500 parafusos: ", Estoque[1].Saida(500))

    Total Integer := 0
    for I in 1..3
        PutLn(Estoque[I].FNome, ": ", Estoque[I].FQuantidade, " x ", Estoque[I].FCentavos,
              " centavos = ", Estoque[I].ValorEmEstoque)
        Total += Estoque[I].ValorEmEstoque
    ;
    PutLn("total em estoque: ", Total, " centavos; 15% de imposto: ", Total.Porcento(15))
;
