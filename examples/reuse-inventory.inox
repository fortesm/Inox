== Method reuse (CANON-9), example 3: three levels, arrays and methods of
== built-in types.
==   TPrice            the price and its discounts
==   TItem (TPrice)    a priced thing with a stock count
==   TProduct (TItem)  a product with a name; it gets TItem's and TPrice's
==                     methods without forwarding them
== Integer.Percent and String.Label are methods of built-in types: they
== work on any Integer or String, fields included.
Type
    TPrice Struct
        FCents Integer := 0
    ;
    TItem Struct (TPrice)
        FQuantity Integer := 0
    ;
    TProduct Struct (TItem)
        FName String := ""
    ;

Integer.Percent(Self, P Integer) Integer :
    Return Self * P / 100
;

String.Label(Self mut, Default String) :
    if Self = ""
        Self := Default
    ;
;

TPrice.Discount(Self mut, P Integer) :
    Self.FCents -= Self.FCents.Percent(P)
;

TItem.Receive(Self mut, N Integer) :
    Self.FQuantity += N
;

TItem.Ship(Self mut, N Integer) Bool :
    if N > Self.FQuantity
        Return false
    ;
    Self.FQuantity -= N
    Return true
;

TItem.StockValue(Self) Integer :
    Return Self.FCents * Self.FQuantity
;

Main :
    Blank TProduct
    Stock Array[1..3] TProduct := Fill(Blank)
    Stock[1] := TProduct(FName := "Screw")
    Stock[2] := TProduct(FName := "Nut")
    Stock[1].FCents := 50
    Stock[2].FCents := 30
    Stock[3].FCents := 1000
    Stock[3].FName.Label("(no name)")        == String helper on a field
    Stock[1].FName.Label("(no name)")        == already has a name: unchanged

    for I in 1..3
        Stock[I].Receive(100)                == TItem.Receive, one level down
    ;
    Stock[3].Discount(10)                    == TPrice.Discount, two levels down
    PutLn("sale of 30 nuts: ", Stock[2].Ship(30))
    PutLn("sale of 500 screws: ", Stock[1].Ship(500))

    Total Integer := 0
    for I in 1..3
        PutLn(Stock[I].FName, ": ", Stock[I].FQuantity, " x ", Stock[I].FCents,
              " cents = ", Stock[I].StockValue)
        Total += Stock[I].StockValue
    ;
    PutLn("total in stock: ", Total, " cents; 15% tax: ", Total.Percent(15))
;
