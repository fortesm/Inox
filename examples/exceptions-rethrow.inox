Module ExceptionsRethrow

Main :
    try
        try
            Raise IOError
        except
            On IOError
                PutLn("inner handler")
                Raise
            ;
        finally
            PutLn("inner cleanup")
        ;
    except
        On IOError
            PutLn("outer handler")
        ;
    ;
;
