== Method reuse (CANON-9): composition without inheritance.
==   TSubscriber Struct (TPerson)   reuses TPerson: its fields and methods are
==                                  offered by TSubscriber, at every level
==   S.UpdateName(...)              runs TPerson.UpdateName on the TPerson part of S
==   S.TPerson.Title                the part's own method, when an Override replaced it
==   Override                       replaces a reused method for callers of S
==   String.UpdateStr               a method of a built-in type, for any String field
Type
    TAddress Struct
        FStreet String := ""
        FCity String := ""
    ;
    TPerson Struct (TAddress)
        FId Integer := 0
        FName String := ""
    ;
    TSubscriber Struct (TPerson)
        FSubscriptionId Integer := 0
        FPlan String := ""
    ;

TAddress.Relocate(Self mut, Street String, City String) :
    Self.FStreet := Street
    Self.FCity := City
;

TPerson.UpdateName(Self mut, Name String) :
    if Name # ""
        Self.FName := Name
    ;
;

TPerson.Title(Self) String :
    Return "Person"
;

TSubscriber.Title(Self) String Override :
    Return "Subscriber"
;

String.UpdateStr(Self mut, Value String) :
    if Value # ""
        Self := Value
    ;
;

Main :
    P TPerson
    P.UpdateName("Reisidalt")               == writes P.FName
    S TSubscriber
    S.UpdateName("Marcelo")                 == from TPerson: writes S.FName
    S.Relocate("1 Main Street", "Recife")       == from TAddress, two levels down
    S.FPlan.UpdateStr("Plan9")              == a String helper
    S.Relocate("2 Ocean Avenue", "Natal")
    PutLn(P.FName)
    PutLn(S.FName, ", ", S.FStreet, ", ", S.FCity, ", ", S.FPlan)
    PutLn(S.Title, " (the part is ", S.TPerson.Title, ")")
;
